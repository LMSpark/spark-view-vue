    "PageServiceCapability": {
      "kind": "PageServiceCapability",
      "className": "PageServiceCapability",
      "jsdoc": "页面服务：消息提示、对话框、文件操作、实体选择、导航等。\n所有方法由宿主（如 Vue Router、Element Plus 等）实现，\n页面通过 ScriptContext 调用。",
      "shapeKind": "type",
