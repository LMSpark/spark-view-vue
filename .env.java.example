# Copy this file to .env.java and fill in your local values.
# This file is ignored by git and used by scripts/start-dev.mjs and scripts/build-all.mjs.

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-key
AI_MODEL=deepseek-v4-pro
# AI_JSON_MODE=true

# Optional: Claude Code through DeepSeek Anthropic-compatible API.
# You can also run: powershell -ExecutionPolicy Bypass -File scripts/setup-claude-deepseek.ps1
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-key
# ANTHROPIC_API_KEY=sk-your-deepseek-key
# ANTHROPIC_MODEL=deepseek-v4-pro

# Optional overrides
# JAVA_HOME=C:\Program Files\Microsoft\jdk-17.0.16.8-hotspot
# BACKEND_PORT=8080
