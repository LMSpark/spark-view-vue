/**
 * {{pascalName}} 组件单元测试
 */
import { describe, it, expect, vi } from 'vitest'
import { mount } from '@vue/test-utils'
import { Spark } from '@spark-view/spark-component'
import {{pascalName}} from '../src/components/{{name}}.vue'
import type { {{pascalName}}Config } from '../src/components/{{name}}'

describe('{{pascalName}}', () => {
  // 创建测试用的SPARK插件
  function createTestPlugin() {
    const registry = Spark.createRegistry()
    return Spark.createPlugin({ registry })
  }

  describe('基本渲染', () => {
    it('应该正确渲染组件', () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}',
        title: '测试标题'
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      expect(wrapper.text()).toContain('测试标题')
      expect(wrapper.classes()).toContain('spark-{{name}}')
    })

    it('应该显示默认标题', () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}'
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      expect(wrapper.text()).toContain('{{pascalName}}')
    })
  })

  describe('加载状态', () => {
    it('应该显示加载状态', async () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}',
        title: '加载测试',
        loading: true
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      expect(wrapper.classes()).toContain('is-loading')
      expect(wrapper.find('.loading-spinner').exists()).toBe(true)
    })

    it('应该能动态切换加载状态', async () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}',
        title: '动态加载测试'
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      const vm = wrapper.vm as any

      // 初始状态不加载
      expect(wrapper.classes()).not.toContain('is-loading')

      // 设置加载状态
      vm.setLoading(true)
      await wrapper.vm.$nextTick()
      expect(wrapper.classes()).toContain('is-loading')

      // 取消加载状态
      vm.setLoading(false)
      await wrapper.vm.$nextTick()
      expect(wrapper.classes()).not.toContain('is-loading')
    })
  })

  describe('错误处理', () => {
    it('应该显示错误信息', async () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}',
        title: '错误测试'
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      const vm = wrapper.vm as any

      // 设置错误
      vm.setError('测试错误信息')
      await wrapper.vm.$nextTick()

      expect(wrapper.find('.error-message').exists()).toBe(true)
      expect(wrapper.text()).toContain('测试错误信息')
    })

    it('应该能清除错误信息', async () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}',
        title: '清除错误测试'
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      const vm = wrapper.vm as any

      // 设置错误
      vm.setError('测试错误')
      await wrapper.vm.$nextTick()
      expect(wrapper.find('.error-message').exists()).toBe(true)

      // 清除错误
      vm.setError(null)
      await wrapper.vm.$nextTick()
      expect(wrapper.find('.error-message').exists()).toBe(false)
    })
  })

  describe('SPARK集成', () => {
    it('应该正确初始化SPARK上下文', () => {
      const config: {{pascalName}}Config = {
        type: '{{name}}',
        title: 'SPARK集成测试'
      }

      const wrapper = mount({{pascalName}}, {
        props: { config },
        global: {
          plugins: [createTestPlugin()]
        }
      })

      // 验证组件已挂载且SPARK上下文已初始化
      expect(wrapper.exists()).toBe(true)
    })
  })
})