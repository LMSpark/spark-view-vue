import { describe, it, expect } from 'vitest'
import { mount, flushPromises } from '@vue/test-utils'
import { Spark, SPARK_REGISTRY_KEY } from '@spark-appworks/spark-component'
import type { SparkNode } from '@spark-appworks/spark-component'
import {{pascalName}} from '../src/components/{{name}}.vue'
{{#if isProvider}}
// import { sparkProvide, sparkConsume } from '@spark-appworks/spark-utils'
{{/if}}
{{#if isConsumer}}
// import { sparkProvide } from '@spark-appworks/spark-utils'
// import { DATA_SOURCE } from '@spark-appworks/spark-component'
{{/if}}

// ── 测试辅助 ────────────────────────────────────────────────────────────────────

function makeConfig(overrides: Partial<SparkNode> = {}): SparkNode {
  return { type: '{{name}}', ...overrides }
}

function mountComponent(config: SparkNode) {
  const { registry } = Spark.createSystem()
  registry.register('{{name}}', {{pascalName}})
  return mount({{pascalName}}, {
    props: { config },
    global: {
      provide: {
        [SPARK_REGISTRY_KEY as symbol]: registry,
      }
    }
  })
}

// ── 测试套件 ────────────────────────────────────────────────────────────────────

describe('{{pascalName}}', () => {
  describe('基础渲染', () => {
    it('应该挂载成功', async () => {
      const wrapper = mountComponent(makeConfig())
      await flushPromises()
      expect(wrapper.exists()).toBe(true)
    })

    it('应该渲染根元素', async () => {
      const wrapper = mountComponent(makeConfig())
      await flushPromises()
      expect(wrapper.find('.{{name}}').exists()).toBe(true)
    })

    it('visible=false 时应隐藏', async () => {
      const wrapper = mountComponent(makeConfig({ visible: false }))
      await flushPromises()
      expect(wrapper.find('.{{name}}').exists()).toBe(false)
    })
  })
{{#if isProvider}}

  describe('Provider — 能力提供', () => {
    it('应该向子组件注入能力', async () => {
      // 示例：通过 createSystem 建立父子上下文并用 lookup 验证
      // const { registry, rootContext } = Spark.createSystem()
      // 在组件挂载后，子级上下文应该能通过 lookup 找到能力
      const wrapper = mountComponent(makeConfig())
      await flushPromises()
      expect(wrapper.exists()).toBe(true) // TODO: 替换为真实能力断言
    })
  })
{{/if}}
{{#if isConsumer}}

  describe('Consumer — 能力消费', () => {
    it('能力不存在时应该优雅降级（late-binding 容忍）', async () => {
      // consume 返回 null 时组件不应崩溃
      const wrapper = mountComponent(makeConfig())
      await flushPromises()
      expect(wrapper.exists()).toBe(true)
    })

    it('能力存在时应该正确使用', async () => {
      // 示例：通过父级 provide 注入能力，验证消费行为
      // const { registry, rootContext } = Spark.createSystem()
      // setCapability(rootContext, DATA_SOURCE, { rows: [...] })
      expect(true).toBe(true) // TODO: 替换为真实断言
    })
  })
{{/if}}
{{#if isDataSelfResolve}}

  describe('DataSet 接入', () => {
    it('dataViewKey 不存在时不应崩溃', async () => {
      const wrapper = mountComponent(makeConfig())
      await flushPromises()
      expect(wrapper.exists()).toBe(true)
    })
  })
{{/if}}

  describe('SPARK 注册', () => {
    it('应该能成功注册到 registry', () => {
      const { registry } = Spark.createSystem()
      registry.register('{{name}}', {{pascalName}})
      expect(registry.has('{{name}}')).toBe(true)
    })
  })
})
