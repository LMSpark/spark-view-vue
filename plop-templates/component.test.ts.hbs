{{/if}}

  describe('SPARK 注册', () => {
    it('应该以正确的 meta 注册到 registry', () => {
      const { registry } = Spark.createSystem()
      registry.register('{{name}}', {{pascalName}}, { dataKey: '{{dataKeyBehavior}}' })
      const def = registry.get('{{name}}')
      expect(def).toBeDefined()
