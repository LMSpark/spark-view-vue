// ── 测试辅助 ──────────────────────────────────────────────────────────────────

function makeConfig(overrides: {{pascalName}}Config = {}): {{pascalName}}Config {
  return { type: '{{name}}', ...overrides }
}

function mountComponent(config: {{pascalName}}Config) {
  const { registry } = Spark.createSystem()
  registry.register('{{name}}', {{pascalName}}, { dataKey: '{{dataKeyBehavior}}' })
  return mount({{pascalName}}, {
    props: { config },
    global: { plugins: [Spark.createPlugin({ registry })] }
  })
}

// ── 基础渲染 ──────────────────────────────────────────────────────────────────

describe('{{pascalName}}', () => {
  describe('基础渲染', () => {
    it('应该挂载成功', () => {
      const wrapper = mountComponent(makeConfig())
      expect(wrapper.exists()).toBe(true)
    })

    it('应该渲染根元素', () => {
      const wrapper = mountComponent(makeConfig())
      expect(wrapper.find('.spark-{{name}}').exists()).toBe(true)
    })
  })
{{#if isProvider}}

