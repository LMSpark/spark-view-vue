<template>
  <div v-if="isVisible" class="{{name}}" :class="{ disabled: isDisabled }">
    {{#if isProvider}}
    <!-- Config 驱动：通用递归渲染子树，父级不知道子级是谁 -->
    <template v-if="config.children?.length">
      <SparkComponentRenderer
        v-for="(child, i) in config.children"
        :key="child.id ?? `child-${i}`"
        :config="child"
      />
    </template>
    <!-- Template 驱动：向后兼容 slot -->
    <slot v-else />
    {{else}}
    <slot />
    {{/if}}
  </div>
</template>

<script setup lang="ts">
/**
 * {{pascalName}} — {{description}}
 *
 * dataKey 行为：{{dataKeyBehavior}}
 * 能力角色：{{capabilityRole}}
 *
 * 注册示例：
 *   const reg = Spark.createRegister(import.meta.glob('./*.vue') as GlobModules)
 *   reg.registerAll({ '{{name}}': './{{pascalName}}.vue' })
 */
import { useSparkComponent, SparkComponentRenderer } from '@spark-view/spark-component'
import type { ComponentConfig } from '@spark-view/spark-component'
{{#if isConsumer}}
// 从对应包导入需要消费的能力键，例如：
// import { APP_SERVICES, SELECTION } from '@spark-view/spark-utils'
// import { DATA_SOURCE } from '@spark-view/spark-data'
// 或使用字符串键（需在 capability-keys.ts 中通过 declare module 扩展 CapabilityTypeMap）
{{/if}}
{{#if isProvider}}
// 向子组件提供的能力键：
// import { SELECTION, GRID_EVENTS } from '@spark-view/spark-utils'
// import { DATA_SOURCE } from '@spark-view/spark-data'
{{/if}}
{{#if isDataSelfResolve}}
import { PAGE_DATASET } from '@spark-view/spark-data'
import { SparkData } from '@spark-view/spark-data'
{{/if}}

// ── Props ────────────────────────────────────────────────────────────────────
interface Props {
  config: ComponentConfig
}

const props = defineProps<Props>()

// ── SPARK 上下文（setup 第一行） ──────────────────────────────────────────────
const {
  context,
  isVisible,
  isDisabled,
  provide,
  provideEvents,
  consume,
  consumeEvents,
  logger,
} = useSparkComponent(props.config)
{{#if isProvider}}

// ── Provider：父级无条件提供能力，不关心谁消费 ────────────────────────────
// provide(DATA_SOURCE, dataView)
// provide(SELECTION, {
//   isSelected: (id) => selectedIds.value.has(id),
//   select:     (id) => { selectedIds.value.add(id) },
//   deselect:   (id) => { selectedIds.value.delete(id) },
//   getSelected:() => [...selectedIds.value],
// })
// const events = provideEvents(GRID_EVENTS)
{{/if}}
{{#if isConsumer}}

// ── Consumer：consume 返回 null 是正常 late-binding，做好防空 ─────────────
// const sel = consume(SELECTION)        // ISelectionCapability | null
// const src = consume(DATA_SOURCE)      // IDataSource | null
// 字符串键示例（需先用 declare module 扩展 CapabilityTypeMap）：
// const ctx = consume('app:field-context')  // FieldContext | null
{{/if}}
{{#if isDataSelfResolve}}

// ── DataSet 接入（self-resolve 模式） ──────────────────────────────────────
const dataSet = consume(PAGE_DATASET)
const dataKey = props.config.props?.['dataKey'] as string | undefined
// const binding = dataKey && dataSet
//   ? SparkData.resolveDataKeyBinding(dataKey, dataSet)
//   : null
// if (binding?.kind === 'view') {
//   provide(DATA_SOURCE, binding.source)
// }
{{/if}}

logger.info('{{pascalName}} initialized', { id: context.id })
</script>

<style scoped>
.{{name}} {
  /* TODO: 添加组件样式 */
}
</style>