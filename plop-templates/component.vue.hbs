<template>
  <div v-if="isVisible" class="{{name}}" :class="{ disabled: isDisabled }">
    {{#if isProvider}}
    <!-- Config 驱动：通用递归渲染子树，父级不知道子级是谁 -->
    <template v-if="config.children?.length">
      <SparkComponentRenderer
        v-for="(child, i) in config.children"
        :key="child.id ?? `child-${i}`"
        :config="child"
      />
    </template>
    {{else}}
    <slot />
    {{/if}}
  </div>
</template>

<script setup lang="ts">
/**
 * @skill {{name}}
{{#if isCatalogIgnore}}
 * @catalogIgnore
{{else}}
{{#if isCatalogInternal}}
 * @catalogInternal
{{/if}}
 * @category {{catalogCategory}}
{{/if}}
 * @description {{description}}
 *
 * DataViewKey行为：{{dataBindingBehavior}}
 * 能力角色：{{capabilityRole}}
 *
 * 注册示例：
 *   import { defineAsyncComponent } from 'vue'
 *   import { Spark } from '@spark-appworks/spark-component'
 *   Spark.register('{{name}}', defineAsyncComponent(() => import('./{{pascalName}}.vue')))
 */
import { useSparkComponent, SparkComponentRenderer } from '@spark-appworks/spark-component'
import type { SparkNode } from '@spark-appworks/spark-component'
{{#if isConsumer}}
// 从对应包导入需要消费的能力键，例如：
// import { APP_SERVICES } from '@spark-appworks/spark-utils'
// import { DATA_SOURCE } from '@spark-appworks/spark-component'
// 项目自定义能力键使用 defineCapability<T>('scope:name') 声明。
{{/if}}
{{#if isProvider}}
// 向子组件提供的能力键：
// import { DATA_SOURCE } from '@spark-appworks/spark-component'
{{/if}}
{{#if isDataSelfResolve}}
import { PAGE_DATASET } from '@spark-appworks/spark-component'
import { SparkData } from '@spark-appworks/spark-data'
{{/if}}

// ── Props ────────────────────────────────────────────────────────────────────
interface Props {
  /** SparkNode config; 由渲染器传入当前组件节点配置。 */
  config: SparkNode
}

const props = defineProps<Props>()

// ── SPARK 上下文（setup 第一行） ──────────────────────────────────────────────
const {
  isVisible,
  isDisabled,
  resolvedProps,
  sparkProvide,
  sparkConsume,
  logger,
} = useSparkComponent(props.config)
{{#if isProvider}}

// ── Provider：父级无条件提供能力，不关心谁消费 ────────────────────────────
// sparkProvide(DATA_SOURCE, dataView)
// sparkProvide(SELECTION, {
//   isSelected: (id) => selectedIds.value.has(id),
//   select:     (id) => { selectedIds.value.add(id) },
//   deselect:   (id) => { selectedIds.value.delete(id) },
//   getSelected:() => [...selectedIds.value],
// })
{{/if}}
{{#if isConsumer}}

// ── Consumer：consume 返回 null 是正常 late-binding，做好防空 ─────────────
// const src = sparkConsume(DATA_SOURCE)      // IDataSource | null
{{/if}}
{{#if isDataSelfResolve}}

// ── DataSet 接入（self-resolve 模式） ──────────────────────────────────────
const dataSet = sparkConsume(PAGE_DATASET)
const dataViewKey = props.config.props?.['dataViewKey'] as string | undefined
// const dataSource = dataViewKey && dataSet
//   ? SparkData.resolveDataViewKey(dataViewKey, dataSet)
//   : null
// if (dataSource) {
//   sparkProvide(DATA_SOURCE, dataSource)
// }
{{/if}}

void resolvedProps
logger.info('{{pascalName}} initialized', { id: props.config.id ?? null })
</script>

<style scoped>
.{{name}} {
  /* TODO: 添加组件样式 */
}
</style>
