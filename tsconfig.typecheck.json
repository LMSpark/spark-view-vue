{
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.d.ts", "features/**/*.ts", "features/**/*.tsx", "features/**/*.vue", "features/**/*.d.ts", "tests/**/*.ts", "packages/**/*.ts"],
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@root/*": ["../../../form-create-ssr-app/src/*"],
      "@spark-view/spark-utils": ["./packages/spark-utils/src/index.ts"],
      "@spark-view/spark-utils/*": ["./packages/spark-utils/src/*"],
      "@spark-view/spark-component": ["./packages/spark-component/src/index.ts"],
      "@spark-view/spark-component/*": ["./packages/spark-component/src/*"],
      "@spark-view/spark-data": ["./packages/spark-data/src/index.ts"],
      "@spark-view/spark-data/*": ["./packages/spark-data/src/*"],
      "/pages-config/*": ["./public/pages-config/*"]
    },
    "types": ["vite/client", "node", "vue"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/**/*.old.vue",
    "packages/**/examples/**/*",
    "packages/**/*.example.ts",
    "packages/**/*.example.vue",
    "features/spark/components/index.ts"
  ]
}