{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noErrorTruncation": true,
    "preserveWatchOutput": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@/*": ["src/*"],
      "@spark-view/spark-utils": ["./packages/spark-utils/src/index.ts"],
      "@spark-view/spark-utils/*": ["./packages/spark-utils/src/*"],
      "@spark-view/spark-component": ["./packages/spark-component/src/index.ts"],
      "@spark-view/spark-component/*": ["./packages/spark-component/src/*"],
      "@spark-view/spark-data": ["./packages/spark-data/src/index.ts"],
      "@spark-view/spark-data/*": ["./packages/spark-data/src/*"],
      "@spark-view/spark-page-config": ["./packages/spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/*": ["./packages/spark-page-config/src/*"],
      "@spark-view/spark-app": ["./packages/spark-app/src/index.ts"],
      "@spark-view/spark-app/*": ["./packages/spark-app/src/*"],
      "@spark-view/spark-renderer": ["./packages/spark-renderer/src/index.ts"],
      "@spark-view/spark-renderer/*": ["./packages/spark-renderer/src/*"],
      "@/features/spark-ej2": ["./features/spark-ej2"]
    },
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "features/**/*.ts",
    "features/**/*.tsx",
    "features/**/*.vue",
    "features/**/*.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "verify-integration.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "src/**/*.old.vue",
    "packages/**/examples/**/*",
    "packages/**/*.example.ts",
    "packages/**/*.example.vue",
    "tools/**/*",
    "examples/**/*",
    "node_modules/.pnpm/@vitejs+plugin-vue*/**",
    "**/*.config.js"
  ]
}