{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noErrorTruncation": true,
    "preserveWatchOutput": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@/*": ["src/*"],
      "@spark-view/spark-utils": ["./packages/spark-utils/src/index.ts"],
      "@spark-view/spark-component": ["./packages/spark-component/src/index.ts"],
      "@spark-view/spark-data": ["./packages/spark-data/src/index.ts"],
      "@spark-view/spark-page-config": ["./packages/spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/page/model": ["./packages/spark-page-config/src/page/model/index.ts"],
      "@spark-view/spark-page-config/page/loading": ["./packages/spark-page-config/src/page/loading/index.ts"],
      "@spark-view/spark-page-config/page/workspace": ["./packages/spark-page-config/src/page/workspace/index.ts"],
      "@spark-view/spark-page-config/page/navigation": ["./packages/spark-page-config/src/page/navigation/index.ts"],
      "@spark-view/spark-page-config/page/sandbox": ["./packages/spark-page-config/src/page/sandbox/index.ts"],
      "@spark-view/spark-page-config/page/services": ["./packages/spark-page-config/src/page/services/index.ts"],
      "@spark-view/spark-page-config/assistant/registrations": ["./packages/spark-page-config/src/assistant/registrations/index.ts"],
      // during development we prefer to resolve to source so that new exports
      // (e.g. setupAutoRegister) are picked up without rebuilding the package
      "@spark-view/spark-app": ["./packages/spark-app/src/index.ts"],
      "@spark-view/spark-ai": ["./packages/spark-ai/src/index.ts"],
      "@spark-view/spark-ai/schema": ["./packages/spark-ai/src/schema/index.ts"],
      "@spark-view/spark-ai/host": ["./packages/spark-ai/src/host/index.ts"],
      "@spark-view/spark-ai/module-semantic": ["./packages/spark-ai/src/module-semantic/index.ts"]
    },
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "packages/spark-ai/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "tools/**/*",
    "packages/vxe-table/**/*",
    "node_modules/.pnpm/@vitejs+plugin-vue*/**",
    "**/*.config.js",
    "**/*.config.ts"
  ]
}
