{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noErrorTruncation": true,
    "preserveWatchOutput": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@/*": ["src/*"],
      "@spark-view/spark-utils": ["./packages/spark-utils/src/index.ts"],
      "@spark-view/spark-utils/internal": ["./packages/spark-utils/src/internal/index.ts"],
      "@spark-view/spark-component/runtime": ["./packages/spark-component/src/runtime/index.ts"],
      "@spark-view/spark-component": ["./packages/spark-component/src/index.ts"],
      "@spark-view/spark-data": ["./packages/spark-data/src/index.ts"],
      "@spark-view/spark-page-config": ["./packages/spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/project": ["./packages/spark-page-config/src/project.ts"],
      "@spark-view/spark-page-config/ai": ["./packages/spark-page-config/src/ai.ts"],
      "@spark-view/spark-page-config/internal/page-data-canonicalize": ["./packages/spark-page-config/src/page-model/update/page-data-canonicalize.ts"],
      "@spark-view/spark-page-config/internal/payload-catalog": ["./packages/spark-page-config/src/page-model/ai/tool-catalogs/payload-catalog-tool-catalog.ts"],
      "@spark-view/spark-page-config/json-document": ["./packages/spark-page-config/src/json-document-public.ts"],
      // during development we prefer to resolve to source so that new exports
      // (e.g. setupAutoRegister) are picked up without rebuilding the package
      "@spark-view/spark-app": ["./packages/spark-app/src/index.ts"],
      "@spark-view/spark-ai": ["./packages/spark-ai/src/index.ts"],
      "@spark-view/spark-ai/json": ["./packages/spark-ai/src/json/index.ts"],
      "@spark-view/spark-ai/agent": ["./packages/spark-ai/src/agent/index.ts"],
      "@spark-view/spark-ai/modules": ["./packages/spark-ai/src/modules/index.ts"]
    },
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "packages/spark-ai/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "tools/**/*",
    "packages/vxe-table/**/*",
    "node_modules/.pnpm/@vitejs+plugin-vue*/**",
    "**/*.config.js",
    "**/*.config.ts"
  ]
}
