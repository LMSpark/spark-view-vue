{
  // 完全禁用 Markdown Lint（可选）
  "markdownlint.run": "onSave",
  
  // 或者排除某些目录
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true
  },
  
  // 排除 Markdown 文件的某些检查
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD029": false,
    "MD031": false,
    "MD032": false,
    "MD040": false,
    "MD047": false,
    "MD060": false
  }
}
