{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Build: packages (dry-run)",
      "program": "${workspaceFolder}/scripts/build-packages.mjs",
      "args": ["--dry-run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: packages (force, spark-utils)",
      "program": "${workspaceFolder}/scripts/build-packages.mjs",
      "args": ["--force", "--only", "spark-utils"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: packages (incremental)",
      "program": "${workspaceFolder}/scripts/build-packages.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: frontend pipeline",
      "program": "${workspaceFolder}/scripts/build-frontend.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: ensure ClassModel bundle",
      "program": "${workspaceFolder}/scripts/ensure-class-model-bundle.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: ClassModel generate (full)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "--no-cache"],
      "args": ["${workspaceFolder}/scripts/generate-dts-class-model.mjs"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: vite build (root FE only)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vite", "build"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build: all (skip Java)",
      "program": "${workspaceFolder}/scripts/build-all.mjs",
      "env": {
        "SKIP_JAVA": "true"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach: Node (port 9229)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
