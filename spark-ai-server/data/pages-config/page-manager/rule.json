[
  {
    "type": "div",
    "class": "page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": ["页面管理"]
      },
      {
        "type": "el-alert",
        "props": {
          "title": "管理系统中所有页面的配置信息",
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "style": {
          "marginBottom": "16px"
        }
      },
      {
        "type": "div",
        "style": {
          "marginBottom": "10px",
          "display": "flex",
          "gap": "8px"
        },
        "children": [
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "size": "small"
            },
            "on": {
              "click": "handleAdd"
            },
            "children": ["新增页面"]
          },
          {
            "type": "el-button",
            "props": {
              "type": "success",
              "size": "small"
            },
            "on": {
              "click": "handleEdit"
            },
            "children": ["编辑"]
          },
          {
            "type": "el-button",
            "props": {
              "type": "danger",
              "size": "small"
            },
            "on": {
              "click": "handleDelete"
            },
            "children": ["删除"]
          }
        ]
      },
      {
        "type": "el-table",
        "dataKey": "Pages@rows",
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true
        },
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "prop": "id",
              "label": "ID",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "页面名称"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "path",
              "label": "路径"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "status",
              "label": "状态"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "type",
              "label": "类型"
            }
          }
        ]
      }
    ]
  }
]