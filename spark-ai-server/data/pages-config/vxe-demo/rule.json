[
  {
    "type": "div",
    "class": "vxe-demo-page",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "div",
        "class": "intro-section",
        "children": [
          {
            "type": "h1",
            "children": [
              "数据权限表格示例"
            ]
          },
          {
            "type": "p",
            "class": "description",
            "children": [
              "最小化配置示例：用 r-table 内建过滤和 r-detail 当前行绑定完成表格浏览，不额外编写命令式过滤脚本。"
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "class": "table-section",
        "props": {
          "title": "数据表格",
          "description": "筛选字段直接来自列配置，点击行即可联动下方详情。"
        },
        "children": [
          {
            "type": "r-table",
            "dataKey": "PermissionData@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "height": 400,
              "filterColumns": [
                "name",
                "deptName",
                "roleName",
                "status"
              ]
            },
            "children": [
              {
                "type": "r-text",
                "name": "id",
                "props": {
                  "label": "ID",
                  "width": 80
                }
              },
              {
                "type": "r-text",
                "name": "name",
                "props": {
                  "label": "姓名",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "name": "deptName",
                "props": {
                  "label": "部门",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "name": "roleName",
                "props": {
                  "label": "角色",
                  "width": 120
                }
              },
              {
                "type": "r-number",
                "name": "salary",
                "props": {
                  "label": "薪资",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "name": "status",
                "props": {
                  "label": "状态",
                  "width": 100
                }
              },
              {
                "type": "r-date",
                "name": "joinDate",
                "props": {
                  "label": "入职日期",
                  "width": 120
                }
              }
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "class": "detail-section",
        "props": {
          "title": "详情"
        },
        "children": [
          {
            "type": "r-detail",
            "dataKey": "PermissionData@currentRow",
            "children": [
              {
                "type": "r-text",
                "name": "name",
                "props": {
                  "label": "姓名",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "deptName",
                "props": {
                  "label": "部门",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "roleName",
                "props": {
                  "label": "角色",
                  "colSpan": 12
                }
              },
              {
                "type": "r-number",
                "name": "salary",
                "props": {
                  "label": "薪资",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "status",
                "props": {
                  "label": "状态",
                  "colSpan": 12
                }
              },
              {
                "type": "r-date",
                "name": "joinDate",
                "props": {
                  "label": "入职日期",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "email",
                "props": {
                  "label": "邮箱",
                  "colSpan": 24
                }
              },
              {
                "type": "r-textarea",
                "name": "remark",
                "props": {
                  "label": "备注",
                  "colSpan": 24,
                  "rows": 3
                }
              }
            ]
          }
        ]
      }
    ]
  }
]