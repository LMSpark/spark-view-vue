[
  {
    "type": "div",
    "class": "vxe-demo-page",
    "children": [
      {
        "type": "section",
        "class": "intro-section",
        "children": [
          {
            "type": "h1",
            "children": ["VXE Table 示例"]
          },
          {
            "type": "p",
            "class": "description",
            "children": [
              "演示 VXE Table 在低代码内的基础使用，包括排序、过滤、多级表头等能力。"
            ]
          }
        ]
      },
      {
        "type": "section",
        "class": "table-section",
        "children": [
          {
            "type": "h2",
            "children": ["基础表格"]
          },
          {
            "type": "p",
            "class": "section-tip",
            "children": ["下表展示成员档案，可直接排序与单选过滤。"]
          },
          {
            "type": "vxe-table",
            "dataSource": "users",
            "border": true,
            "stripe": true,
            "round": true,
            "height": 360,
            "columnConfig": {
              "resizable": true,
              "isCurrent": true
            },
            "rowConfig": {
              "isHover": true
            },
            "sortConfig": {
              "remote": false,
              "multiple": false
            },
            "children": [
              {
                "type": "vxe-column",
                "field": "id",
                "title": "ID",
                "width": 80,
                "align": "center",
                "sortable": true,
                "fixed": "left"
              },
              {
                "type": "vxe-column",
                "field": "name",
                "title": "姓名",
                "minWidth": 160
              },
              {
                "type": "vxe-column",
                "field": "role",
                "title": "岗位",
                "minWidth": 160,
                "filters": [
                  {
                    "label": "研发",
                    "value": "研发工程师"
                  },
                  {
                    "label": "产品",
                    "value": "产品经理"
                  },
                  {
                    "label": "测试",
                    "value": "测试工程师"
                  }
                ],
                "filterMultiple": false
              },
              {
                "type": "vxe-column",
                "field": "status",
                "title": "状态",
                "width": 120
              },
              {
                "type": "vxe-column",
                "field": "joinDate",
                "title": "入职日期",
                "width": 140,
                "sortable": true
              },
              {
                "type": "vxe-column",
                "field": "salary",
                "title": "年薪 (万元)",
                "minWidth": 140,
                "align": "right"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "class": "table-section",
        "children": [
          {
            "type": "h2",
            "children": ["多级表头"]
          },
          {
            "type": "p",
            "class": "section-tip",
            "children": ["使用多级表头对季度销售数据进行分组展示。"]
          },
          {
            "type": "vxe-table",
            "dataSource": "quarterSales",
            "border": "inner",
            "stripe": true,
            "showOverflow": "tooltip",
            "height": 340,
            "columnConfig": {
              "resizable": true
            },
            "children": [
              {
                "type": "vxe-column",
                "field": "region",
                "title": "区域",
                "minWidth": 180,
                "fixed": "left"
              },
              {
                "type": "vxe-column",
                "title": "季度销售额 (万元)",
                "children": [
                  {
                    "type": "vxe-column",
                    "field": "q1",
                    "title": "Q1",
                    "width": 120,
                    "align": "right"
                  },
                  {
                    "type": "vxe-column",
                    "field": "q2",
                    "title": "Q2",
                    "width": 120,
                    "align": "right"
                  },
                  {
                    "type": "vxe-column",
                    "field": "q3",
                    "title": "Q3",
                    "width": 120,
                    "align": "right"
                  },
                  {
                    "type": "vxe-column",
                    "field": "q4",
                    "title": "Q4",
                    "width": 120,
                    "align": "right"
                  }
                ]
              },
              {
                "type": "vxe-column",
                "field": "year",
                "title": "年度合计",
                "width": 140,
                "align": "right"
              }
            ]
          }
        ]
      }
    ]
  }
]
