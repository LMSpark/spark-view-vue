[
  {
    "type": "div",
    "class": "vxe-demo-page",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "div",
        "class": "intro-section",
        "children": [
          {
            "type": "h1",
            "children": [
              "数据权限表格示例"
            ]
          },
          {
            "type": "p",
            "class": "description",
            "children": [
              "演示带数据权限控制的表格，包括基于角色、部门、数据范围的权限过滤。"
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "class": "permission-control-section",
        "props": {
          "title": "权限控制区",
          "headerActions": [
            {
              "type": "RenderPermissionFilter"
            }
          ]
        },
        "children": [
          {
            "type": "RenderFilterControls",
            "props": {
              "colSpan": 24
            }
          }
        ]
      },
      {
        "type": "r-section",
        "class": "table-section",
        "props": {
          "title": "数据表格",
          "headerActions": [
            {
              "type": "RenderTableToolbar"
            }
          ]
        },
        "children": [
          {
            "type": "r-table",
            "dataKey": "PermissionData@rows",
            "props": {
              "border": true,
              "highlightCurrentRow": true,
              "height": 400,
              "rowActions": [
                {
                  "type": "RenderActions"
                }
              ],
              "rowActionsWidth": 150,
              "rowActionsFixed": "right",
              "rowActionsLabel": "操作"
            },
            "on": {
              "currentChange": "handleCurrentChange",
              "selectionChange": "handleSelectionChange"
            },
            "children": [
              {
                "type": "r-text",
                "name": "id",
                "props": {
                  "label": "ID",
                  "width": 80
                }
              },
              {
                "type": "r-text",
                "name": "name",
                "props": {
                  "label": "姓名",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "name": "deptName",
                "props": {
                  "label": "部门",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "name": "roleName",
                "props": {
                  "label": "角色",
                  "width": 120
                }
              },
              {
                "type": "r-number",
                "name": "salary",
                "props": {
                  "label": "薪资",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "name": "status",
                "props": {
                  "label": "状态",
                  "width": 100
                }
              },
              {
                "type": "r-date",
                "name": "joinDate",
                "props": {
                  "label": "入职日期",
                  "width": 120
                }
              }
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "class": "detail-section",
        "props": {
          "title": "详情"
        },
        "children": [
          {
            "type": "r-detail",
            "dataKey": "PermissionData@currentRow",
            "children": [
              {
                "type": "r-text",
                "name": "name",
                "props": {
                  "label": "姓名",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "deptName",
                "props": {
                  "label": "部门",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "roleName",
                "props": {
                  "label": "角色",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "salary",
                "props": {
                  "label": "薪资",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "name": "email",
                "props": {
                  "label": "邮箱",
                  "colSpan": 24
                }
              },
              {
                "type": "r-textarea",
                "name": "remark",
                "props": {
                  "label": "备注",
                  "colSpan": 24,
                  "rows": 3
                }
              }
            ]
          }
        ]
      }
    ]
  }
]