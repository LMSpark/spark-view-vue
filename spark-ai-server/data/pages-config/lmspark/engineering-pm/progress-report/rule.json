[
  {
    "type": "div",
    "style": {
      "marginBottom": "16px",
      "display": "flex",
      "justifyContent": "space-between",
      "alignItems": "center"
    },
    "children": [
      {
        "type": "el-page-header",
        "props": {
          "title": "项目进度报告",
          "content": "各项目阶段完成情况跟踪"
        }
      },
      {
        "type": "el-button",
        "props": {
          "type": "primary",
          "icon": "Printer"
        },
        "children": ["导出报告"]
      }
    ]
  },
  {
    "type": "el-card",
    "props": { "header": "项目列表（点击选择项目）", "style": "margin-bottom:16px" },
    "children": [
      {
        "type": "r-table",
        "dataKey": "Projects@rows",
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true
        },
        "children": [
          {
            "type": "r-text",
            "field": "name",
            "props": { "label": "项目名称", "minWidth": 200 }
          },
          {
            "type": "r-text",
            "field": "status",
            "props": { "label": "状态", "width": 100 }
          }
        ]
      }
    ]
  },
  {
    "type": "el-card",
    "props": { "header": "周进度明细" },
    "children": [
      {
        "type": "r-table",
        "dataKey": "WeeklyProgress@rows",
        "props": {
          "border": true,
          "stripe": true
        },
        "children": [
          {
            "type": "r-text",
            "field": "week",
            "props": { "label": "周次", "width": 100 }
          },
          {
            "type": "r-text",
            "field": "planned",
            "props": { "label": "计划完成", "minWidth": 180 }
          },
          {
            "type": "r-text",
            "field": "actual",
            "props": { "label": "实际完成", "width": 120 }
          },
          {
            "type": "r-text",
            "field": "deviation",
            "props": { "label": "偏差", "width": 100 }
          },
          {
            "type": "r-text",
            "field": "risks",
            "props": { "label": "风险备注", "minWidth": 200 }
          }
        ]
      }
    ]
  }
]
