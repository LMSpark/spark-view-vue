[
  {
    "type": "div",
    "children": [
      {
        "type": "el-page-header",
        "props": {
          "title": "项目进度报告",
          "content": "各项目阶段完成情况跟踪"
        }
      },
      {
        "type": "el-button",
        "children": [
          "导出报告"
        ],
        "props": {
          "type": "primary",
          "icon": "Printer"
        }
      }
    ],
    "props": {
      "style": {
        "marginBottom": "16px",
        "display": "flex",
        "justifyContent": "space-between",
        "alignItems": "center"
      }
    }
  },
  {
    "type": "el-card",
    "children": [
      {
        "type": "r-table",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "项目名称",
              "minWidth": 200,
              "field": "name"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "状态",
              "width": 100,
              "field": "status"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "dataKey": "Projects@rows"
        }
      }
    ],
    "props": {
      "header": "项目列表（点击选择项目）",
      "style": "margin-bottom:16px"
    }
  },
  {
    "type": "el-card",
    "children": [
      {
        "type": "r-table",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "周次",
              "width": 100,
              "field": "week"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "计划完成",
              "minWidth": 180,
              "field": "planned"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "实际完成",
              "width": 120,
              "field": "actual"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "偏差",
              "width": 100,
              "field": "deviation"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "风险备注",
              "minWidth": 200,
              "field": "risks"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "dataKey": "WeeklyProgress@rows"
        }
      }
    ],
    "props": {
      "header": "周进度明细"
    }
  }
]
