[
  {
    "type": "div",
    "style": {
      "marginBottom": "16px"
    },
    "children": [
      {
        "type": "el-page-header",
        "props": {
          "title": "项目进度报告",
          "content": "各项目阶段完成情况跟踪"
        }
      }
    ]
  },
  {
    "type": "div",
    "style": {
      "display": "flex",
      "gap": "8px",
      "marginBottom": "16px"
    },
    "children": [
      {
        "type": "el-select",
        "name": "reportProject",
        "props": {
          "placeholder": "选择项目",
          "style": "width:220px"
        },
        "children": [
          {
            "type": "el-option",
            "props": {
              "label": "全部项目",
              "value": "all"
            }
          },
          {
            "type": "el-option",
            "props": {
              "label": "智慧园区综合管理平台",
              "value": "p1"
            }
          },
          {
            "type": "el-option",
            "props": {
              "label": "ERP系统升级",
              "value": "p2"
            }
          },
          {
            "type": "el-option",
            "props": {
              "label": "移动办公平台",
              "value": "p3"
            }
          }
        ]
      },
      {
        "type": "el-date-picker",
        "name": "reportMonth",
        "props": {
          "type": "month",
          "placeholder": "选择月份"
        }
      },
      {
        "type": "el-button",
        "props": {
          "type": "primary",
          "icon": "Printer"
        },
        "children": [
          "导出报告"
        ]
      }
    ]
  },
  {
    "type": "el-card",
    "props": {
      "header": "周进度汇总"
    },
    "children": [
      {
        "type": "r-table",
        "dataKey": "WeeklyProgress@rows",
        "props": {
          "border": true,
          "stripe": true
        },
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "prop": "week",
              "label": "周次",
              "width": 100
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "project",
              "label": "项目",
              "minWidth": 180
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "planned",
              "label": "计划完成",
              "width": 120
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "actual",
              "label": "实际完成",
              "width": 120
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "deviation",
              "label": "偏差",
              "width": 100
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "risks",
              "label": "风险备注",
              "minWidth": 200
            }
          }
        ]
      }
    ]
  }
]
