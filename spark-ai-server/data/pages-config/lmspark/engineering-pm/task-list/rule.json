[
  {
    "type": "r-table",
    "children": [
      {
        "type": "el-table-column",
        "props": {
          "prop": "title",
          "label": "任务名称",
          "minWidth": 220
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "projectName",
          "label": "所属项目",
          "width": 160
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "assigneeName",
          "label": "负责人",
          "width": 100
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "priority",
          "label": "优先级",
          "width": 80
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "status",
          "label": "状态",
          "width": 100
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "dueDate",
          "label": "截止日期",
          "width": 120
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "estimatedHours",
          "label": "预估工时",
          "width": 100
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "actualHours",
          "label": "实际工时",
          "width": 100
        }
      }
    ],
    "props": {
      "border": true,
      "stripe": true,
      "highlightCurrentRow": true,
      "filter": {
        "type": "r-filter",
        "children": [
          {
            "type": "r-select",
            "props": {
              "label": "所属项目",
              "placeholder": "选择项目",
              "options": [
                {
                  "label": "智慧园区项目",
                  "value": "p1"
                },
                {
                  "label": "ERP升级项目",
                  "value": "p2"
                },
                {
                  "label": "移动办公平台",
                  "value": "p3"
                }
              ],
              "field": "projectId"
            }
          },
          {
            "type": "r-select",
            "props": {
              "label": "任务状态",
              "placeholder": "任务状态",
              "options": [
                {
                  "label": "未开始",
                  "value": "未开始"
                },
                {
                  "label": "进行中",
                  "value": "进行中"
                },
                {
                  "label": "待审核",
                  "value": "待审核"
                },
                {
                  "label": "已完成",
                  "value": "已完成"
                }
              ],
              "field": "status"
            }
          }
        ]
      },
      "toolbar": {
        "type": "r-toolbar",
        "children": [
          {
            "type": "r-tail",
            "children": [
              {
                "type": "r-button",
                "props": {
                  "label": "创建任务",
                  "buttonType": "primary",
                  "icon": "Plus"
                }
              }
            ]
          }
        ],
        "props": {
          "position": "top"
        }
      },
      "actions": {
        "type": "r-toolbar",
        "children": [
          {
            "type": "r-button",
            "props": {
              "action": "message-row",
              "label": "查看",
              "buttonSize": "small",
              "message": "任务 {title} | 负责人 {assigneeName} | 状态 {status} | 截止 {dueDate}"
            }
          }
        ],
        "props": {
          "label": "操作",
          "width": 120,
          "fixed": "right"
        }
      },
      "dataKey": "Tasks@rows"
    }
  }
]
