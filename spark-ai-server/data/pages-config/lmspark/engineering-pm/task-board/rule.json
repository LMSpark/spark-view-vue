              "slot": "header"
            },
            "children": [
              {
                "type": "el-tag",
                "props": {
                  "type": "info"
                },
                "children": [
                  "待处理 (3)"
                ]
              }
            ]
          },
          {
            "type": "r-table",
            "dataKey": "TodoTasks@rows",
            "props": {
              "border": false,
              "stripe": false
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "title",
                  "label": "任务",
                  "showOverflowTooltip": true
