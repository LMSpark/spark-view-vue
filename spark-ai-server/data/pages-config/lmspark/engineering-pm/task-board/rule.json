[
  {
    "type": "div",
    "style": {
      "marginBottom": "16px"
    },
    "children": [
      {
        "type": "el-page-header",
        "props": {
          "title": "任务看板",
          "content": "以看板视图管理任务状态"
        }
      }
    ]
  },
