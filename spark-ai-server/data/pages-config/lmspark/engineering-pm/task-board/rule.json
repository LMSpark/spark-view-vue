[
  {
    "type": "div",
    "children": [
      {
        "type": "el-page-header",
        "props": {
          "title": "任务看板",
          "content": "以看板视图管理任务状态"
        }
      }
    ],
    "props": {
      "style": {
        "marginBottom": "16px"
      }
    }
  },
  {
    "type": "div",
    "children": [
      {
        "type": "el-card",
        "children": [
          {
            "type": "div",
            "children": [
              {
                "type": "el-tag",
                "children": [
                  "待处理 (3)"
                ],
                "props": {
                  "type": "info"
                }
              }
            ],
            "props": {
              "slot": "header"
            }
          },
          {
            "type": "r-table",
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "title",
                  "label": "任务",
                  "showOverflowTooltip": true
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "priority",
                  "label": "优先级",
                  "width": 80
                }
              }
            ],
            "props": {
              "border": false,
              "stripe": false,
              "dataKey": "TodoTasks@rows"
            }
          }
        ],
        "props": {
          "style": {
            "flex": 1,
            "overflow": "auto"
          }
        }
      },
      {
        "type": "el-card",
        "children": [
          {
            "type": "div",
            "children": [
              {
                "type": "el-tag",
                "children": [
                  "进行中 (3)"
                ],
                "props": {
                  "type": "warning"
                }
              }
            ],
            "props": {
              "slot": "header"
            }
          },
          {
            "type": "r-table",
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "title",
                  "label": "任务",
                  "showOverflowTooltip": true
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "assignee",
                  "label": "负责人",
                  "width": 80
                }
              }
            ],
            "props": {
              "border": false,
              "stripe": false,
              "dataKey": "InProgressTasks@rows"
            }
          }
        ],
        "props": {
          "style": {
            "flex": 1,
            "overflow": "auto"
          }
        }
      },
      {
        "type": "el-card",
        "children": [
          {
            "type": "div",
            "children": [
              {
                "type": "el-tag",
                "children": [
                  "已完成 (2)"
                ],
                "props": {
                  "type": "success"
                }
              }
            ],
            "props": {
              "slot": "header"
            }
          },
          {
            "type": "r-table",
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "title",
                  "label": "任务",
                  "showOverflowTooltip": true
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "completedDate",
                  "label": "完成日期",
                  "width": 110
                }
              }
            ],
            "props": {
              "border": false,
              "stripe": false,
              "dataKey": "DoneTasks@rows"
            }
          }
        ],
        "props": {
          "style": {
            "flex": 1,
            "overflow": "auto"
          }
        }
      }
    ],
    "props": {
      "style": {
        "display": "flex",
        "gap": "16px",
        "height": "calc(100vh - 200px)"
      }
    }
  }
