                  "width": 80
                }
              }
            ]
          }
        ]
      },
      {
        "type": "el-card",
        "style": {
          "flex": 1,
          "overflow": "auto"
        },
        "children": [
          {
            "type": "div",
            "props": {
              "slot": "header"
            },
            "children": [
              {
                "type": "el-tag",
                "props": {
                  "type": "warning"
                },
                "children": [
                  "进行中 (3)"
                ]
              }
            ]
          },
          {
            "type": "r-table",
            "dataKey": "InProgressTasks@rows",
            "props": {
              "border": false,
              "stripe": false
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "title",
                  "label": "任务",
                  "showOverflowTooltip": true
