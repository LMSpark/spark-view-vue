          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "manager",
              "label": "项目经理",
              "width": 100
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "progress",
              "label": "总进度",
              "width": 100
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "taskDone",
              "label": "已完成任务",
              "width": 110
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "taskTotal",
              "label": "总任务数",
              "width": 100
