          "title": "项目仪表盘",
          "content": "跨项目KPI概览"
        }
      }
    ],
    "props": {
      "style": {
        "marginBottom": "16px"
      }
    }
  },
  {
    "type": "el-row",
    "children": [
      {
        "type": "el-col",
