    "props": {
      "gutter": 16,
      "style": {
        "marginBottom": "16px"
      }
    }
  },
  {
    "type": "el-card",
    "children": [
      {
        "type": "r-table",
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "prop": "project",
              "label": "项目名称",
