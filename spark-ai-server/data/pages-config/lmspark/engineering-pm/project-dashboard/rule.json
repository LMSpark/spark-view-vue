            "props": {
              "shadow": "hover"
            }
          }
        ],
        "props": {
          "span": 6
        }
      },
      {
        "type": "el-col",
        "children": [
          {
            "type": "el-card",
            "children": [
              {
                "type": "el-statistic",
                "props": {
                  "title": "按期完成率",
