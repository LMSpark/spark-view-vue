                  "suffix": "%"
                }
              }
            ],
            "props": {
              "shadow": "hover"
            }
          }
        ],
        "props": {
          "span": 6
        }
      },
      {
        "type": "el-col",
        "children": [
          {
            "type": "el-card",
            "children": [
              {
                "type": "el-statistic",
                "props": {
                  "title": "风险项目",
                  "value": 1
                }
              }
            ],
            "props": {
              "shadow": "hover"
            }
          }
        ],
        "props": {
          "span": 6
        }
      },
      {
        "type": "el-col",
        "children": [
          {
            "type": "el-card",
            "children": [
              {
                "type": "el-statistic",
                "props": {
                  "title": "本月里程碑",
                  "value": 3
                }
              }
            ],
            "props": {
              "shadow": "hover"
            }
          }
        ],
        "props": {
          "span": 6
        }
      }
