[
  {
    "type": "r-table",
    "dataKey": "Documents@rows",
    "props": {
      "border": true,
      "stripe": true,
      "highlightCurrentRow": true
    },
    "children": [
      {
        "type": "r-toolbar",
        "props": {
          "position": "top"
        },
        "children": [
          {
            "type": "r-tail",
            "children": [
              {
                "type": "r-button",
                "props": {
                  "label": "上传文档",
                  "buttonType": "primary",
                  "icon": "Upload"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "r-filter",
        "children": [
          {
            "type": "r-text",
            "field": "name",
            "props": {
              "label": "文档名称",
              "placeholder": "搜索文档名称..."
            }
          },
          {
            "type": "r-select",
            "field": "type",
            "props": {
              "label": "文档类型",
              "placeholder": "文档类型",
              "options": [
                {
                  "label": "需求文档",
                  "value": "需求文档"
                },
                {
                  "label": "设计文档",
                  "value": "设计文档"
                },
                {
                  "label": "测试报告",
                  "value": "测试报告"
                },
                {
                  "label": "会议纪要",
                  "value": "会议纪要"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "name",
          "label": "文档名称",
          "minWidth": 220
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "type",
          "label": "类型",
          "width": 120
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "project",
          "label": "所属项目",
          "width": 160
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "author",
          "label": "作者",
          "width": 100
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "size",
          "label": "大小",
          "width": 100
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "updateDate",
          "label": "更新日期",
          "width": 120
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "version",
          "label": "版本",
          "width": 80
        }
      },
      {
        "type": "r-actions",
        "props": {
          "label": "操作",
          "width": 140,
          "fixed": "right"
        },
        "children": [
          {
            "type": "r-button",
            "props": {
              "action": "message-row",
              "label": "查看",
              "buttonSize": "small",
              "message": "文档 {name} | 类型 {type} | 项目 {project} | 版本 {version}"
            }
          }
        ]
      }
    ]
  }
]