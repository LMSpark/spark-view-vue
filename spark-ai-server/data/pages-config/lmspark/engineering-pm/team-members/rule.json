[
  {
    "type": "r-table",
    "children": [
      {
        "type": "el-table-column",
        "props": {
          "prop": "name",
          "label": "姓名",
          "width": 120
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "role",
          "label": "角色",
          "width": 120
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "department",
          "label": "部门",
          "width": 120
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "email",
          "label": "邮箱",
          "width": 200
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "phone",
          "label": "电话",
          "width": 140
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "skills",
          "label": "技能",
          "minWidth": 200
        }
      },
      {
        "type": "el-table-column",
        "props": {
          "prop": "joinDate",
          "label": "入职日期",
          "width": 120
        }
      }
    ],
    "props": {
      "border": true,
      "stripe": true,
      "highlightCurrentRow": true,
      "filter": {
        "type": "r-filter",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "姓名",
              "placeholder": "搜索姓名...",
              "field": "name"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "技能关键词",
              "placeholder": "搜索技能...",
              "field": "skills"
            }
          },
          {
            "type": "r-select",
            "props": {
              "label": "角色",
              "placeholder": "按角色筛选",
              "options": [
                {
                  "label": "项目经理",
                  "value": "项目经理"
                },
                {
                  "label": "开发工程师",
                  "value": "开发工程师"
                },
                {
                  "label": "设计师",
                  "value": "设计师"
                },
                {
                  "label": "测试工程师",
                  "value": "测试工程师"
                }
              ],
              "field": "role"
            }
          }
        ]
      },
      "toolbar": {
        "type": "r-toolbar",
        "children": [
          {
            "type": "r-tail",
            "children": [
              {
                "type": "r-button",
                "props": {
                  "label": "新增成员",
                  "buttonType": "primary",
