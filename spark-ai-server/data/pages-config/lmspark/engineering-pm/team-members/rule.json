      },
      "actions": {
        "type": "r-toolbar",
        "children": [
          {
            "type": "r-button",
            "props": {
              "action": "message-row",
              "label": "查看",
              "buttonSize": "small",
              "message": "成员 {name} | 角色 {role} | 部门 {department} | 电话 {phone}"
            }
          }
        ],
        "props": {
          "label": "操作",
          "width": 120,
          "fixed": "right"
        }
      },
      "dataKey": "TeamMembers@rows"
    }
  }
