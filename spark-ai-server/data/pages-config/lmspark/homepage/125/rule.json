[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "用户管理"
        ]
      },
      {
        "type": "div",
        "children": [
          {
            "type": "RenderToolbar"
          }
        ],
        "props": {
          "style": {
            "marginBottom": "16px",
            "display": "flex",
            "gap": "8px"
          }
        }
      },
      {
        "type": "r-table",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "ID",
              "width": 80,
              "field": "id"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "姓名",
              "width": 120,
              "field": "name"
            }
          },
          {
            "type": "r-number",
            "props": {
              "label": "年龄",
              "width": 100,
              "field": "age"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "邮箱",
              "width": 200,
              "field": "email"
            }
          },
          {
            "type": "r-select",
            "props": {
              "label": "状态",
              "width": 100,
              "options": [
                {
                  "label": "启用",
                  "value": "active"
                },
                {
                  "label": "禁用",
                  "value": "inactive"
                }
              ],
              "field": "status"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "filterable": true,
          "toolbar": {
            "type": "r-toolbar",
            "children": [
              {
                "type": "RenderRowActions"
              }
            ]
          },
          "dataKey": "Users@rows"
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
