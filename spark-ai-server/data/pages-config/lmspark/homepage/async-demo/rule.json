[
  {
    "type": "div",
    "class": "dashboard-page",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "div",
        "class": "page-header",
        "children": [
          {
            "type": "h1",
            "children": [
              "异步数据加载演示"
            ]
          },
          {
            "type": "RenderRefreshButton"
          }
        ]
      },
      {
        "type": "div",
        "class": "stats-container",
        "children": [
          {
            "type": "RenderStatCard",
            "props": {
              "label": "总用户数",
              "dataKey": "Stats@currentRow.totalUsers"
            }
          },
          {
            "type": "RenderStatCard",
            "props": {
              "label": "今日订单",
              "dataKey": "Stats@currentRow.todayOrders"
            }
          },
          {
            "type": "RenderStatCard",
            "props": {
              "label": "总收入",
              "dataKey": "Stats@currentRow.revenue"
            }
          }
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "最近订单（异步加载）",
          "headerActions": [
            {
              "type": "RenderRefreshOrdersButton"
            }
          ]
        },
        "children": [
          {
            "type": "r-table",
            "dataKey": "RecentOrders@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "orderNo",
                "props": {
                  "label": "订单号",
                  "width": 180
                }
              },
              {
                "type": "r-text",
                "field": "customer",
                "props": {
                  "label": "客户"
                }
              },
              {
                "type": "r-number",
                "field": "amount",
                "props": {
                  "label": "金额"
                }
              },
              {
                "type": "r-text",
                "field": "status",
                "props": {
                  "label": "状态"
                }
              },
              {
                "type": "r-date",
                "field": "date",
                "props": {
                  "label": "日期",
                  "width": 120
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
