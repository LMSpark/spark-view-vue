[
  {
    "type": "div",
    "class": "section-grid-demo",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h1",
        "children": [
          "⚡ CYBER GRID ⚡"
        ]
      },
      {
        "type": "p",
        "children": [
          "[ SYSTEM.ONLINE ] — 赛博数据矩阵 · 列级对齐演示 · 霓虹辉光引擎 · 配置驱动零代码"
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "⬡ 用户数据矩阵",
          "description": "DATA_MATRIX :: SELECT * FROM users — 实时数据流 · 霓虹对齐 · 全息详情"
        },
        "children": [
          {
            "type": "r-table",
            "dataKey": "Users@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "rowActionsWidth": 360,
              "rowActionsFixed": "right",
              "rowActionsAlign": "center",
              "rowActionsLabel": "⚙ 操作"
            },
            "children": [
              {
                "type": "r-toolbar",
                "props": {
                  "position": "top"
                },
                "children": [
                  {
                    "type": "r-button",
                    "order": 1,
                    "props": {
                      "action": "append-row",
                      "label": "✚ 新增",
                      "type": "primary",
                      "size": "small"
                    }
                  },
                  {
                    "type": "r-button",
                    "order": 2,
                    "props": {
                      "action": "delete-selected",
                      "label": "✖ 删除勾选",
                      "type": "danger",
                      "size": "small",
                      "plain": true
                    }
                  },
                  {
                    "type": "r-button",
                    "order": 3,
                    "props": {
                      "action": "refresh",
                      "label": "↻ 刷新",
                      "size": "small"
                    }
                  }
                ]
              },
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "ID",
                  "width": 80,
                  "titleAlign": "center",
                  "valueAlign": "center",
                  "headerCellClassName": "demo-col-header-center",
                  "cellClassName": "demo-col-cell-center",
                  "valueClassName": "demo-value-center"
                }
              },
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "姓名",
                  "width": 120,
                  "titleAlign": "right",
                  "valueAlign": "right",
                  "headerCellClassName": "demo-col-header-right",
                  "cellClassName": "demo-col-cell-right",
                  "valueClassName": "demo-value-right"
                }
              },
              {
                "type": "r-select",
                "field": "gender",
                "props": {
                  "label": "性别",
                  "width": 100,
                  "options": [
                    {
                      "label": "男",
                      "value": "male"
                    },
                    {
                      "label": "女",
                      "value": "female"
                    }
                  ]
                }
              },
              {
                "type": "r-number",
                "field": "age",
                "props": {
                  "label": "年龄",
                  "width": 100
                }
              },
              {
                "type": "r-date",
                "field": "joinDate",
                "props": {
                  "label": "入职日期",
                  "width": 150
                }
              },
              {
                "type": "r-select",
                "field": "department",
                "props": {
                  "label": "部门",
                  "width": 150,
                  "options": [
                    {
                      "label": "技术部",
                      "value": "tech"
                    },
                    {
                      "label": "市场部",
                      "value": "market"
                    },
                    {
                      "label": "人事部",
                      "value": "hr"
                    },
                    {
                      "label": "财务部",
                      "value": "finance"
                    }
                  ]
                }
              },
              {
                "type": "r-switch",
                "field": "active",
                "props": {
                  "label": "状态",
                  "width": 100,
                  "activeText": "启用",
                  "inactiveText": "禁用"
                }
              },
              {
                "type": "r-actions",
                "children": [
                  {
                    "type": "r-button",
                    "order": 1,
                    "props": {
                      "action": "message-row",
                      "type": "primary",
                      "size": "small",
                      "link": true
                    }
                  },
                  {
                    "type": "r-button",
                    "order": 2,
                    "props": {
                      "action": "prompt-edit",
                      "type": "warning",
                      "size": "small",
                      "link": true
                    }
                  },
                  {
                    "type": "RenderStatusAction",
                    "order": 3
                  },
                  {
                    "type": "r-button",
                    "order": 4,
                    "props": {
                      "action": "delete-row",
                      "type": "danger",
                      "size": "small",
                      "link": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "⬡ 选中实体详情",
          "description": "ENTITY_DETAIL :: 点击表格行查看实体全息数据投影"
        },
        "children": [
          {
            "type": "r-detail",
            "dataKey": "Users@currentRow",
            "props": {},
            "children": [
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "用户ID",
                  "colSpan": 12
                }
              },
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "姓名",
                  "colSpan": 12
                }
              },
              {
                "type": "r-select",
                "field": "gender",
                "props": {
                  "label": "性别",
                  "colSpan": 12
                }
              },
              {
                "type": "r-number",
                "field": "age",
                "props": {
                  "label": "年龄",
                  "colSpan": 12
                }
              },
              {
                "type": "r-date",
                "field": "joinDate",
                "props": {
                  "label": "入职日期",
                  "colSpan": 12
                }
              },
              {
                "type": "r-select",
                "field": "department",
                "props": {
                  "label": "部门",
                  "colSpan": 12
                }
              },
              {
                "type": "r-switch",
                "field": "active",
                "props": {
                  "label": "状态",
                  "colSpan": 24
                }
              }
            ]
          }
        ]
      }
    ]
  }
]