[
  {
    "type": "r-section",
    "id": "leave-summary-section",
    "props": {
      "title": "请假统计",
      "useCard": true,
      "gridColumns": 24
    },
    "children": [
      {
        "type": "data-view-meta-bar",
        "id": "leave-summary-bar",
        "props": {
          "dataViewKey": "LeaveRequest@pending",
          "columns": [
            {
              "dataMember": "aggregateResult",
              "dataField": "totalCount",
              "label": "待审批数"
            }
          ]
        },
        "children": []
      }
    ]
  },
  {
    "type": "r-section",
    "id": "leave-application-section",
    "props": {
      "title": "请假申请",
      "useCard": true,
      "gridColumns": 24
    },
    "children": [
      {
        "type": "r-form",
        "id": "leave-application-form",
        "props": {
          "dataViewKey": "LeaveRequest@default",
          "contextDataMember": "currentRow",
          "labelWidth": "100px",
          "gridColumns": 2,
          "gridGap": "16px"
        },
        "children": [
          {
            "type": "r-text",
            "id": "field-applicant",
            "props": {
              "field": "applicant",
              "label": "申请人"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "field-applicantName",
            "props": {
              "field": "applicantName",
              "label": "申请人姓名"
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "field-leaveType",
            "props": {
              "field": "leaveType",
              "label": "请假类型",
              "optionDataViewKey": "LeaveType@default",
              "optionLabelField": "label",
              "optionValueField": "value",
              "placeholder": "请选择请假类型"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-startDate",
            "props": {
              "field": "startDate",
              "label": "开始日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD",
              "placeholder": "选择开始日期"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-endDate",
            "props": {
              "field": "endDate",
              "label": "结束日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD",
              "placeholder": "选择结束日期"
            },
            "children": []
          },
          {
            "type": "r-number",
            "id": "field-days",
            "props": {
              "field": "days",
              "label": "请假天数",
              "min": 0.5,
              "placeholder": "请输入天数"
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "field-reason",
            "props": {
              "field": "reason",
              "label": "请假事由",
              "rows": 3,
              "placeholder": "请输入请假事由"
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "btn-submit",
            "props": {
              "action": "submit-current-form",
              "label": "提交申请",
              "buttonType": "primary"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "pending-leave-section",
    "props": {
      "title": "待审批列表",
      "useCard": true,
      "gridColumns": 24
    },
    "children": [
      {
        "type": "r-table",
        "id": "pending-leave-table",
        "props": {
          "dataViewKey": "LeaveRequest@pending",
          "autoColumns": true,
          "stripe": true,
          "showPagination": true
        },
        "children": []
      }
    ]
  }
]
