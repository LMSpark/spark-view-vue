[
  {
    "type": "div",
    "class": "page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": [
          "客户关系管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "title": "管理客户信息、联系人、跟进记录等",
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "style": {
          "marginBottom": "16px"
        }
      },
      {
        "type": "div",
        "style": {
          "display": "flex",
          "gap": "16px",
          "alignItems": "flex-start"
        },
        "children": [
          {
            "type": "div",
            "style": {
              "width": "300px",
              "flexShrink": "0"
            },
            "children": [
              {
                "type": "h3",
                "children": [
                  "客户列表"
                ]
              },
              {
                "type": "el-table",
                "dataKey": "Customers@rows",
                "props": {
                  "border": true,
                  "stripe": true,
                  "highlightCurrentRow": true
                },
                "on": {
                  "currentChange": "handleCustomerSelect"
                },
                "children": [
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "id",
                      "label": "ID",
                      "width": "80"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "name",
                      "label": "客户名称"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "level",
                      "label": "客户等级",
                      "width": "100"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "div",
            "style": {
              "flex": "1",
              "minWidth": "0"
            },
            "children": [
              {
                "type": "el-tabs",
                "props": {
                  "modelValue": "detail"
                },
                "children": [
                  {
                    "type": "el-tab-pane",
                    "props": {
                      "label": "客户详情",
                      "name": "detail"
                    },
                    "children": [
                      {
                        "type": "r-detail",
                        "dataKey": "Customers@currentRow",
                        "props": {
                          "labelWidth": "100px"
                        },
                        "children": [
                          {
                            "type": "r-text",
                            "field": "name",
                            "props": {
                              "label": "客户名称"
                            }
                          },
                          {
                            "type": "r-text",
                            "field": "level",
                            "props": {
                              "label": "客户等级"
                            }
                          },
                          {
                            "type": "r-text",
                            "field": "industry",
                            "props": {
                              "label": "所属行业"
                            }
                          },
                          {
                            "type": "r-text",
                            "field": "address",
                            "props": {
                              "label": "地址"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "el-tab-pane",
                    "props": {
                      "label": "联系人",
                      "name": "contacts"
                    },
                    "children": [
                      {
                        "type": "el-table",
                        "dataKey": "Contacts@rows",
                        "props": {
                          "border": true,
                          "stripe": true
                        },
                        "children": [
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "id",
                              "label": "ID",
                              "width": "80"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "name",
                              "label": "姓名"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "phone",
                              "label": "电话"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "email",
                              "label": "邮箱"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "el-tab-pane",
                    "props": {
                      "label": "跟进记录",
                      "name": "followups"
                    },
                    "children": [
                      {
                        "type": "el-table",
                        "dataKey": "Followups@rows",
                        "props": {
                          "border": true,
                          "stripe": true
                        },
                        "children": [
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "id",
                              "label": "ID",
                              "width": "80"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "date",
                              "label": "日期"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "content",
                              "label": "内容"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "result",
                              "label": "结果"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
