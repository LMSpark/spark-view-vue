[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "客户关系管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "管理客户信息、联系人、跟进记录等",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "div",
            "children": [
              {
                "type": "h3",
                "children": [
                  "客户列表"
                ]
              },
              {
                "type": "el-table",
                "children": [
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "id",
                      "label": "ID",
                      "width": "80"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "name",
                      "label": "客户名称"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "level",
                      "label": "客户等级",
                      "width": "100"
                    }
                  }
                ],
                "props": {
                  "border": true,
                  "stripe": true,
                  "highlightCurrentRow": true,
                  "on": {
                    "currentChange": "handleCustomerSelect"
                  },
                  "dataViewKey": "Customers@default",
                  "dataMember": "rows"
                }
              }
            ],
            "props": {
              "style": {
                "width": "300px",
                "flexShrink": "0"
              }
            }
          },
          {
            "type": "div",
            "children": [
              {
                "type": "el-tabs",
                "children": [
                  {
                    "type": "el-tab-pane",
                    "children": [
                      {
                        "type": "r-detail",
                        "children": [
                          {
                            "type": "r-text",
                            "props": {
                              "label": "客户名称",
                              "field": "name"
                            }
                          },
                          {
                            "type": "r-text",
                            "props": {
                              "label": "客户等级",
                              "field": "level"
                            }
                          },
                          {
                            "type": "r-text",
                            "props": {
                              "label": "所属行业",
                              "field": "industry"
                            }
                          },
                          {
                            "type": "r-text",
                            "props": {
                              "label": "地址",
                              "field": "address"
                            }
                          }
                        ],
                        "props": {
                          "labelWidth": "100px",
                          "dataViewKey": "Customers@default",
                          "contextDataMember": "currentRow"
                        }
                      }
                    ],
                    "props": {
                      "label": "客户详情",
                      "name": "detail"
                    }
                  },
                  {
                    "type": "el-tab-pane",
                    "children": [
                      {
                        "type": "el-table",
                        "children": [
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "id",
                              "label": "ID",
                              "width": "80"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "name",
                              "label": "姓名"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "phone",
                              "label": "电话"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "email",
                              "label": "邮箱"
                            }
                          }
                        ],
                        "props": {
                          "border": true,
                          "stripe": true,
                          "dataViewKey": "Contacts@default",
                          "dataMember": "rows"
                        }
                      }
                    ],
                    "props": {
                      "label": "联系人",
                      "name": "contacts"
                    }
                  },
                  {
                    "type": "el-tab-pane",
                    "children": [
                      {
                        "type": "el-table",
                        "children": [
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "id",
                              "label": "ID",
                              "width": "80"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "date",
                              "label": "日期"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "content",
                              "label": "内容"
                            }
                          },
                          {
                            "type": "el-table-column",
                            "props": {
                              "prop": "result",
                              "label": "结果"
                            }
                          }
                        ],
                        "props": {
                          "border": true,
                          "stripe": true,
                          "dataViewKey": "Followups@default",
                          "dataMember": "rows"
                        }
                      }
                    ],
                    "props": {
                      "label": "跟进记录",
                      "name": "followups"
                    }
                  }
                ],
                "props": {
                  "modelValue": "detail"
                }
              }
            ],
            "props": {
              "style": {
                "flex": "1",
                "minWidth": "0"
              }
            }
          }
        ],
        "props": {
          "style": {
            "display": "flex",
            "gap": "16px",
            "alignItems": "flex-start"
          }
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
