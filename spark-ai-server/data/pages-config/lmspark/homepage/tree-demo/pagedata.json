{
  "dataSetName": "TreeDemoNavigationEditor",
  "tableRelations": [
    {
      "parentTable": "NavigationNodes",
      "childTable": "NodeEditorProfiles",
      "parentField": "editorProfileKey",
      "childField": "profileKey",
      "relationName": "NodeProfileToEditorProfile"
    },
    {
      "parentTable": "NavigationNodes",
      "childTable": "LinkTargetOptions",
      "parentField": "nodeKind",
      "childField": "nodeKind",
      "relationName": "NodeKindToLinkTargets"
    },
    {
      "parentTable": "NavigationNodes",
      "childTable": "ChildPlacementOptions",
      "parentField": "nodeKind",
      "childField": "nodeKind",
      "relationName": "NodeKindToChildPlacements"
    },
    {
      "parentTable": "NavigationNodes",
      "childTable": "RefNodeKindOptions",
      "parentField": "editorProfileKey",
      "childField": "profileKey",
      "relationName": "NodeProfileToRefNodeKinds"
    }
  ],
  "tables": {
    "PageMeta": {
      "columns": [
        {
          "name": "id",
