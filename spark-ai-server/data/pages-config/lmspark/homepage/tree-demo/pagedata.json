              "searchKeyword": "",
              "nodeKindFilter": "all",
              "placementFilter": "all"
            }
          ],
          "autoCurrentFirst": true
        }
      },
      "tableName": "EditorFilters"
    },
    "NavigationNodes": {
      "columns": [
        {
          "name": "id",
          "type": "string",
          "isPrimaryKey": true
        },
        {
          "name": "parentId",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "description",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "icon",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "nodeKind",
          "type": "string"
        },
        {
          "name": "path",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "linkTarget",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "childPlacement",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "sortOrder",
          "type": "number"
        },
        {
          "name": "dividerAfter",
          "type": "boolean",
          "allowDBNull": true
        },
        {
          "name": "hidden",
          "type": "boolean"
        },
        {
          "name": "disabled",
          "type": "boolean"
        },
        {
          "name": "refId",
          "type": "string",
          "allowDBNull": true
        },
        {
          "name": "editorProfileKey",
          "type": "string",
          "computeExpression": "if (nodeKind === 'system-directory' || nodeKind === 'module') return 'container'; if (nodeKind === 'system-page' || nodeKind === 'page' || nodeKind === 'sub-page') return 'page'; if (nodeKind === 'link') return 'link'; if (nodeKind === 'ref') return 'ref'; if (nodeKind === 'system-action') return 'action'; return 'page';"
        }
      ],
      "api": {
        "list": {
          "url": "/navigation/nodes",
          "method": "GET"
        },
        "nested": {
          "url": "/navigation/nodes",
          "method": "GET"
        },
        "children": {
          "url": "/navigation/nodes",
          "method": "GET"
        },
        "path": {
          "url": "/navigation/nodes/path/{id}",
          "method": "GET"
        },
        "subtree": {
          "url": "/navigation/nodes/subtree",
          "method": "POST"
        },
        "nestedSearch": {
          "url": "/navigation/nodes/search",
          "method": "GET"
        },
        "create": {
          "url": "/navigation/nodes",
          "method": "POST"
        },
        "update": {
          "url": "/navigation/nodes/{id}",
          "method": "PUT"
        },
        "delete": {
          "url": "/navigation/nodes/{id}",
          "method": "DELETE"
        },
        "move": {
          "url": "/navigation/nodes/{id}/move",
          "method": "PUT"
        }
      },
      "views": {
        "default": {
          "rows": [],
          "treeConfig": {
            "idField": "id",
            "parentIdField": "parentId",
            "textField": "title",
            "treeMode": "nested"
          },
          "autoLoad": true,
          "autoCurrentFirst": true,
          "autoCommit": true
        }
      },
      "tableName": "NavigationNodes"
    },
