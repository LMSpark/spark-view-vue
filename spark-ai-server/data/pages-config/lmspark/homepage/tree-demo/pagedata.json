        },
        {
          "name": "refCount",
          "type": "number"
        },
        {
          "name": "hiddenCount",
          "type": "number"
        },
        {
          "name": "statusText",
          "type": "string"
        },
        {
          "name": "lastSync",
          "type": "string"
        }
      ],
      "views": {
        "default": {
          "rows": [
            {
              "id": 1,
              "totalNodes": 0,
              "pageCount": 0,
              "groupCount": 0,
              "refCount": 0,
              "hiddenCount": 0,
              "statusText": "等待服务端数据",
              "lastSync": "-"
            }
          ],
          "autoCurrentFirst": true
        }
      },
      "tableName": "PageMeta"
    },
