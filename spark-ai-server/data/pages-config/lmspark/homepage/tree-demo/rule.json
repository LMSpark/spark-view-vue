[
    {
        "type": "div",
        "class": "nav-editor-page",
        "children": [
            {
                "type": "div",
                "class": "nav-editor-header",
                "children": [
                    {
                        "type": "div",
                        "class": "nav-editor-header__title",
                        "children": [
                            {
                                "type": "span",
                                "class": "nav-editor-badge",
                                "children": [
                                    "Navigation Demo"
                                ]
                            },
                            {
                                "type": "h1",
                                "children": [
                                    "导航树服务端编辑 Demo"
                                ]
                            },
                            {
                                "type": "p",
                                "children": [
                                    "左侧直接绑定服务端导航节点，树形由视图 treeConfig 自动构建，右侧展示当前节点字段。"
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "el-row",
                "class": "nav-editor-body",
                "props": {
                    "gutter": 18
                },
                "children": [
                    {
                        "type": "el-col",
                        "props": {
                            "xl": 8,
                            "lg": 9,
                            "md": 24,
                            "sm": 24,
                            "xs": 24
                        },
                        "children": [
                            {
                                "type": "el-card",
                                "class": "nav-editor-panel nav-editor-panel--tree",
                                "props": {
                                    "shadow": "never"
                                },
                                "children": [
                                    {
                                        "type": "div",
                                        "class": "nav-editor-panel__head",
                                        "children": [
                                            {
                                                "type": "h3",
                                                "children": [
                                                    "导航树"
                                                ]
                                            },
                                            {
                                                "type": "p",
                                                "children": [
                                                    "树数据由服务端扁平节点重建，当前先保持最简单结构。"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "class": "nav-editor-tree-shell",
                                        "children": [
                                            {
                                                "type": "r-tree",
                                                "dataKey": "NavigationNodes@rows",
                                                "props": {
                                                    "node-key": "id",
                                                    "highlight-current": true,
                                                    "default-expand-all": true,
                                                    "expand-on-click-node": false
                                                },
                                                "children": [
                                                    {
                                                        "type": "r-tree-node-summary",
                                                        "props": {
                                                            "nameField": "title",
                                                            "typeField": "nodeKind",
                                                            "metaField": "path",
                                                            "extraField": "childPlacement",
                                                            "showType": true,
                                                            "showMeta": true,
                                                            "showExtra": true,
                                                            "showStatus": false,
                                                            "showOwner": false
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "el-col",
                        "props": {
                            "xl": 16,
                            "lg": 15,
                            "md": 24,
                            "sm": 24,
                            "xs": 24
                        },
                        "children": [
                            {
                                "type": "el-card",
                                "class": "nav-editor-panel",
                                "props": {
                                    "shadow": "never",
                                    "header": "基础信息"
                                },
                                "children": [
                                    {
                                        "type": "r-form",
                                        "dataKey": "NavigationNodes@currentRow",
                                        "children": [
                                            {
                                                "type": "r-text",
                                                "field": "title",
                                                "props": {
                                                    "label": "标题"
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "id",
                                                "props": {
                                                    "label": "节点 ID"
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "parentId",
                                                "props": {
                                                    "label": "父节点 ID"
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "icon",
                                                "props": {
                                                    "label": "图标"
                                                }
                                            },
                                            {
                                                "type": "r-radio",
                                                "field": "nodeKind",
                                                "props": {
                                                    "label": "节点类型",
                                                    "buttonStyle": true,
                                                    "optionKey": "NodeKindOptions@rows",
                                                    "optionLabelField": "label",
                                                    "optionValueField": "value"
                                                }
                                            },
                                            {
                                                "type": "r-textarea",
                                                "field": "description",
                                                "props": {
                                                    "label": "描述",
                                                    "rows": 3
                                                }
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "el-card",
                                "class": "nav-editor-panel",
                                "props": {
                                    "shadow": "never",
                                    "header": "导航与布局"
                                },
                                "children": [
                                    {
                                        "type": "r-form",
                                        "dataKey": "NavigationNodes@currentRow",
                                        "children": [
                                            {
                                                "type": "r-text",
                                                "field": "path",
                                                "props": {
                                                    "label": "路径 / URL"
                                                }
                                            },
                                            {
                                                "type": "r-select",
                                                "field": "linkTarget",
                                                "props": {
                                                    "label": "链接打开方式",
                                                    "optionKey": "LinkTargetOptions@rows",
                                                    "optionLabelField": "label",
                                                    "optionValueField": "value"
                                                }
                                            },
                                            {
                                                "type": "r-select",
                                                "field": "childPlacement",
                                                "props": {
                                                    "label": "子项布局",
                                                    "optionKey": "ChildPlacementOptions@rows",
                                                    "optionLabelField": "label",
                                                    "optionValueField": "value"
                                                }
                                            },
                                            {
                                                "type": "r-number",
                                                "field": "sortOrder",
                                                "props": {
                                                    "label": "排序"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "el-card",
                                "class": "nav-editor-panel",
                                "props": {
                                    "shadow": "never",
                                    "header": "状态、引用与上下文"
                                },
                                "children": [
                                    {
                                        "type": "r-form",
                                        "dataKey": "NavigationNodes@currentRow",
                                        "children": [
                                            {
                                                "type": "r-switch",
                                                "field": "dividerAfter",
                                                "props": {
                                                    "label": "后置分隔线"
                                                }
                                            },
                                            {
                                                "type": "r-switch",
                                                "field": "hidden",
                                                "props": {
                                                    "label": "隐藏"
                                                }
                                            },
                                            {
                                                "type": "r-switch",
                                                "field": "disabled",
                                                "props": {
                                                    "label": "禁用"
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "refId",
                                                "props": {
                                                    "label": "引用节点 ID"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]