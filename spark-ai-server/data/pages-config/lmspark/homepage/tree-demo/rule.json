[
  {
    "type": "div",
    "class": "tree-demo-container",
    "children": [
      {
        "type": "div",
        "class": "demo-header",
        "children": [
          {
            "type": "h2",
            "children": [
              "RendererTree 组件演示"
            ]
          },
          {
            "type": "p",
            "children": [
              "使用导航节点数据演示 TreeManager/DataView 的 4 个远程接口 + 7 个本地接口"
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-toolbar",
        "children": [
          {
            "type": "el-input",
            "field": "searchKeyword",
            "value": "",
            "props": {
              "placeholder": "搜索节点...",
              "clearable": true
            },
            "on": {
              "clear": "handleClearSearch",
              "keyup": "handleSearchKeyup"
            },
            "style": {
              "width": "300px",
              "marginRight": "10px"
            }
          },
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "icon": "Search"
            },
            "on": {
              "click": "handleSearch"
            },
            "children": [
              "搜索"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "icon": "Plus"
            },
            "on": {
              "click": "handleAddNode"
            },
            "children": [
              "添加子节点"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "icon": "Delete",
              "type": "danger"
            },
            "on": {
              "click": "handleDeleteNode"
            },
            "children": [
              "删除节点"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "icon": "Download"
            },
            "on": {
              "click": "handleExport"
            },
            "children": [
              "导出数据"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "success"
            },
            "on": {
              "click": "handleRunRemote4"
            },
            "children": [
              "远程4接口"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "warning"
            },
            "on": {
              "click": "handleRunLocal7"
            },
            "children": [
              "本地7接口"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "info"
            },
            "on": {
              "click": "handleRunAll4Plus7"
            },
            "children": [
              "4+7全跑"
            ]
          }
        ]
      },
      {
        "type": "el-row",
        "props": {
          "gutter": 20
        },
        "children": [
          {
            "type": "el-col",
            "props": {
              "span": 12
            },
            "children": [
              {
                "type": "el-card",
                "props": {
                  "header": "组织架构树（RendererTree 演示）"
                },
                "children": [
                  {
                    "type": "div",
                    "class": "tree-wrapper",
                    "children": [
                      {
                        "type": "r-tree",
                        "key": "organization-tree",
                        "dataKey": "hierarchicalTreeData@rows",
                        "props": {
                          "node-key": "id",
                          "highlight-current": true,
                          "default-expand-all": false,
                          "expand-on-click-node": false,
                          "onNodeClick": "handleNodeClick",
                          "onNodeExpand": "handleNodeExpand",
                          "onNodeCollapse": "handleNodeCollapse"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "el-col",
            "props": {
              "span": 12
            },
            "children": [
              {
                "type": "el-card",
                "props": {
                  "header": "节点信息"
                },
                "children": [
                  {
                    "type": "div",
                    "class": "node-info",
                    "children": [
                      {
                        "type": "RenderNodeInfo"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "el-card",
                "props": {
                  "header": "子节点 / 搜索结果"
                },
                "style": {
                  "marginTop": "20px"
                },
                "children": [
                  {
                    "type": "r-table",
                    "dataKey": "childNodes@rows",
                    "props": {
                      "border": true,
                      "stripe": true,
                      "maxHeight": "300",
                      "highlightCurrentRow": true,
                      "rowKey": "id"
                    },
                    "on": {
                      "rowClick": "handleLocateNode"
                    },
                    "children": [
                      {
                        "type": "el-table-column",
                        "props": {
                          "prop": "name",
                          "label": "节点名称",
                          "width": "150"
                        }
                      },
                      {
                        "type": "el-table-column",
                        "props": {
                          "prop": "type",
                          "label": "类型",
                          "width": "100"
                        }
                      },
                      {
                        "type": "el-table-column",
                        "props": {
                          "prop": "pathText",
                          "label": "路径"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-info",
        "style": {
          "marginTop": "30px"
        },
        "children": [
          {
            "type": "el-alert",
            "props": {
              "title": "功能说明",
              "type": "info",
              "showIcon": true
            },
            "children": [
              {
                "type": "div",
                "children": [
                  "1. RendererTree 组件：使用 r-tree 容器组件展示树形数据",
                  {
                    "type": "br"
                  },
                  "2. 数据绑定：通过 dataSource 属性自动绑定 hierarchicalTreeData",
                  {
                    "type": "br"
                  },
                  "3. 嵌套结构：树数据采用嵌套的层级结构（children 属性）",
                  {
                    "type": "br"
                  },
                  "4. 事件处理：支持节点点击、展开、折叠等事件",
                  {
                    "type": "br"
                  },
                  "5. 自定义样式：可以通过 RendererTree 的 slot 自定义节点渲染"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]