[
  {
    "type": "r-section",
    "id": "grade-summary-section",
    "props": {
      "title": "学生成绩管理",
      "description": "Grade 管理工作台",
      "gridColumns": 4,
      "gridGap": "16px",
      "bodyClass": "grade-summary-grid"
    },
    "children": [
      {
        "type": "r-card",
        "id": "grade-metric-1",
        "props": {
          "header": "总成绩数",
          "shadow": "never",
          "bodyClass": "grade-metric-card"
        },
        "children": [
          "总成绩数：--"
        ]
      },
      {
        "type": "r-card",
        "id": "grade-metric-2",
        "props": {
          "header": "平均分",
          "shadow": "never",
          "bodyClass": "grade-metric-card"
        },
        "children": [
          "平均分：--"
        ]
      },
      {
        "type": "r-card",
        "id": "grade-metric-3",
        "props": {
          "header": "最高分",
          "shadow": "never",
          "bodyClass": "grade-metric-card"
        },
        "children": [
          "最高分：--"
        ]
      },
      {
        "type": "r-card",
        "id": "grade-metric-4",
        "props": {
          "header": "最低分",
          "shadow": "never",
          "bodyClass": "grade-metric-card"
        },
        "children": [
          "最低分：--"
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "grade-filter-section",
    "props": {
      "title": "筛选与操作",
      "description": "班级 / 课程 / 等级 / 是否异常",
      "useCard": true,
      "gridGap": "12px"
    },
    "children": [
      {
        "type": "div",
        "id": "grade-filter-row",
        "props": {
          "class": "grade-filter-row"
        },
        "children": [
          {
            "type": "r-text",
            "id": "grade-filter-1",
            "props": {
              "field": "management",
              "label": "班级",
              "placeholder": "筛选班级"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-filter-2",
            "props": {
              "field": "management",
              "label": "课程",
              "placeholder": "筛选课程"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-filter-3",
            "props": {
              "field": "management",
              "label": "等级",
              "placeholder": "筛选等级"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-filter-4",
            "props": {
              "field": "management",
              "label": "是否异常",
              "placeholder": "筛选是否异常"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "grade-form-section",
    "props": {
      "title": "Grade 档案维护",
      "description": "绑定 grade@default 当前行，使用标准字段控件维护业务信息。",
      "useCard": true
    },
    "children": [
      {
        "type": "r-form",
        "id": "grade-form",
        "props": {
          "dataViewKey": "grade@default",
          "contextDataMember": "currentRow",
          "gridColumns": 3,
          "gridGap": "12px 16px",
          "labelWidth": "96px"
        },
        "children": [
          {
            "type": "r-text",
            "id": "grade-field-studentName",
            "props": {
              "field": "studentName",
              "label": "学生姓名",
              "placeholder": "请输入学生姓名"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-field-studentId",
            "props": {
              "field": "studentId",
              "label": "学号",
              "placeholder": "请输入学号"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-field-className",
            "props": {
              "field": "className",
              "label": "班级",
              "placeholder": "请输入班级"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-field-courseName",
            "props": {
              "field": "courseName",
              "label": "课程名称",
              "placeholder": "请输入课程名称"
            },
            "children": []
          },
          {
            "type": "r-number",
            "id": "grade-field-score",
            "props": {
              "field": "score",
              "label": "分数",
              "placeholder": "请输入分数"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-field-grade",
            "props": {
              "field": "grade",
              "label": "等级",
              "placeholder": "请输入等级"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "grade-field-isAbnormal",
            "props": {
              "field": "isAbnormal",
              "label": "是否异常",
              "placeholder": "请输入是否异常"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "grade-field-examDate",
            "props": {
              "field": "examDate",
              "label": "考试日期",
              "placeholder": "请输入考试日期",
              "valueFormat": "YYYY-MM-DD"
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "grade-field-comment",
            "props": {
              "field": "comment",
              "label": "备注",
              "placeholder": "请输入备注",
              "rows": 3
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "grade-save-action",
            "props": {
              "action": "patch-current",
              "dataViewKey": "grade@default",
              "label": "录入成绩",
              "buttonType": "primary",
              "icon": "Save",
              "successMessage": "Grade 信息已更新"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "grade-table-section",
    "props": {
      "title": "Grade 列表",
      "description": "列表绑定 grade@default 的 rows。"
    },
    "children": [
      {
        "type": "r-table",
        "id": "grade-table",
        "props": {
          "dataViewKey": "grade@default",
          "dataMember": "rows",
          "rowKey": "id",
          "autoColumns": true,
          "stripe": true,
          "border": true,
          "showPagination": true
        },
        "children": []
      }
    ]
  }
]
