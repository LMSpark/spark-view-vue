[
  {
    "type": "r-section",
    "id": "employee-summary-section",
    "props": {
      "title": "员工信息管理",
      "description": "Employee 管理工作台",
      "gridColumns": 3,
      "gridGap": "16px",
      "bodyClass": "employee-summary-grid"
    },
    "children": [
      {
        "type": "r-card",
        "id": "employee-metric-1",
        "props": {
          "header": "总人数",
          "shadow": "never",
          "bodyClass": "employee-metric-card"
        },
        "children": [
          "总人数：--"
        ]
      },
      {
        "type": "r-card",
        "id": "employee-metric-2",
        "props": {
          "header": "在职人数",
          "shadow": "never",
          "bodyClass": "employee-metric-card"
        },
        "children": [
          "在职人数：--"
        ]
      },
      {
        "type": "r-card",
        "id": "employee-metric-3",
        "props": {
          "header": "离职人数",
          "shadow": "never",
          "bodyClass": "employee-metric-card"
        },
        "children": [
          "离职人数：--"
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "employee-filter-section",
    "props": {
      "title": "筛选与操作",
      "description": "部门 / 岗位 / 状态",
      "useCard": true,
      "gridGap": "12px"
    },
    "children": [
      {
        "type": "div",
        "id": "employee-filter-row",
        "props": {
          "class": "employee-filter-row"
        },
        "children": [
          {
            "type": "r-text",
            "id": "employee-filter-1",
            "props": {
              "field": "management",
              "label": "部门",
              "placeholder": "筛选部门"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "employee-filter-2",
            "props": {
              "field": "management",
              "label": "岗位",
              "placeholder": "筛选岗位"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "employee-filter-3",
            "props": {
              "field": "management",
              "label": "状态",
              "placeholder": "筛选状态"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "employee-form-section",
    "props": {
      "title": "Employee 档案维护",
      "description": "绑定 employee@default 当前行，使用标准字段控件维护业务信息。",
      "useCard": true
    },
    "children": [
      {
        "type": "r-form",
        "id": "employee-form",
        "props": {
          "dataViewKey": "employee@default",
          "contextDataMember": "currentRow",
          "gridColumns": 3,
          "gridGap": "12px 16px",
          "labelWidth": "96px"
        },
        "children": [
          {
            "type": "r-text",
            "id": "employee-field-name",
            "props": {
              "field": "name",
              "label": "姓名",
              "placeholder": "请输入姓名"
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "employee-field-department",
            "props": {
              "field": "department",
              "label": "部门",
              "placeholder": "请输入部门",
              "options": [
                {
                  "label": "技术部",
                  "value": "技术部"
                },
                {
                  "label": "产品部",
                  "value": "产品部"
                },
                {
                  "label": "市场部",
                  "value": "市场部"
                },
                {
                  "label": "人事部",
                  "value": "人事部"
                },
                {
                  "label": "财务部",
                  "value": "财务部"
                }
              ]
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "employee-field-position",
            "props": {
              "field": "position",
              "label": "岗位",
              "placeholder": "请输入岗位",
              "options": [
                {
                  "label": "经理",
                  "value": "经理"
                },
                {
                  "label": "主管",
                  "value": "主管"
                },
                {
                  "label": "工程师",
                  "value": "工程师"
                },
                {
                  "label": "专员",
                  "value": "专员"
                },
                {
                  "label": "助理",
                  "value": "助理"
                }
              ]
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "employee-field-status",
            "props": {
              "field": "status",
              "label": "状态",
              "placeholder": "请输入状态",
              "options": [
                {
                  "label": "在职",
                  "value": "在职"
                },
                {
                  "label": "离职",
                  "value": "离职"
                },
                {
                  "label": "试用",
                  "value": "试用"
                },
                {
                  "label": "休假",
                  "value": "休假"
                }
              ]
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "employee-field-phone",
            "props": {
              "field": "phone",
              "label": "联系电话",
              "placeholder": "请输入联系电话"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "employee-field-email",
            "props": {
              "field": "email",
              "label": "邮箱",
              "placeholder": "请输入邮箱"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "employee-field-joinDate",
            "props": {
              "field": "joinDate",
              "label": "入职日期",
              "placeholder": "请输入入职日期",
              "valueFormat": "YYYY-MM-DD"
            },
            "children": []
          },
          {
            "type": "r-text",
            "id": "employee-field-idNumber",
            "props": {
              "field": "idNumber",
              "label": "身份证号",
              "placeholder": "请输入身份证号"
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "employee-save-action",
            "props": {
              "action": "patch-current",
              "dataViewKey": "employee@default",
              "label": "保存档案",
              "buttonType": "primary",
              "icon": "Save",
              "successMessage": "Employee 信息已更新"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "employee-table-section",
    "props": {
      "title": "Employee 列表",
      "description": "列表绑定 employee@default 的 rows。"
    },
    "children": [
      {
        "type": "r-table",
        "id": "employee-table",
        "props": {
          "dataViewKey": "employee@default",
          "dataMember": "rows",
          "rowKey": "id",
          "autoColumns": true,
          "stripe": true,
          "border": true,
          "showPagination": true
        },
        "children": []
      }
    ]
  }
]
