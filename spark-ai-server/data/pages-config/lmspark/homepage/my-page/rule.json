[
  {
    "type": "div",
    "class": "my-page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": [
          "数据权限管理"
        ]
      },
      {
        "type": "el-divider"
      },
      {
        "type": "r-section",
        "props": {
          "title": "权限列表",
          "description": "管理用户或角色的数据访问权限"
        },
        "children": [
          {
            "type": "r-header",
            "children": [
              {
                "type": "RenderAddButton"
              },
              {
                "type": "RenderDeleteButton"
              },
              {
                "type": "RenderRefreshButton"
              }
            ]
          },
          {
            "type": "r-table",
            "dataKey": "Permissions@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "children": [
              {
                "type": "r-toolbar",
                "props": {
                  "position": "top"
                },
                "children": [
                  {
                    "type": "RenderSearchBar"
                  }
                ]
              },
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "ID",
                  "width": 80
                }
              },
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "权限名称"
                }
              },
              {
                "type": "r-select",
                "field": "type",
                "props": {
                  "label": "权限类型",
                  "width": 120,
                  "options": [
                    {
                      "label": "用户权限",
                      "value": "user"
                    },
                    {
                      "label": "角色权限",
                      "value": "role"
                    },
                    {
                      "label": "部门权限",
                      "value": "dept"
                    }
                  ]
                }
              },
              {
                "type": "r-text",
                "field": "target",
                "props": {
                  "label": "目标对象",
                  "width": 150
                }
              },
              {
                "type": "r-select",
                "field": "status",
                "props": {
                  "label": "状态",
                  "width": 100,
                  "options": [
                    {
                      "label": "启用",
                      "value": "active"
                    },
                    {
                      "label": "禁用",
                      "value": "inactive"
                    }
                  ]
                }
              },
              {
                "type": "r-date",
                "field": "createdAt",
                "props": {
                  "label": "创建时间",
                  "width": 150
                }
              },
              {
                "type": "RenderActions"
              }
            ]
          }
        ]
      },
      {
        "type": "r-drawer",
        "props": {
          "title": "权限详情",
          "size": "40%"
        },
        "children": [
          {
            "type": "r-header",
            "children": [
              {
                "type": "RenderSaveButton"
              },
              {
                "type": "RenderCancelButton"
              }
            ]
          },
          {
            "type": "r-form",
            "dataKey": "Permissions@currentRow",
            "children": [
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "权限名称",
                  "colSpan": 24,
                  "required": true
                }
              },
              {
                "type": "r-select",
                "field": "type",
                "props": {
                  "label": "权限类型",
                  "colSpan": 12,
                  "required": true,
                  "options": [
                    {
                      "label": "用户权限",
                      "value": "user"
                    },
                    {
                      "label": "角色权限",
                      "value": "role"
                    },
                    {
                      "label": "部门权限",
                      "value": "dept"
                    }
                  ]
                }
              },
              {
                "type": "r-text",
                "field": "target",
                "props": {
                  "label": "目标对象",
                  "colSpan": 12
                }
              },
              {
                "type": "r-select",
                "field": "status",
                "props": {
                  "label": "状态",
                  "colSpan": 12,
                  "options": [
                    {
                      "label": "启用",
                      "value": "active"
                    },
                    {
                      "label": "禁用",
                      "value": "inactive"
                    }
                  ]
                }
              },
              {
                "type": "r-textarea",
                "field": "description",
                "props": {
                  "label": "描述",
                  "colSpan": 24,
                  "rows": 3
                }
              }
            ]
          }
        ]
      }
    ]
  }
]