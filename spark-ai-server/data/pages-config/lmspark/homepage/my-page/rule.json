[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "数据权限管理"
        ]
      },
      {
        "type": "el-divider"
      },
      {
        "type": "r-section",
        "children": [
          {
            "type": "r-header",
            "children": [
              {
                "type": "RenderAddButton"
              },
              {
                "type": "RenderDeleteButton"
              },
              {
                "type": "RenderRefreshButton"
              }
            ]
          },
          {
            "type": "r-table",
            "children": [
              {
                "type": "r-text",
                "props": {
                  "label": "ID",
                  "width": 80,
                  "field": "id"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "权限名称",
                  "field": "name"
                }
              },
              {
                "type": "r-select",
                "props": {
                  "label": "权限类型",
                  "width": 120,
                  "options": [
                    {
                      "label": "用户权限",
                      "value": "user"
                    },
                    {
                      "label": "角色权限",
                      "value": "role"
                    },
                    {
                      "label": "部门权限",
                      "value": "dept"
                    }
                  ],
                  "field": "type"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "目标对象",
                  "width": 150,
                  "field": "target"
                }
              },
              {
                "type": "r-select",
                "props": {
                  "label": "状态",
                  "width": 100,
                  "options": [
                    {
                      "label": "启用",
                      "value": "active"
                    },
                    {
                      "label": "禁用",
                      "value": "inactive"
                    }
                  ],
                  "field": "status"
                }
              },
              {
                "type": "r-date",
                "props": {
                  "label": "创建时间",
                  "width": 150,
                  "field": "createdAt"
                }
              }
            ],
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "actions": {
                "type": "r-toolbar",
                "children": [
                  {
                    "type": "RenderActions"
                  }
                ]
              },
              "toolbar": {
                "type": "r-toolbar",
                "children": [
                  {
                    "type": "RenderSearchBar"
                  }
                ],
                "props": {
                  "position": "top"
                }
              },
              "viewKey": "Permissions@default"
            }
          }
        ],
        "props": {
          "title": "权限列表",
          "description": "管理用户或角色的数据访问权限"
        }
      },
      {
        "type": "r-drawer",
        "children": [
          {
            "type": "r-header",
            "children": [
              {
                "type": "RenderSaveButton"
              },
              {
                "type": "RenderCancelButton"
              }
            ]
          },
          {
            "type": "r-form",
            "children": [
              {
                "type": "r-text",
                "props": {
                  "label": "权限名称",
                  "colSpan": 24,
                  "required": true,
                  "field": "name"
                }
              },
              {
                "type": "r-select",
                "props": {
                  "label": "权限类型",
                  "colSpan": 12,
                  "required": true,
                  "options": [
                    {
                      "label": "用户权限",
                      "value": "user"
                    },
                    {
                      "label": "角色权限",
                      "value": "role"
                    },
                    {
                      "label": "部门权限",
                      "value": "dept"
                    }
                  ],
                  "field": "type"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "目标对象",
                  "colSpan": 12,
                  "field": "target"
                }
              },
              {
                "type": "r-select",
                "props": {
                  "label": "状态",
                  "colSpan": 12,
                  "options": [
                    {
                      "label": "启用",
                      "value": "active"
                    },
                    {
                      "label": "禁用",
                      "value": "inactive"
                    }
                  ],
                  "field": "status"
                }
              },
              {
                "type": "r-textarea",
                "props": {
                  "label": "描述",
                  "colSpan": 24,
                  "rows": 3,
                  "field": "description"
                }
              }
            ],
            "props": {
              "viewKey": "Permissions@default",
              "contextDataKey": "Permissions@default@currentRow"
            }
          }
        ],
        "props": {
          "title": "权限详情",
          "size": "40%"
        }
      }
    ],
    "props": {
      "class": "my-page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
