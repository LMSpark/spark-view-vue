[
  {
    "type": "r-tabs",
    "id": "r-tabs__main",
    "children": [
      {
        "type": "r-tab-pane",
        "children": [
          {
            "type": "r-form",
            "children": [
              {
                "type": "r-date",
                "props": {
                  "field": "voucherDate",
                  "label": "凭证日期",
                  "dateType": "date",
                  "valueFormat": "YYYY-MM-DD",
                  "gridColumn": "span 6"
                },
                "id": "field__date"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "voucherNo",
                  "label": "凭证编号",
                  "gridColumn": "span 6"
                },
                "id": "field__voucherNo"
              },
              {
                "type": "r-select",
                "props": {
                  "field": "status",
                  "label": "状态",
                  "options": [
                    {
                      "label": "草稿",
                      "value": "草稿"
                    },
                    {
                      "label": "已审核",
                      "value": "已审核"
                    },
                    {
                      "label": "已过账",
                      "value": "已过账"
                    }
                  ],
                  "optionLabelField": "label",
                  "optionValueField": "value",
                  "gridColumn": "span 6"
                },
                "id": "field__status"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "attachmentCount",
                  "label": "附件数",
                  "gridColumn": "span 6"
                },
                "id": "field__attachments"
              },
              {
                "type": "r-textarea",
                "props": {
                  "field": "summary",
                  "label": "摘要",
                  "autosize": {
                    "minRows": 2,
                    "maxRows": 4
                  },
                  "gridColumn": "span 24"
                },
                "id": "field__summary"
              }
            ],
            "props": {
              "labelWidth": "100px",
              "gridColumns": 24,
              "gridGap": "12px",
              "viewKey": "Vouchers@default",
              "contextDataKey": "Vouchers@default@currentRow"
            },
            "id": "form__voucher"
          },
          {
            "type": "r-table",
            "children": [
              {
                "type": "r-select",
                "props": {
                  "field": "accountCode",
                  "label": "会计科目",
                  "width": 180,
                  "optionKey": "Accounts@rows",
                  "optionLabelField": "accountName",
                  "optionValueField": "accountCode",
                  "filterable": true
                },
                "id": "col__accountCode"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "accountName",
                  "label": "科目名称",
                  "width": 180
                },
                "id": "col__accountName"
              },
              {
                "type": "r-select",
                "props": {
                  "field": "direction",
                  "label": "方向",
                  "width": 100,
                  "options": [
                    {
                      "label": "借",
                      "value": "借"
                    },
                    {
                      "label": "贷",
                      "value": "贷"
                    }
                  ],
                  "optionLabelField": "label",
                  "optionValueField": "value"
                },
                "id": "col__direction"
              },
              {
                "type": "r-number",
                "props": {
                  "field": "amount",
                  "label": "金额",
                  "width": 150
                },
                "id": "col__amount"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "summary",
                  "label": "分录摘要",
                  "width": 200
                },
                "id": "col__detailSummary"
              }
            ],
            "props": {
              "toolbar": {
                "type": "r-toolbar",
                "children": [
                  {
                    "type": "r-button",
                    "props": {
                      "label": "新增分录",
                      "template": "primary",
                      "action": "append-row"
                    },
                    "id": "btn__addDetail"
                  },
                  {
                    "type": "r-button",
                    "props": {
                      "label": "删除分录",
                      "template": "toolbar-danger",
                      "action": "delete-current"
                    },
                    "id": "btn__delDetail"
                  }
                ],
                "props": {},
                "id": "toolbar__details"
              },
              "actions": {
                "type": "r-toolbar",
                "children": [
                  {
                    "type": "r-button",
                    "props": {
                      "label": "删除",
                      "action": "delete-row"
                    },
                    "id": "btn__deleteDetailRow"
                  }
                ],
                "props": {},
                "id": "actions__details"
              },
              "viewKey": "VoucherItems@default"
            },
            "id": "table__details"
          }
        ],
        "props": {
          "label": "凭证录入",
          "name": "entry"
        },
        "id": "tab__entry"
      },
      {
        "type": "r-tab-pane",
        "children": [
          {
            "type": "r-table",
            "children": [
              {
                "type": "r-text",
                "props": {
                  "field": "voucherDate",
                  "label": "凭证日期",
                  "width": 120,
                  "sortable": true
                },
                "id": "col__voucherDate"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "voucherNo",
                  "label": "凭证编号",
                  "width": 120,
                  "sortable": true
                },
                "id": "col__voucherNo"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "summary",
                  "label": "摘要",
                  "width": 250
                },
                "id": "col__summary"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "status",
                  "label": "状态",
                  "width": 100
                },
                "id": "col__status"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "attachmentCount",
                  "label": "附件",
                  "width": 80
                },
                "id": "col__attachmentCount"
              },
              {
                "type": "r-text",
                "props": {
                  "field": "createdBy",
                  "label": "制单人",
                  "width": 100
                },
                "id": "col__createdBy"
              }
