                ],
                "props": {},
                "id": "toolbar__voucherList"
              },
              "filter": {
                "type": "r-filter",
                "children": [
                  {
                    "type": "r-date",
                    "props": {
                      "field": "voucherDate",
                      "label": "凭证日期",
                      "dateType": "daterange",
                      "valueFormat": "YYYY-MM-DD",
                      "startPlaceholder": "开始日期",
                      "endPlaceholder": "结束日期"
                    },
                    "id": "filter__dateRange"
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "voucherNo",
                      "label": "凭证编号"
                    },
                    "id": "filter__voucherNo"
                  },
                  {
                    "type": "r-select",
                    "props": {
                      "field": "status",
                      "label": "状态",
                      "options": [
                        {
                          "label": "草稿",
                          "value": "草稿"
                        },
                        {
                          "label": "已审核",
                          "value": "已审核"
                        },
                        {
                          "label": "已过账",
                          "value": "已过账"
                        }
                      ],
                      "optionLabelField": "label",
                      "optionValueField": "value"
                    },
                    "id": "filter__status"
                  }
                ],
                "props": {},
                "id": "filter__voucherList"
              },
              "actions": {
                "type": "r-toolbar",
                "children": [
                  {
                    "type": "r-button",
                    "props": {
                      "label": "查看",
                      "action": "message-row"
                    },
                    "id": "btn__viewVoucher"
                  },
                  {
                    "type": "r-button",
                    "props": {
                      "label": "删除",
                      "action": "delete-row"
                    },
                    "id": "btn__deleteVoucher"
