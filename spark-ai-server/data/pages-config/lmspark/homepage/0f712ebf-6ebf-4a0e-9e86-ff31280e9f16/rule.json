            "props": {
              "toolbar": {
                "type": "r-toolbar",
                "children": [
                  {
                    "type": "r-button",
                    "props": {
                      "label": "刷新",
                      "template": "primary",
                      "action": "refresh"
                    },
                    "id": "btn__refresh"
