[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "用户管理"
        ],
        "props": {
          "style": {
            "margin": "0",
            "padding": "20px 20px 16px 20px",
            "borderBottom": "1px solid #e4e7ed"
          }
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "r-table",
            "children": [
              {
                "type": "r-text",
                "props": {
                  "label": "ID",
                  "width": 80,
                  "field": "id"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "用户名",
                  "minWidth": 120,
                  "field": "name"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "姓名",
                  "minWidth": 120,
                  "field": "fullName"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "邮箱",
                  "minWidth": 180,
                  "field": "email"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "部门",
                  "minWidth": 120,
                  "field": "department"
                }
              },
              {
                "type": "r-number",
                "props": {
                  "label": "年龄",
                  "width": 100,
                  "field": "age"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "角色",
                  "minWidth": 120,
                  "field": "role"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "状态",
                  "minWidth": 100,
                  "field": "status"
                }
              }
            ],
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "height": "100%",
              "style": {
                "width": "100%"
              },
              "on": {
                "currentChange": "handleRowChange",
                "selectionChange": "handleSelection"
              },
              "dataViewKey": "users@default"
            }
          }
        ],
        "props": {
          "class": "content-section",
          "style": {
            "flex": "1",
            "display": "flex",
            "flexDirection": "column",
            "overflow": "hidden",
            "padding": "20px"
          }
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "height": "100vh",
        "display": "flex",
        "flexDirection": "column",
        "overflow": "hidden"
      }
    }
  }
]
