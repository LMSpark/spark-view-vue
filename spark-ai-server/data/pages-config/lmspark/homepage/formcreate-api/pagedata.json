{
  "dataSetName": "FormCardTestDS",
  "tables": {
    "profile": {
      "tableName": "profile",
      "columns": [
        {
          "name": "id",
          "type": "number",
          "isPrimaryKey": true
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "email",
          "type": "string"
        },
        {
          "name": "role",
          "type": "string"
        },
        {
          "name": "active",
          "type": "boolean"
        },
        {
          "name": "note",
          "type": "string"
        }
      ],
      "views": {
        "default": {
          "autoCurrentFirst": true,
          "autoSelectFirst": true,
          "rows": [
            {
              "id": 1,
              "name": "测试用户",
              "email": "demo@spark.local",
              "role": "admin",
              "active": true,
              "note": "用于验证 r-form 与 r-card 组合渲染",
              "_perm": {
                "editableFields": [
                  "name",
                  "active",
                  "note"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
