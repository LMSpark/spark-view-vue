[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "Form + 卡片测试页"
        ]
      },
      {
        "type": "p",
        "children": [
          "当前页面用于替代 formcreate-api，验证 r-form 与 r-card 基础能力。"
        ]
      },
      {
        "type": "r-row",
        "children": [
          {
            "type": "r-col",
            "children": [
              {
                "type": "r-card",
                "children": [
                  {
                    "type": "r-form",
                    "children": [
                      {
                        "type": "r-text",
                        "props": {
                          "field": "name",
                          "label": "姓名"
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "field": "email",
                          "label": "邮箱"
                        }
                      },
                      {
                        "type": "r-select",
                        "props": {
                          "field": "role",
                          "label": "角色",
                          "options": [
                            {
                              "label": "管理员",
                              "value": "admin"
                            },
                            {
                              "label": "编辑",
                              "value": "editor"
                            },
                            {
                              "label": "访客",
                              "value": "guest"
                            }
                          ]
                        }
                      },
                      {
                        "type": "r-switch",
                        "props": {
                          "field": "active",
                          "label": "启用"
                        }
                      },
                      {
                        "type": "r-textarea",
                        "props": {
                          "field": "note",
                          "label": "备注",
                          "rows": 3
                        }
                      }
                    ],
                    "props": {
                      "labelWidth": "100px",
                      "dataViewKey": "profile@default",
                      "contextDataMember": "currentRow"
                    }
                  }
                ],
                "props": {
                  "header": "表单测试"
                }
              }
            ],
            "props": {
              "span": 14,
              "xs": 24
            }
          },
          {
            "type": "r-col",
            "children": [
              {
                "type": "r-card",
                "children": [
                  {
                    "type": "r-detail",
                    "children": [
                      {
                        "type": "r-text",
                        "props": {
                          "field": "name",
                          "label": "姓名"
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "field": "email",
                          "label": "邮箱"
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "field": "role",
                          "label": "角色"
                        }
                      },
                      {
                        "type": "r-switch",
                        "props": {
                          "field": "active",
                          "label": "启用"
                        }
                      }
                    ],
                    "props": {
                      "dataViewKey": "profile@default",
                      "contextDataMember": "currentRow"
                    }
                  }
                ],
                "props": {
                  "header": "卡片测试"
                }
              }
            ],
            "props": {
              "span": 10,
              "xs": 24
            }
          }
        ],
        "props": {
          "gutter": 16
        }
      }
    ],
    "props": {
      "class": "form-card-test-page"
    }
  }
]
