[
  {
    "type": "div",
    "id": "div__0_0",
    "children": [
      {
        "type": "h2",
        "id": "h2__0_0_0",
        "children": [
          "请假单"
        ]
      },
      {
        "type": "p",
        "id": "p__0_0_1",
        "children": [
          "页面配置就绪，请编辑 rule.json 设计页面布局。"
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "leave-form-section",
    "props": {
      "cardShadow": "hover",
      "title": "请假申请",
      "useCard": true
    },
    "children": [
      {
        "type": "r-form",
        "id": "leave-form",
        "props": {
          "contextDataMember": "currentRow",
          "dataViewKey": "leave_requests@default",
          "gridColumns": 2,
          "gridGap": 16,
          "labelWidth": "100px"
        },
        "children": [
          {
            "type": "r-text",
            "id": "field-applicant-name",
            "props": {
              "field": "applicantName",
              "label": "申请人姓名",
              "placeholder": "请输入姓名"
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "field-leave-type",
            "props": {
              "field": "leaveType",
              "label": "请假类型",
              "optionDataViewKey": "leave_types@default",
              "optionLabelField": "label",
              "optionValueField": "value"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-start-date",
            "props": {
              "dateType": "date",
              "field": "startDate",
              "label": "开始日期",
              "valueFormat": "YYYY-MM-DD"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-end-date",
            "props": {
              "dateType": "date",
              "field": "endDate",
              "label": "结束日期",
              "valueFormat": "YYYY-MM-DD"
            },
            "children": []
          },
          {
            "type": "r-number",
            "id": "field-days",
            "props": {
              "field": "days",
              "label": "请假天数",
              "min": 0.5,
              "precision": 1
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "field-reason",
            "props": {
              "field": "reason",
              "label": "请假原因",
              "placeholder": "请输入请假原因",
              "rows": 3
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "btn-submit",
            "props": {
              "action": "submit-current-form",
              "dataViewKey": "leave_requests@default",
              "label": "提交申请",
              "template": "primary"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "leave-list-section",
    "props": {
      "cardShadow": "hover",
      "title": "请假记录",
      "useCard": true
    },
    "children": [
      {
        "type": "r-table",
        "id": "leave-table",
        "props": {
          "dataViewKey": "leave_requests@pending"
        },
        "children": []
      }
    ]
  }
]
