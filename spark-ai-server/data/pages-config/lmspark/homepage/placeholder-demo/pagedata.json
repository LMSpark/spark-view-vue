{
    "dataset": {
        "dataSetName": "PlaceholderDemoDS",
        "tables": {
            "employees": {
                "columns": [
                    {
                        "name": "id",
                        "type": "number",
                        "label": "ID",
                        "isPrimaryKey": true
                    },
                    {
                        "name": "name",
                        "type": "string",
                        "label": "姓名"
                    },
                    {
                        "name": "department",
                        "type": "string",
                        "label": "部门"
                    },
                    {
                        "name": "role",
                        "type": "string",
                        "label": "职位"
                    },
                    {
                        "name": "age",
                        "type": "number",
                        "label": "年龄"
                    },
                    {
                        "name": "status",
                        "type": "string",
                        "label": "状态"
                    },
                    {
                        "name": "email",
                        "type": "string",
                        "label": "邮箱"
                    },
                    {
                        "name": "ageBadgeType",
                        "type": "string",
                        "label": "年龄标记",
                        "isComputed": true,
                        "computeExpression": "age > 50 && status !== '休假' ? 'danger' : age > 50 ? 'warning' : 'info'"
                    },
                    {
                        "name": "ageRiskText",
                        "type": "string",
                        "label": "年龄提示",
                        "isComputed": true,
                        "computeExpression": "age > 50 ? (status === '出差' ? '高龄出差' : status === '在职' ? '高龄在岗' : '高龄关注') : department"
                    }
                ],
                "autoSelectFirst": true,
                "rows": [
