[
    {
        "type": "div",
        "style": {
            "height": "100vh",
            "display": "flex",
            "flexDirection": "column",
            "overflow": "hidden",
            "padding": "24px",
            "gap": "18px",
            "background": "linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%)"
        },
        "children": [
            {
                "type": "div",
                "style": {
                    "display": "flex",
                    "flexDirection": "column",
                    "gap": "8px",
                    "padding": "4px 0 0 0"
                },
                "children": [
                    {
                        "type": "div",
                        "style": {
                            "display": "inline-flex",
                            "alignItems": "center",
                            "width": "fit-content",
                            "padding": "4px 10px",
                            "borderRadius": "999px",
                            "background": "#e0e7ff",
                            "color": "#4338ca",
                            "fontSize": "12px",
                            "fontWeight": "600",
                            "letterSpacing": "0.04em"
                        },
                        "children": [
                            "PLACEHOLDER DEMO"
                        ]
                    },
                    {
                        "type": "h2",
                        "style": {
                            "margin": "0",
                            "fontSize": "36px",
                            "fontWeight": "700",
                            "color": "#1e293b",
                            "letterSpacing": "-0.03em"
                        },
                        "children": [
                            "$[fieldName] 占位符演示"
                        ]
                    },
                    {
                        "type": "div",
                        "style": {
                            "color": "#64748b",
                            "fontSize": "14px",
                            "lineHeight": "1.7"
                        },
                        "children": [
                            "通过表格列模板与详情面板，展示占位符在标签、统计值和混合文本中的联动效果。"
                        ]
                    }
                ]
            },
            {
                "type": "div",
                "style": {
                    "display": "flex",
                    "gap": "20px",
                    "flex": "1",
                    "overflow": "hidden"
                },
                "children": [
                    {
                        "type": "div",
                        "style": {
                            "flex": "1",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "14px",
                            "padding": "18px",
                            "background": "rgba(255, 255, 255, 0.86)",
                            "border": "1px solid rgba(148, 163, 184, 0.18)",
                            "borderRadius": "18px",
                            "boxShadow": "0 16px 40px rgba(15, 23, 42, 0.08)",
                            "backdropFilter": "blur(12px)",
                            "overflow": "hidden"
                        },
                        "children": [
                            {
                                "type": "div",
                                "style": {
                                    "display": "flex",
                                    "justifyContent": "space-between",
                                    "alignItems": "flex-end",
                                    "gap": "12px"
                                },
                                "children": [
                                    {
                                        "type": "div",
                                        "style": {
                                            "display": "flex",
                                            "flexDirection": "column",
                                            "gap": "4px"
                                        },
                                        "children": [
                                            {
                                                "type": "div",
                                                "style": {
                                                    "fontSize": "20px",
                                                    "fontWeight": "700",
                                                    "color": "#0f172a"
                                                },
                                                "children": [
                                                    "员工总览"
                                                ]
                                            },
                                            {
                                                "type": "div",
                                                "style": {
                                                    "fontSize": "13px",
                                                    "color": "#64748b"
                                                },
                                                "children": [
                                                    "左侧表格验证行级占位符，点击任意行查看右侧详情映射。"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "style": {
                                            "padding": "6px 10px",
                                            "borderRadius": "999px",
                                            "background": "#eff6ff",
                                            "color": "#1d4ed8",
                                            "fontSize": "12px",
                                            "fontWeight": "600"
                                        },
                                        "children": [
                                            "共 5 条示例数据"
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "div",
                                "style": {
                                    "flex": "1",
                                    "overflow": "hidden",
                                    "borderRadius": "16px",
                                    "border": "1px solid rgba(226, 232, 240, 0.95)",
                                    "background": "#ffffff",
                                    "boxShadow": "inset 0 1px 0 rgba(255, 255, 255, 0.7)"
                                },
                                "children": [
                                    {
                                        "type": "r-table",
                                        "dataKey": "employees@rows",
                                        "props": {
                                            "border": true,
                                            "stripe": true,
                                            "highlightCurrentRow": true,
                                            "size": "large"
                                        },
                                        "children": [
                                            {
                                                "type": "r-text",
                                                "field": "id",
                                                "props": {
                                                    "label": "ID",
                                                    "width": 72,
                                                    "align": "center",
                                                    "headerAlign": "center"
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "name",
                                                "props": {
                                                    "label": "姓名",
                                                    "width": 120
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "department",
                                                "props": {
                                                    "label": "部门",
                                                    "width": 110
                                                }
                                            },
                                            {
                                                "type": "r-text",
                                                "field": "role",
                                                "props": {
                                                    "label": "职位",
                                                    "minWidth": 150
                                                }
                                            },
                                            {
                                                "type": "r-row-fragment",
                                                "props": {
                                                    "label": "年龄画像",
                                                    "width": 220
                                                },
                                                "children": [
                                                    {
                                                        "type": "div",
                                                        "style": {
                                                            "display": "flex",
                                                            "alignItems": "center",
                                                            "gap": "8px",
                                                            "flexWrap": "nowrap",
                                                            "whiteSpace": "nowrap"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "r-tag",
                                                                "props": {
                                                                    "content": "$[age] 岁",
                                                                    "tagType": "$[ageBadgeType]",
                                                                    "size": "small"
                                                                }
                                                            },
                                                            {
                                                                "type": "r-tag",
                                                                "props": {
                                                                    "content": "$[ageRiskText]",
                                                                    "tagType": "info",
                                                                    "effect": "plain",
                                                                    "size": "small"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "r-tag",
                                                "props": {
                                                    "field": "status",
                                                    "label": "状态",
                                                    "width": 96,
                                                    "size": "small",
                                                    "dynamicType": {
                                                        "在职": "success",
                                                        "休假": "warning",
                                                        "出差": "info"
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "div",
                        "style": {
                            "width": "360px",
                            "display": "flex",
                            "flexDirection": "column",
                            "gap": "14px",
                            "border": "1px solid rgba(148, 163, 184, 0.18)",
                            "borderRadius": "18px",
                            "padding": "18px",
                            "background": "rgba(255, 255, 255, 0.9)",
                            "boxShadow": "0 16px 40px rgba(15, 23, 42, 0.08)",
                            "overflow": "auto"
                        },
                        "children": [
                            {
                                "type": "div",
                                "style": {
                                    "display": "flex",
                                    "flexDirection": "column",
                                    "gap": "4px"
                                },
                                "children": [
                                    {
                                        "type": "h3",
                                        "style": {
                                            "margin": "0",
                                            "fontSize": "28px",
                                            "fontWeight": "700",
                                            "color": "#0f172a"
                                        },
                                        "children": [
                                            "占位符绑定详情"
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "style": {
                                            "fontSize": "13px",
                                            "color": "#64748b",
                                            "lineHeight": "1.6"
                                        },
                                        "children": [
                                            "右侧面板展示当前选中员工在不同组件中的占位符映射结果。"
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "r-detail",
                                "dataKey": "employees@currentRow",
                                "children": [
                                    {
                                        "type": "r-text-display",
                                        "props": {
                                            "field": "name",
                                            "label": "纯占位符（保留类型）",
                                            "suffix": "$[role]"
                                        }
                                    },
                                    {
                                        "type": "r-text-display",
                                        "props": {
                                            "field": "email",
                                            "label": "混合文本前缀",
                                            "prefix": "$[name] 的邮箱: "
                                        }
                                    },
                                    {
                                        "type": "r-text-display",
                                        "props": {
                                            "field": "age",
                                            "label": "多占位符混合后缀",
                                            "suffix": " — $[department] / $[role]"
                                        }
                                    },
                                    {
                                        "type": "r-tag",
                                        "props": {
                                            "content": "年龄阈值：$[age] 岁",
                                            "tagType": "$[ageBadgeType]"
                                        }
                                    },
                                    {
                                        "type": "r-statistic",
                                        "props": {
                                            "field": "age",
                                            "title": "$[name] 的年龄（表格年龄列走 r-row-fragment 单元格模板）",
                                            "suffix": "岁"
                                        }
                                    },
                                    {
                                        "type": "r-tag",
                                        "props": {
                                            "content": "$[department] - $[role]",
                                            "tagType": "info"
                                        }
                                    },
                                    {
                                        "type": "r-tag",
                                        "props": {
                                            "content": "$[status]",
                                            "dynamicType": {
                                                "在职": "success",
                                                "休假": "warning",
                                                "出差": "info"
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]