[
  {
    "type": "r-space",
    "children": [
      {
        "type": "r-section",
        "children": [
          {
            "type": "r-tag",
            "props": {
              "content": "PLACEHOLDER DEMO",
              "tagType": "info",
              "effect": "plain",
              "size": "small"
            }
          }
        ],
        "props": {
          "title": "$[fieldName] 占位符演示",
          "description": "通过表格列模板与详情面板，展示占位符在标签、统计值和混合文本中的联动效果。",
          "useCard": true,
          "bordered": false,
          "class": "placeholder-hero",
          "style": {
            "padding": "4px 0 0 0"
          }
        }
      },
      {
        "type": "r-row",
        "children": [
          {
            "type": "r-col",
            "children": [
              {
                "type": "r-section",
                "children": [
                  {
                    "type": "r-tag",
                    "props": {
                      "content": "共 5 条示例数据",
                      "tagType": "info",
                      "effect": "plain",
                      "size": "small"
                    }
                  },
                  {
                    "type": "r-table",
                    "children": [
                      {
                        "type": "r-text",
                        "props": {
                          "label": "ID",
                          "width": 72,
                          "align": "center",
                          "headerAlign": "center",
                          "field": "id"
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "label": "姓名",
                          "width": 120,
                          "field": "name"
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "label": "部门",
                          "width": 110,
                          "field": "department"
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "label": "职位",
                          "minWidth": 150,
                          "field": "role"
                        }
                      },
                      {
                        "type": "r-row-fragment",
                        "children": [
                          {
                            "type": "r-space",
                            "children": [
                              {
                                "type": "r-tag",
                                "props": {
                                  "content": "$[age] 岁",
                                  "tagType": "$[ageBadgeType]",
                                  "size": "small"
                                }
                              },
                              {
                                "type": "r-tag",
                                "props": {
                                  "content": "$[ageRiskText]",
                                  "tagType": "info",
                                  "effect": "plain",
                                  "size": "small"
                                }
                              }
                            ],
                            "props": {
                              "direction": "horizontal",
                              "size": 8
                            }
                          }
                        ],
                        "props": {
                          "label": "年龄画像",
                          "width": 220
                        }
                      },
                      {
                        "type": "r-tag",
                        "props": {
                          "field": "status",
                          "label": "状态",
                          "width": 96,
                          "size": "small",
                          "dynamicType": {
                            "在职": "success",
                            "休假": "warning",
                            "出差": "info"
                          }
                        }
                      }
                    ],
                    "props": {
                      "border": true,
                      "stripe": true,
                      "highlightCurrentRow": true,
                      "size": "large",
                      "dataKey": "employees@rows"
                    }
                  }
                ],
                "props": {
                  "title": "员工总览",
                  "description": "左侧表格验证行级占位符，点击任意行查看右侧详情映射。",
                  "useCard": true,
                  "bordered": false,
                  "class": "placeholder-panel placeholder-panel--table",
                  "style": {
                    "height": "100%"
                  }
                }
              }
            ],
            "props": {
              "span": 16,
              "style": {
                "height": "100%"
              }
            }
          },
          {
            "type": "r-col",
            "children": [
              {
                "type": "r-section",
                "children": [
                  {
                    "type": "r-detail",
                    "children": [
                      {
                        "type": "r-text-display",
                        "props": {
                          "field": "name",
                          "label": "纯占位符（保留类型）",
                          "suffix": "$[role]"
                        }
                      },
                      {
                        "type": "r-text-display",
                        "props": {
                          "field": "email",
                          "label": "混合文本前缀",
                          "prefix": "$[name] 的邮箱: "
                        }
                      },
                      {
                        "type": "r-text-display",
                        "props": {
                          "field": "age",
                          "label": "多占位符混合后缀",
                          "suffix": " — $[department] / $[role]"
                        }
                      },
                      {
                        "type": "r-tag",
                        "props": {
                          "content": "年龄阈值：$[age] 岁",
                          "tagType": "$[ageBadgeType]"
                        }
                      },
                      {
                        "type": "r-statistic",
                        "props": {
                          "field": "age",
                          "title": "$[name] 的年龄（表格年龄列走 r-row-fragment 单元格模板）",
                          "suffix": "岁"
                        }
                      },
                      {
                        "type": "r-tag",
                        "props": {
                          "content": "$[department] - $[role]",
                          "tagType": "info"
                        }
                      },
                      {
                        "type": "r-tag",
                        "props": {
                          "content": "$[status]",
                          "dynamicType": {
                            "在职": "success",
                            "休假": "warning",
                            "出差": "info"
                          }
                        }
                      }
                    ],
                    "props": {
                      "dataKey": "employees@currentRow"
                    }
                  }
                ],
                "props": {
                  "title": "占位符绑定详情",
                  "description": "右侧面板展示当前选中员工在不同组件中的占位符映射结果。",
                  "useCard": true,
                  "bordered": false,
                  "class": "placeholder-panel placeholder-panel--detail",
                  "style": {
                    "height": "100%",
                    "overflow": "auto"
                  }
                }
              }
            ],
            "props": {
              "span": 8,
              "style": {
                "height": "100%"
              }
            }
          }
        ],
        "props": {
          "gutter": 20,
          "style": {
            "display": "flex",
            "gap": "20px",
            "flex": "1",
            "overflow": "hidden"
          }
        }
      }
    ],
    "props": {
      "direction": "vertical",
      "size": 18,
      "class": "placeholder-demo-page",
      "style": {
        "height": "100vh",
        "display": "flex",
        "flexDirection": "column",
        "overflow": "hidden",
        "padding": "24px",
        "gap": "18px",
        "background": "linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%)"
      }
    }
  }
]
