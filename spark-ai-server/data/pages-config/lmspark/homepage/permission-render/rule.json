                },
                "children": [
                  "▼ 后端下发的权限快照"
                ]
              },
              {
                "type": "RenderPermSnapshot"
              }
            ]
          },
          {
            "type": "div",
            "style": {
              "flex": "1",
              "minWidth": "0"
