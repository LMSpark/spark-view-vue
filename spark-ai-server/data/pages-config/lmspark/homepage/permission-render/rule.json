      "maxWidth": "1100px"
    },
    "children": [
      {
        "type": "el-alert",
        "props": {
          "title": "改权限不改代码 —— 业务返回 _perm 快照，前端零代码消费结果",
          "type": "success",
          "closable": false,
          "description": "切换角色 = 模拟业务脚本收到不同返回值。左侧实时展示写入 DataSet 的权限结果，右侧由 r-table / r-form 内置权限链零代码消费这些结果。"
        },
        "style": {
          "marginBottom": "16px"
        }
      },
      {
        "type": "el-card",
        "props": {
          "bodyStyle": "padding:16px 20px;"
        },
        "style": {
          "marginBottom": "16px"
        },
        "children": [
          {
            "type": "div",
            "style": {
              "display": "flex",
              "alignItems": "center",
              "gap": "12px",
              "flexWrap": "wrap"
            },
            "children": [
              {
                "type": "span",
                "style": {
                  "fontWeight": "600",
                  "color": "#303133",
                  "fontSize": "14px",
                  "whiteSpace": "nowrap"
                },
                "children": [
