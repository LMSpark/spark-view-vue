[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "项目管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "管理项目的基本信息、任务和成员。",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "el-button",
            "children": [
              "新增项目"
            ],
            "props": {
              "type": "primary",
              "on": {
                "click": "handleAddProject"
              },
              "size": "small"
            }
          },
          {
            "type": "el-button",
            "children": [
              "删除项目"
            ],
            "props": {
              "type": "danger",
              "key": "deleteBtn",
              "on": {
                "click": "handleDeleteProject"
              },
              "size": "small",
              "disabled": true
            }
          },
          {
            "type": "el-input",
            "props": {
              "placeholder": "搜索项目名称",
              "clearable": true,
              "style": {
                "width": "200px"
              }
            }
          },
          {
            "type": "el-button",
            "children": [
              "搜索"
            ],
            "props": {
              "type": "default",
              "on": {
                "click": "handleSearch"
              },
              "size": "small"
            }
          }
        ],
        "props": {
          "class": "toolbar",
          "style": {
            "marginBottom": "16px",
            "display": "flex",
            "gap": "8px",
            "alignItems": "center",
            "flexWrap": "wrap"
          }
        }
      },
      {
        "type": "el-table",
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "type": "selection",
              "width": "55",
              "reserveSelection": true
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "id",
              "label": "ID",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "项目名称",
              "width": "150"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "description",
              "label": "描述"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "status",
              "label": "状态",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "startDate",
              "label": "开始日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "endDate",
              "label": "结束日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "budget",
              "label": "预算（万元）",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "progress",
              "label": "进度（%）",
              "width": "100"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "rowKey": "id",
          "dataKey": "Projects@rows",
          "on": {
            "currentChange": "handleCurrentChange",
            "selectionChange": "handleSelectionChange"
          }
        }
      },
      {
        "type": "el-divider",
        "children": [
          "项目详情"
        ],
        "props": {
          "contentPosition": "left"
        }
      },
      {
        "type": "r-detail",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "项目名称",
              "field": "name"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "描述",
              "field": "description"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "状态",
              "field": "status"
            }
          },
          {
            "type": "r-date",
            "props": {
              "label": "开始日期",
              "field": "startDate"
            }
          },
          {
            "type": "r-date",
            "props": {
              "label": "结束日期",
              "field": "endDate"
            }
          },
          {
            "type": "r-number",
            "props": {
              "label": "预算（万元）",
              "min": 0,
              "field": "budget"
            }
          },
          {
            "type": "r-number",
            "props": {
              "label": "进度（%）",
              "min": 0,
              "max": 100,
              "field": "progress"
            }
          }
        ],
        "props": {
          "dataKey": "Projects@currentRow",
          "style": {
            "marginTop": "16px"
          }
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
