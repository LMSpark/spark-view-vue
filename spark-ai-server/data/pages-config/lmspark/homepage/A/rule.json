[
  {
    "type": "div",
    "class": "page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": [
          "项目管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "title": "管理项目的基本信息、任务和成员。",
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "style": {
          "marginBottom": "16px"
        }
      },
      {
        "type": "div",
        "class": "toolbar",
        "style": {
          "marginBottom": "16px",
          "display": "flex",
          "gap": "8px",
          "alignItems": "center",
          "flexWrap": "wrap"
        },
        "children": [
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "size": "small"
            },
            "on": {
              "click": "handleAddProject"
            },
            "children": [
              "新增项目"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "danger",
              "size": "small",
              "disabled": true
            },
            "key": "deleteBtn",
            "on": {
              "click": "handleDeleteProject"
            },
            "children": [
              "删除项目"
            ]
          },
          {
            "type": "el-input",
            "props": {
              "placeholder": "搜索项目名称",
              "clearable": true
            },
            "style": {
              "width": "200px"
            },
            "field": "searchInput",
            "value": ""
          },
          {
            "type": "el-button",
            "props": {
              "type": "default",
              "size": "small"
            },
            "on": {
              "click": "handleSearch"
            },
            "children": [
              "搜索"
            ]
          }
        ]
      },
      {
        "type": "el-table",
        "dataKey": "Projects@rows",
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "rowKey": "id"
        },
        "on": {
          "currentChange": "handleCurrentChange",
          "selectionChange": "handleSelectionChange"
        },
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "type": "selection",
              "width": "55",
              "reserveSelection": true
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "id",
              "label": "ID",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "项目名称",
              "width": "150"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "description",
              "label": "描述"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "status",
              "label": "状态",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "startDate",
              "label": "开始日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "endDate",
              "label": "结束日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "budget",
              "label": "预算（万元）",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "progress",
              "label": "进度（%）",
              "width": "100"
            }
          }
        ]
      },
      {
        "type": "el-divider",
        "props": {
          "contentPosition": "left"
        },
        "children": [
          "项目详情"
        ]
      },
      {
        "type": "r-detail",
        "dataKey": "Projects@currentRow",
        "style": {
          "marginTop": "16px"
        },
        "children": [
          {
            "type": "r-text",
            "field": "name",
            "props": {
              "label": "项目名称"
            }
          },
          {
            "type": "r-text",
            "field": "description",
            "props": {
              "label": "描述"
            }
          },
          {
            "type": "r-text",
            "field": "status",
            "props": {
              "label": "状态"
            }
          },
          {
            "type": "r-date",
            "field": "startDate",
            "props": {
              "label": "开始日期"
            }
          },
          {
            "type": "r-date",
            "field": "endDate",
            "props": {
              "label": "结束日期"
            }
          },
          {
            "type": "r-number",
            "field": "budget",
            "props": {
              "label": "预算（万元）",
              "min": 0
            }
          },
          {
            "type": "r-number",
            "field": "progress",
            "props": {
              "label": "进度（%）",
              "min": 0,
              "max": 100
            }
          }
        ]
      }
    ]
  }
]
