[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "项目管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "管理项目的基本信息、状态和负责人。",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "el-button",
            "children": [
              "新增项目"
            ],
            "props": {
              "type": "primary",
              "on": {
                "click": "handleAdd"
              },
              "size": "small"
            }
          },
          {
            "type": "el-button",
            "children": [
              "删除项目"
            ],
            "props": {
              "type": "danger",
              "on": {
                "click": "handleDelete"
              },
              "size": "small",
              "disabled": true
            }
          }
        ],
        "props": {
          "style": {
            "marginBottom": "16px",
            "display": "flex",
            "gap": "8px"
          }
        }
      },
      {
        "type": "el-table",
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "type": "selection",
              "width": "55"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "type": "index",
              "label": "序号",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "项目名称",
              "width": "200"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "status",
              "label": "状态",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "manager",
              "label": "负责人",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "startDate",
              "label": "开始日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "endDate",
              "label": "结束日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "description",
              "label": "描述"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "dataKey": "Projects@default@rows",
          "on": {
            "currentChange": "handleCurrentChange",
            "selectionChange": "handleSelectionChange"
          }
        }
      },
      {
        "type": "el-divider",
        "children": [
          "项目详情"
        ],
        "props": {
          "contentPosition": "left"
        }
      },
      {
        "type": "r-detail",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "项目名称",
              "field": "name"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "状态",
              "field": "status"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "负责人",
              "field": "manager"
            }
          },
          {
            "type": "r-date",
            "props": {
              "label": "开始日期",
              "field": "startDate"
            }
          },
          {
            "type": "r-date",
            "props": {
              "label": "结束日期",
              "field": "endDate"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "描述",
              "field": "description"
            }
          }
        ],
        "props": {
          "labelWidth": "100px",
          "viewKey": "Projects@default",
          "contextDataKey": "Projects@default@currentRow"
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
