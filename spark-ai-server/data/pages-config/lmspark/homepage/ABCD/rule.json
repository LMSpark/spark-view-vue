[
  {
    "type": "div",
    "class": "page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": [
          "项目管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "title": "管理项目的基本信息、状态和负责人。",
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "style": {
          "marginBottom": "16px"
        }
      },
      {
        "type": "div",
        "style": {
          "marginBottom": "16px",
          "display": "flex",
          "gap": "8px"
        },
        "children": [
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "size": "small"
            },
            "on": {
              "click": "handleAdd"
            },
            "children": [
              "新增项目"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "danger",
              "size": "small",
              "disabled": true
            },
            "on": {
              "click": "handleDelete"
            },
            "children": [
              "删除项目"
            ]
          }
        ]
      },
      {
        "type": "el-table",
        "dataKey": "Projects@rows",
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true
        },
        "on": {
          "currentChange": "handleCurrentChange",
          "selectionChange": "handleSelectionChange"
        },
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "type": "selection",
              "width": "55"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "type": "index",
              "label": "序号",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "项目名称",
              "width": "200"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "status",
              "label": "状态",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "manager",
              "label": "负责人",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "startDate",
              "label": "开始日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "endDate",
              "label": "结束日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "description",
              "label": "描述"
            }
          }
        ]
      },
      {
        "type": "el-divider",
        "props": {
          "contentPosition": "left"
        },
        "children": [
          "项目详情"
        ]
      },
      {
        "type": "r-detail",
        "dataKey": "Projects@currentRow",
        "props": {
          "labelWidth": "100px"
        },
        "children": [
          {
            "type": "r-text",
            "field": "name",
            "props": {
              "label": "项目名称"
            }
          },
          {
            "type": "r-text",
            "field": "status",
            "props": {
              "label": "状态"
            }
          },
          {
            "type": "r-text",
            "field": "manager",
            "props": {
              "label": "负责人"
            }
          },
          {
            "type": "r-date",
            "field": "startDate",
            "props": {
              "label": "开始日期"
            }
          },
          {
            "type": "r-date",
            "field": "endDate",
            "props": {
              "label": "结束日期"
            }
          },
          {
            "type": "r-text",
            "field": "description",
            "props": {
              "label": "描述"
            }
          }
        ]
      }
    ]
  }
]
