[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "页面 123"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "这是一个示例页面，已增加性别字段和邮箱列。",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "el-button",
            "children": [
              "新增"
            ],
            "props": {
              "type": "primary",
              "on": {
                "click": "handleAdd"
              },
              "size": "small"
            }
          },
          {
            "type": "el-button",
            "children": [
              "刷新"
            ],
            "props": {
              "type": "default",
              "on": {
                "click": "handleRefresh"
              },
              "size": "small"
            }
          }
        ],
        "props": {
          "style": {
            "marginBottom": "10px",
            "display": "flex",
            "gap": "8px"
          }
        }
      },
      {
        "type": "el-table",
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "prop": "id",
              "label": "ID",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "姓名"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "gender",
              "label": "性别"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "age",
              "label": "年龄"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "email",
              "label": "邮箱",
              "width": "200"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "dataKey": "Users@rows"
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
