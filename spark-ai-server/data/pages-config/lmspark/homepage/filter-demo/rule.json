[
  {
    "type": "div",
    "style": "padding: 20px;",
    "children": [
      {
        "type": "h2",
        "style": "margin-bottom: 16px;",
        "children": [
          "过滤面板演示 · Dock 版"
        ]
      },
      {
        "type": "p",
        "style": "color: #909399; margin-bottom: 20px;",
        "children": [
          "Dock 版规则：过滤项统一通过 dock=filter 子节点声明，支持文本、数字、下拉、多选、日期等字段类型。"
        ]
      },
      {
        "type": "r-table",
        "dataKey": "Employees@rows",
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "filterCollapsible": true
        },
        "children": [
          {
            "type": "r-text",
            "field": "name",
            "props": {
              "label": "姓名",
              "width": 100
            }
          },
          {
            "type": "r-select",
            "field": "department",
            "props": {
              "label": "部门",
              "width": 120,
              "options": [
                {
                  "label": "技术部",
                  "value": "技术部"
                },
                {
                  "label": "产品部",
                  "value": "产品部"
                },
                {
                  "label": "设计部",
                  "value": "设计部"
                },
                {
                  "label": "市场部",
                  "value": "市场部"
                }
              ]
            }
          },
          {
            "type": "r-text",
            "field": "position",
            "props": {
              "label": "职位",
              "width": 130
            }
          },
          {
            "type": "r-number",
            "field": "salary",
            "props": {
              "label": "薪资",
              "width": 100,
              "filterMode": "range"
            }
          },
          {
            "type": "r-multi-select",
            "field": "status",
            "props": {
              "label": "状态",
              "width": 100,
              "options": [
                {
                  "label": "在职",
                  "value": "在职"
                },
                {
                  "label": "离职",
                  "value": "离职"
                }
              ]
            }
          },
          {
            "type": "r-date",
            "field": "hireDate",
            "props": {
              "label": "入职日期",
              "width": 130
            }
          },
          {
            "type": "r-filter",
            "children": [
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "姓名"
                }
              },
              {
                "type": "r-select",
                "field": "department",
                "props": {
                  "label": "部门",
                  "options": [
                    {
                      "label": "技术部",
                      "value": "技术部"
                    },
                    {
                      "label": "产品部",
                      "value": "产品部"
                    },
                    {
                      "label": "设计部",
                      "value": "设计部"
                    },
                    {
                      "label": "市场部",
                      "value": "市场部"
                    }
                  ]
                }
              },
              {
                "type": "r-multi-select",
                "field": "status",
                "props": {
                  "label": "状态",
                  "options": [
                    {
                      "label": "在职",
                      "value": "在职"
                    },
                    {
                      "label": "离职",
                      "value": "离职"
                    }
                  ]
                }
              },
              {
                "type": "r-number",
                "field": "salary",
                "props": {
                  "label": "薪资",
                  "filterMode": "range"
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
