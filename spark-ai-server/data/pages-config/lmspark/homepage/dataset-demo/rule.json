[
  {
    "type": "div",
    "class": "dataset-demo",
    "children": [
      {
        "type": "h1",
        "children": [
          "DataSet 主从表演示"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "children": [
          "0 代码主从联动：点击用户行过滤订单，再点击订单行过滤订单明细。"
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "h2",
            "children": [
              "用户列表（父表 - 自动加载）"
            ]
          },
          {
            "type": "r-table",
            "dataKey": "Users@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "用户ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "姓名",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "field": "email",
                "props": {
                  "label": "邮箱"
                }
              },
              {
                "type": "r-text",
                "field": "status",
                "props": {
                  "label": "状态",
                  "width": 100
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "div",
            "class": "section-header",
            "children": [
              {
                "type": "h2",
                "children": [
                  "订单列表（子表 - 根据选中用户过滤）"
                ]
              }
            ]
          },
          {
            "type": "r-table",
            "dataKey": "Orders@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "orderNo",
                "props": {
                  "label": "订单号",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "field": "amount",
                "props": {
                  "label": "金额",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "field": "status",
                "props": {
                  "label": "状态",
                  "width": 120
                }
              },
              {
                "type": "r-text",
                "field": "date",
                "props": {
                  "label": "日期"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "div",
            "class": "section-header",
            "children": [
              {
                "type": "h2",
                "children": [
                  "订单明细（孙表 - 根据当前订单过滤）"
                ]
              }
            ]
          },
          {
            "type": "r-table",
            "dataKey": "OrderItems@rows",
            "props": {
              "border": true,
              "stripe": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "orderId",
                "props": {
                  "label": "订单ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "productName",
                "props": {
                  "label": "商品名称"
                }
              },
              {
                "type": "r-text",
                "field": "quantity",
                "props": {
                  "label": "数量",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "price",
                "props": {
                  "label": "单价",
                  "width": 100
                }
              }
            ]
          }
        ]
      }
    ]
  }
]