{
  "dataset": {
    "dataSetName": "OrderSystemDemo",
    "tables": {
      "Orders": {
        "columns": [
          { "name": "id", "type": "number", "label": "ID", "isPrimaryKey": true },
          { "name": "orderNo", "type": "string", "label": "订单号" },
          { "name": "orderDate", "type": "date", "label": "下单日期" },
          { "name": "status", "type": "string", "label": "状态" },
          { "name": "totalAmount", "type": "number", "label": "总金额" },
          { "name": "customerName", "type": "string", "label": "客户名称" },
          { "name": "contactPhone", "type": "string", "label": "联系电话" },
          { "name": "remark", "type": "string", "label": "备注" }
        ],
        "views": {
          "default": {
            "rows": [
              { "id": 1, "orderNo": "ORD20240001", "orderDate": "2024-03-15", "status": "pending", "totalAmount": 1580.50, "customerName": "张三", "contactPhone": "13800138001", "remark": "加急订单" },
              { "id": 2, "orderNo": "ORD20240002", "orderDate": "2024-03-16", "status": "processing", "totalAmount": 2450.00, "customerName": "李四", "contactPhone": "13800138002", "remark": "" },
              { "id": 3, "orderNo": "ORD20240003", "orderDate": "2024-03-17", "status": "completed", "totalAmount": 890.75, "customerName": "王五", "contactPhone": "13800138003", "remark": "需要发票" },
              { "id": 4, "orderNo": "ORD20240004", "orderDate": "2024-03-18", "status": "pending", "totalAmount": 3200.00, "customerName": "赵六", "contactPhone": "13800138004", "remark": "" },
              { "id": 5, "orderNo": "ORD20240005", "orderDate": "2024-03-19", "status": "processing", "totalAmount": 1750.30, "customerName": "钱七", "contactPhone": "13800138005", "remark": "分批发货" }
            ],
            "autoCurrentFirst": true,
            "aggregates": [
              { "field": "totalAmount", "type": "sum", "label": "订单总金额" },
              { "field": "totalAmount", "type": "avg", "label": "平均订单金额" },
              { "type": "count", "label": "订单总数" }
            ]
          }
        }
      },
      "OrderItems": {
        "columns": [
          { "name": "id", "type": "number", "label": "ID", "isPrimaryKey": true },
          { "name": "orderId", "type": "number", "label": "订单ID" },
          { "name": "productName", "type": "string", "label": "商品名称" },
          { "name": "quantity", "type": "number", "label": "数量" },
          { "name": "unitPrice", "type": "number", "label": "单价" },
          { "name": "subtotal", "type": "number", "label": "小计", "computeExpression": "quantity * unitPrice" }
        ],
        "views": {
          "default": {
            "rows": [
              { "id": 1, "orderId": 1, "productName": "笔记本电脑", "quantity": 1, "unitPrice": 5200.00 },
              { "id": 2, "orderId": 1, "productName": "无线鼠标", "quantity": 2, "unitPrice": 89.50 },
              { "id": 3, "orderId": 2, "productName": "智能手机", "quantity": 1, "unitPrice": 2999.00 },
              { "id": 4, "orderId": 2, "productName": "手机壳", "quantity": 1, "unitPrice": 45.00 },
              { "id": 5, "orderId": 3, "productName": "书籍《SPARK指南》", "quantity": 3, "unitPrice": 68.25 },
              { "id": 6, "orderId": 4, "productName": "平板电脑", "quantity": 2, "unitPrice": 1500.00 },
              { "id": 7, "orderId": 5, "productName": "蓝牙耳机", "quantity": 1, "unitPrice": 399.00 },
              { "id": 8, "orderId": 5, "productName": "充电宝", "quantity": 2, "unitPrice": 129.00 }
            ],
            "aggregates": [
              { "field": "quantity", "type": "sum", "label": "商品总数量" }
            ]
          }
        }
      },
      "OrderStatusOptions": {
        "columns": [
          { "name": "value", "type": "string", "label": "值" },
          { "name": "label", "type": "string", "label": "标签" }
        ],
        "views": {
          "default": {
            "rows": [
              { "value": "pending", "label": "待处理" },
              { "value": "processing", "label": "处理中" },
              { "value": "completed", "label": "已完成" },
              { "value": "cancelled", "label": "已取消" }
            ]
          }
        }
      }
    },
    "tableRelations": [
      { "parentTable": "Orders", "childTable": "OrderItems", "parentField": "id", "childField": "orderId", "relationName": "订单-明细" }
    ]
  }
}