[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "学生成绩管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "管理学生成绩信息，支持查看、编辑、删除和查询。",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "el-button",
            "children": [
              "新增成绩"
            ],
            "props": {
              "type": "primary",
              "on": {
                "click": "handleAdd"
              },
              "size": "small"
            }
          },
          {
            "type": "el-button",
            "children": [
              "删除选中"
            ],
            "props": {
              "type": "danger",
              "on": {
                "click": "handleDeleteSelected"
              },
              "size": "small",
              "disabled": true
            }
          },
          {
            "type": "el-input",
            "props": {
              "placeholder": "输入学生姓名或学号查询",
              "clearable": true,
              "style": {
                "width": "200px"
              }
            }
          },
          {
            "type": "el-button",
            "children": [
              "查询"
            ],
            "props": {
              "type": "default",
              "on": {
                "click": "handleSearch"
              },
              "size": "small"
            }
          }
        ],
        "props": {
          "class": "toolbar",
          "style": {
            "marginBottom": "16px",
            "display": "flex",
            "gap": "8px",
            "alignItems": "center"
          }
        }
      },
      {
        "type": "el-table",
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "type": "selection",
              "width": "55"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "type": "index",
              "label": "序号",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "studentId",
              "label": "学号",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "studentName",
              "label": "姓名",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "course",
              "label": "课程",
              "width": "150"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "score",
              "label": "成绩",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "grade",
              "label": "等级",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "examDate",
              "label": "考试日期",
              "width": "150"
            }
          },
          {
            "type": "el-table-column",
            "children": [
              {
                "type": "RenderActions"
              }
            ],
            "props": {
              "label": "操作",
              "width": "180",
              "fixed": "right"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "on": {
            "currentChange": "handleCurrentChange",
            "selectionChange": "handleSelectionChange"
          },
          "dataViewKey": "Scores@default",
          "dataMember": "rows"
        }
      },
      {
        "type": "el-pagination",
        "props": {
          "layout": "total, sizes, prev, pager, next, jumper",
          "total": 0,
          "pageSize": 10,
          "style": {
            "marginTop": "16px",
            "justifyContent": "flex-end",
            "display": "flex"
          },
          "on": {
            "currentChange": "handlePageChange",
            "sizeChange": "handleSizeChange"
          }
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
