[
  {
    "type": "r-section",
    "id": "stats-section",
    "props": {
      "title": "统计概览",
      "gridColumns": 4,
      "gridGap": 16
    },
    "children": [
      {
        "type": "r-card",
        "id": "card-pending-count",
        "props": {
          "header": "待审批",
          "shadow": "hover"
        },
        "children": [
          {
            "type": "r-text",
            "id": "pending-count-text",
            "props": {
              "dataViewKey": "LeaveRequest@pending",
              "dataMember": "aggregateResult",
              "dataField": "pendingCount",
              "label": ""
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "application-section",
    "props": {
      "title": "请假申请",
      "useCard": true
    },
    "children": [
      {
        "type": "r-form",
        "id": "leave-application-form",
        "props": {
          "dataViewKey": "LeaveRequest@default",
          "contextDataMember": "currentRow",
          "gridColumns": 2,
          "gridGap": 16,
          "labelWidth": "100px"
        },
        "children": [
          {
            "type": "r-text",
            "id": "field-applicant",
            "props": {
              "field": "applicantName",
              "label": "申请人",
              "placeholder": "请输入申请人"
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "field-leave-type",
            "props": {
              "field": "leaveType",
              "label": "请假类型",
              "placeholder": "请选择请假类型",
              "optionDataViewKey": "LeaveType@default",
              "optionDataMember": "rows",
              "optionLabelField": "label",
              "optionValueField": "value"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-start-date",
            "props": {
              "field": "startDate",
              "label": "开始日期",
              "placeholder": "请选择开始日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-end-date",
            "props": {
              "field": "endDate",
              "label": "结束日期",
              "placeholder": "请选择结束日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD"
            },
            "children": []
          },
          {
            "type": "r-number",
            "id": "field-days",
            "props": {
              "field": "days",
              "label": "请假天数",
              "placeholder": "请输入天数",
              "min": 0.5,
              "precision": 1
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "field-reason",
            "props": {
              "field": "reason",
              "label": "请假事由",
              "placeholder": "请输入请假事由",
              "rows": 4,
              "maxlength": 500,
              "showWordLimit": true
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "btn-submit",
            "props": {
              "action": "submit-current-form",
              "label": "提交申请",
              "buttonType": "primary"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "pending-section",
    "props": {
      "title": "待审批列表",
      "useCard": true
    },
    "children": [
      {
        "type": "r-table",
        "id": "pending-leave-table",
        "props": {
          "dataViewKey": "LeaveRequest@pending",
          "rowKey": "id",
          "autoColumns": true,
          "stripe": true,
          "border": true,
          "showPagination": true
        },
        "children": []
      }
    ]
  }
]
