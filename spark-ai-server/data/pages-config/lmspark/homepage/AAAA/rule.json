[
  {
    "type": "div",
    "class": "page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": [
          "用户管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "title": "这是一个用户管理页面，展示用户列表和详情",
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "style": {
          "marginBottom": "16px"
        }
      },
      {
        "type": "div",
        "style": {
          "display": "flex",
          "gap": "16px",
          "alignItems": "flex-start"
        },
        "children": [
          {
            "type": "div",
            "style": {
              "width": "300px",
              "flexShrink": "0"
            },
            "children": [
              {
                "type": "h3",
                "children": [
                  "用户列表"
                ]
              },
              {
                "type": "el-table",
                "dataKey": "Users@rows",
                "props": {
                  "border": true,
                  "stripe": true,
                  "highlightCurrentRow": true
                },
                "children": [
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "id",
                      "label": "ID",
                      "width": "80"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "name",
                      "label": "姓名"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "email",
                      "label": "邮箱"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "div",
            "style": {
              "flex": "1",
              "minWidth": "0"
            },
            "children": [
              {
                "type": "h3",
                "children": [
                  "用户详情"
                ]
              },
              {
                "type": "r-detail",
                "dataKey": "Users@currentRow",
                "props": {
                  "labelWidth": "100px"
                },
                "children": [
                  {
                    "type": "r-text",
                    "field": "name",
                    "props": {
                      "label": "姓名"
                    }
                  },
                  {
                    "type": "r-text",
                    "field": "email",
                    "props": {
                      "label": "邮箱"
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "age",
                    "props": {
                      "label": "年龄",
                      "min": 0,
                      "max": 150
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
