[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "用户管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "这是一个用户管理页面，展示用户列表和详情",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "div",
            "children": [
              {
                "type": "h3",
                "children": [
                  "用户列表"
                ]
              },
              {
                "type": "el-table",
                "children": [
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "id",
                      "label": "ID",
                      "width": "80"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "name",
                      "label": "姓名"
                    }
                  },
                  {
                    "type": "el-table-column",
                    "props": {
                      "prop": "email",
                      "label": "邮箱"
                    }
                  }
                ],
                "props": {
                  "border": true,
                  "stripe": true,
                  "highlightCurrentRow": true,
                  "dataKey": "Users@rows"
                }
              }
            ],
            "props": {
              "style": {
                "width": "300px",
                "flexShrink": "0"
              }
            }
          },
          {
            "type": "div",
            "children": [
              {
                "type": "h3",
                "children": [
                  "用户详情"
                ]
              },
              {
                "type": "r-detail",
                "children": [
                  {
                    "type": "r-text",
                    "props": {
                      "label": "姓名",
                      "field": "name"
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "label": "邮箱",
                      "field": "email"
                    }
                  },
                  {
                    "type": "r-number",
                    "props": {
                      "label": "年龄",
                      "min": 0,
                      "max": 150,
                      "field": "age"
                    }
                  }
                ],
                "props": {
                  "labelWidth": "100px",
                  "dataKey": "Users@currentRow"
                }
              }
            ],
            "props": {
              "style": {
                "flex": "1",
                "minWidth": "0"
              }
            }
          }
        ],
        "props": {
          "style": {
            "display": "flex",
            "gap": "16px",
            "alignItems": "flex-start"
          }
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
