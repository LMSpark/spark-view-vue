                "type": "r-text",
                "props": {
                  "label": "用户ID",
                  "colSpan": 8,
                  "field": "id"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "姓名",
                  "colSpan": 8,
                  "field": "name"
                }
              },
              {
                "type": "r-text",
