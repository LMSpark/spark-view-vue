                  "field": "name"
                }
              },
              {
                "type": "r-text",
                "props": {
                  "label": "邮箱",
                  "field": "email"
                }
              }
            ],
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "dataKey": "Users@rows"
            }
          }
        ],
        "props": {
          "class": "section",
          "style": {
            "marginBottom": "30px"
          }
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "h2",
