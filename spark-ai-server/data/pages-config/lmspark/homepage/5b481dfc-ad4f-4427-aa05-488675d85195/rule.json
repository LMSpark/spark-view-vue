[
  {
    "type": "div",
    "props": {
      "class": "order-management-page",
      "style": {
        "padding": "20px"
      }
    },
    "children": [
      {
        "type": "r-tabs",
        "props": {
          "dataKey": "Orders@rows",
          "toolbar": [
            {
              "type": "RenderToolbar"
            }
          ]
        },
        "children": [
          {
            "type": "r-tab-pane",
            "props": {
              "label": "订单列表",
              "name": "orders"
            },
            "children": [
              {
                "type": "r-table",
                "props": {
                  "dataKey": "Orders@rows",
                  "highlightCurrentRow": true,
                  "border": true,
                  "rowActions": [
                    {
                      "type": "RenderRowActions"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "r-text",
                    "props": {
                      "field": "orderNo",
                      "label": "订单号",
                      "width": 120
                    }
                  },
                  {
                    "type": "r-date",
                    "props": {
                      "field": "orderDate",
                      "label": "下单日期",
                      "width": 120
                    }
                  },
                  {
                    "type": "r-select",
                    "props": {
                      "field": "status",
                      "label": "状态",
                      "optionKey": "OrderStatusOptions@rows",
                      "optionLabelField": "label",
                      "optionValueField": "value",
                      "width": 100
                    }
                  },
                  {
                    "type": "r-number",
                    "props": {
                      "field": "totalAmount",
                      "label": "总金额",
                      "width": 100
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "remark",
                      "label": "备注",
                      "width": 150
                    }
                  }
                ]
              },
              {
                "type": "r-section",
                "props": {
                  "title": "订单明细",
                  "headerActions": [
                    {
                      "type": "RenderDetailActions"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "r-table",
                    "props": {
                      "dataKey": "OrderItems@rows",
                      "border": true
                    },
                    "children": [
                      {
                        "type": "r-number",
                        "props": {
                          "field": "productId",
                          "label": "产品ID",
                          "width": 100
                        }
                      },
                      {
                        "type": "r-number",
                        "props": {
                          "field": "quantity",
                          "label": "数量",
                          "width": 80
                        }
                      },
                      {
                        "type": "r-number",
                        "props": {
                          "field": "unitPrice",
                          "label": "单价",
                          "width": 100
                        }
                      },
                      {
                        "type": "r-number",
                        "props": {
                          "field": "subtotal",
                          "label": "小计",
                          "width": 100
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "r-tab-pane",
            "props": {
              "label": "客户管理",
              "name": "customers"
            },
            "children": [
              {
                "type": "r-table",
                "props": {
                  "dataKey": "Customers@rows",
                  "highlightCurrentRow": true,
                  "border": true,
                  "rowActions": [
                    {
                      "type": "RenderCustomerActions"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "r-text",
                    "props": {
                      "field": "name",
                      "label": "客户名称",
                      "width": 120
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "phone",
                      "label": "联系电话",
                      "width": 120
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "address",
                      "label": "地址",
                      "width": 150
                    }
                  }
                ]
              },
              {
                "type": "r-section",
                "props": {
                  "title": "联系人列表",
                  "headerActions": [
                    {
                      "type": "RenderContactActions"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "r-table",
                    "props": {
                      "dataKey": "Contacts@rows",
                      "border": true
                    },
                    "children": [
                      {
                        "type": "r-text",
                        "props": {
                          "field": "name",
                          "label": "姓名",
                          "width": 100
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "field": "phone",
                          "label": "电话",
                          "width": 120
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "field": "email",
                          "label": "邮箱",
                          "width": 150
                        }
                      },
                      {
                        "type": "r-text",
                        "props": {
                          "field": "company",
                          "label": "公司",
                          "width": 120
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "r-tab-pane",
            "props": {
              "label": "产品目录",
              "name": "products"
            },
            "children": [
              {
                "type": "r-table",
                "props": {
                  "dataKey": "Products@rows",
                  "border": true,
                  "rowActions": [
                    {
                      "type": "RenderProductActions"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "r-text",
                    "props": {
                      "field": "name",
                      "label": "产品名称",
                      "width": 150
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "field": "category",
                      "label": "分类",
                      "width": 100
                    }
                  },
                  {
                    "type": "r-number",
                    "props": {
                      "field": "price",
                      "label": "价格",
                      "width": 100
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]