[
  {
    "type": "r-table",
    "id": "ordersTable",
    "props": {
      "id": "ordersTable",
      "dataKey": "Orders@orderListView@rows",
      "toolbar": {
        "type": "r-toolbar",
        "props": {
          "id": "ordersToolbar"
        },
        "children": [
          {
            "type": "r-button",
            "props": {
              "id": "btnRefresh",
              "label": "刷新",
              "template": "toolbar-default",
              "icon": "Refresh",
              "action": "refresh"
            }
          },
          {
            "type": "r-button",
            "props": {
              "id": "btnAdd",
              "label": "新增",
              "template": "toolbar-primary",
              "icon": "Plus",
              "action": "append-row"
            }
          },
          {
            "type": "r-button",
            "props": {
              "id": "btnDelete",
              "label": "删除",
              "template": "toolbar-danger",
              "icon": "Delete",
              "action": "delete-current"
            }
          }
        ]
      },
      "tableProps": {
        "rowKey": "id",
        "highlightCurrentRow": true,
        "border": true,
        "stripe": true
      }
    },
    "children": []
  }
]
