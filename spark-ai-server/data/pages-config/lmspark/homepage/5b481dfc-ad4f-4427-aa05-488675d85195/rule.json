  {
    "type": "r-section",
    "id": "order-table-section",
    "props": {
      "id": "order-table-section",
      "title": "订单列表",
      "description": "所有订单明细"
    },
    "children": [
      {
        "type": "r-table",
        "id": "order-table",
        "props": {
          "id": "order-table",
          "dataKey": "Orders@orderListView@rows",
          "stripe": true,
          "border": true,
          "pageSize": 10,
          "actions": {
            "type": "r-actions",
            "props": {
              "id": "order-actions",
              "width": 180,
              "align": "center",
              "fixed": "right"
            },
            "children": [
              {
                "type": "r-button",
                "id": "action-view",
                "props": {
                  "id": "action-view",
                  "label": "查看",
                  "size": "small",
                  "template": "link",
                  "action": "view-row"
                }
              },
              {
                "type": "r-button",
                "id": "action-edit",
                "props": {
                  "id": "action-edit",
                  "label": "编辑",
                  "size": "small",
                  "template": "link",
                  "action": "edit-row"
                }
              },
              {
                "type": "r-button",
                "id": "action-delete",
                "props": {
                  "id": "action-delete",
                  "label": "删除",
                  "size": "small",
                  "template": "link",
                  "action": "delete-row",
                  "permAction": "delete",
                  "permDeniedBehavior": "disable"
                }
              }
            ]
          }
        },
        "children": [
          {
            "type": "r-text",
            "props": {
              "id": "col-orderNo",
              "field": "orderNo",
              "label": "订单号"
            },
            "children": [],
            "id": "col-orderNo"
          },
          {
            "type": "r-date",
            "props": {
              "id": "col-orderDate",
              "field": "orderDate",
              "label": "下单日期"
            },
            "children": [],
            "id": "col-orderDate"
          },
          {
            "type": "r-text",
            "props": {
              "id": "col-customerId",
              "field": "customerId",
              "label": "客户ID"
            },
            "children": [],
            "id": "col-customerId"
          },
          {
            "type": "r-select",
            "props": {
              "id": "col-status",
              "field": "status",
              "label": "状态",
              "optionKey": "OrderStatusOptions"
            },
            "children": [],
            "id": "col-status"
          },
          {
            "type": "r-number",
            "props": {
              "id": "col-totalAmount",
              "field": "totalAmount",
              "label": "总金额",
              "precision": 2
            },
            "children": [],
            "id": "col-totalAmount"
          },
          {
            "type": "r-text",
            "props": {
              "id": "col-remark",
              "field": "remark",
              "label": "备注"
            },
            "children": [],
            "id": "col-remark"
          }
        ]
