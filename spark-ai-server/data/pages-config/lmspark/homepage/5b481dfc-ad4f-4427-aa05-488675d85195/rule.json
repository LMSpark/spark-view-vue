                  "id": "ordersToolbar"
                },
                "children": [
                  {
                    "type": "r-button",
                    "props": {
                      "id": "btnRefresh",
                      "label": "刷新",
                      "template": "toolbar-default",
                      "icon": "Refresh",
                      "action": "refresh"
                    }
                  },
                  {
                    "type": "r-button",
                    "props": {
                      "id": "btnAdd",
                      "label": "新增",
                      "template": "toolbar-primary",
                      "icon": "Plus",
                      "action": "append-row"
