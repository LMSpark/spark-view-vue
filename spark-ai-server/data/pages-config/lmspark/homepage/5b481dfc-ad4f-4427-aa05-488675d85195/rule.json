                    "type": "r-button",
                    "props": {
                      "label": "编辑",
                      "template": "text",
                      "action": "message-row"
                    }
                  },
                  {
                    "type": "r-button",
                    "props": {
                      "label": "删除",
                      "template": "text-danger",
