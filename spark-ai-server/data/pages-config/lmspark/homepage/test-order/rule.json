[
  {
    "type": "div",
    "class": "page-container",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h2",
        "children": [
          "测试订单"
        ]
      },
      {
        "type": "el-divider"
      },
      {
        "type": "r-table",
        "dataKey": "test-order@rows",
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true
        },
        "children": [
          {
            "type": "r-text",
            "field": "id",
            "props": {
              "label": "ID",
              "width": 80
            }
          },
          {
            "type": "r-text",
            "field": "name",
            "props": {
              "label": "名称"
            }
          },
          {
            "type": "r-select",
            "field": "status",
            "props": {
              "label": "状态",
              "width": 120,
              "options": [
                {
                  "label": "待处理",
                  "value": "pending"
                },
                {
                  "label": "进行中",
                  "value": "processing"
                },
                {
                  "label": "已完成",
                  "value": "completed"
                },
                {
                  "label": "已取消",
                  "value": "cancelled"
                }
              ]
            }
          },
          {
            "type": "r-number",
            "field": "price",
            "props": {
              "label": "价格",
              "width": 120,
              "min": 0
            }
          }
        ]
      }
    ]
  }
]
