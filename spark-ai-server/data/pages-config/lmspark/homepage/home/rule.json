[
  {
    "type": "div",
    "children": [
      {
        "type": "div",
        "class": "css-isolation-banner",
        "children": [
          {
            "type": "div",
            "class": "badge",
            "children": [
              "CSS 隔离"
            ]
          },
          {
            "type": "div",
            "class": "banner-text",
            "children": [
              "以下样式仅在 home 页面生效，切换到其他路由后自动失效"
            ]
          },
          {
            "type": "div",
            "class": "scope-code",
            "children": [
              "[data-page=\"home\"].spark-page-container .xxx"
            ]
          }
        ]
      },
      {
        "type": "h3",
        "children": [
          "数据统计"
        ]
      },
      {
        "type": "div",
        "style": {
          "marginBottom": "12px"
        },
        "children": [
          {
            "type": "r-module-context-badge",
            "props": {
              "label": "模块上下文",
              "emptyText": "当前页面无模块上下文"
            }
          }
        ]
      },
      {
        "type": "div",
        "style": {
          "marginBottom": "20px"
        },
        "children": [
          {
            "type": "el-button",
            "props": {
              "type": "primary"
            },
            "class": "test-button",
            "on": {
              "click": "testButtonClick"
            },
            "children": [
              "🎯 测试 JS 和 CSS"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "success"
            },
            "style": {
              "marginLeft": "10px"
            },
            "on": {
              "click": "showAlert"
            },
            "children": [
              "🔔 显示提示"
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "warning"
            },
            "style": {
              "marginLeft": "10px"
            },
            "on": {
              "click": "highlightButtons"
            },
            "children": [
              "✨ 按钮高亮动画"
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "stats-grid",
        "style": {
          "display": "grid",
          "gridTemplateColumns": "repeat(4, 1fr)",
          "gap": "20px",
          "marginBottom": "20px"
        },
        "children": [
          {
            "type": "div",
            "class": "content-section",
            "children": [
              {
                "type": "div",
                "style": {
                  "fontSize": "14px",
                  "color": "#999"
                },
                "children": [
                  "总用户数"
                ]
              },
              {
                "type": "div",
                "style": {
                  "fontSize": "30px",
                  "fontWeight": "bold",
                  "marginTop": "10px"
                },
                "dataKey": "stats@currentRow.totalUsers",
                "children": [
                  ""
                ]
              }
            ]
          },
          {
            "type": "div",
            "class": "content-section",
            "children": [
              {
                "type": "div",
                "style": {
                  "fontSize": "14px",
                  "color": "#999"
                },
                "children": [
                  "今日订单"
                ]
              },
              {
                "type": "div",
                "style": {
                  "fontSize": "30px",
                  "fontWeight": "bold",
                  "marginTop": "10px",
                  "color": "#67c23a"
                },
                "dataKey": "stats@currentRow.todayOrders",
                "children": [
                  ""
                ]
              }
            ]
          },
          {
            "type": "div",
            "class": "content-section",
            "children": [
              {
                "type": "div",
                "style": {
                  "fontSize": "14px",
                  "color": "#999"
                },
                "children": [
                  "营业额"
                ]
              },
              {
                "type": "div",
                "style": {
                  "fontSize": "30px",
                  "fontWeight": "bold",
                  "marginTop": "10px"
                },
                "dataKey": "stats@currentRow.revenue",
                "children": [
                  ""
                ]
              }
            ]
          },
          {
            "type": "div",
            "class": "content-section",
            "children": [
              {
                "type": "div",
                "style": {
                  "fontSize": "14px",
                  "color": "#999"
                },
                "children": [
                  "待处理"
                ]
              },
              {
                "type": "div",
                "style": {
                  "fontSize": "30px",
                  "fontWeight": "bold",
                  "marginTop": "10px",
                  "color": "#e6a23c"
                },
                "dataKey": "stats@currentRow.pending",
                "children": [
                  ""
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "content-section",
        "children": [
          {
            "type": "h3",
            "style": {
              "marginBottom": "15px"
            },
            "children": [
              "用户列表"
            ]
          },
          {
            "type": "el-table",
            "dataKey": "tableData@rows",
            "props": {
              "data": [],
              "stripe": true,
              "border": true
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "id",
                  "label": "ID",
                  "width": "80"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "name",
                  "label": "姓名",
                  "width": "120"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "email",
                  "label": "邮箱"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "status",
                  "label": "状态",
                  "width": "100"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "date",
                  "label": "创建时间",
                  "width": "120"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "content-section",
        "children": [
          {
            "type": "h3",
            "style": {
              "marginBottom": "15px"
            },
            "children": [
              "新增用户"
            ]
          },
          {
            "type": "input",
            "field": "username",
            "title": "用户名",
            "value": "",
            "props": {
              "placeholder": "请输入用户名"
            },
            "validate": [
              {
                "required": true,
                "message": "请输入用户名",
                "trigger": "submit"
              }
            ]
          },
          {
            "type": "input",
            "field": "email",
            "title": "邮箱",
            "value": "",
            "props": {
              "placeholder": "请输入邮箱"
            },
            "validate": [
              {
                "required": true,
                "message": "请输入邮箱",
                "trigger": "submit"
              },
              {
                "type": "email",
                "message": "邮箱格式不正确",
                "trigger": "submit"
              }
            ]
          },
          {
            "type": "select",
            "field": "status",
            "title": "状态",
            "value": "激活",
            "dataKey": "formOptions@currentRow.statusOptions",
            "options": []
          },
          {
            "type": "radio",
            "field": "gender",
            "title": "性别",
            "value": "男",
            "dataKey": "formOptions@currentRow.genderOptions",
            "options": []
          },
          {
            "type": "switch",
            "field": "vip",
            "title": "VIP会员",
            "value": false
          }
        ]
      }
    ]
  }
]
