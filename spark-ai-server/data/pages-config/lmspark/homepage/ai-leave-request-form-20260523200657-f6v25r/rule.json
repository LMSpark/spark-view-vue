[
  {
    "type": "r-section",
    "id": "leave-summary-section",
    "props": {
      "title": "请假概览",
      "useCard": true,
      "gridColumns": 4,
      "gridGap": "16px"
    },
    "children": [
      {
        "type": "display-statistic",
        "id": "stat-pending-count",
        "props": {
          "title": "待审批",
          "dataViewKey": "LeaveRequest@pending",
          "dataMember": "aggregateResult",
          "dataField": "pendingCount",
          "valueStyle": {
            "color": "#e6a23c"
          }
        },
        "children": []
      },
      {
        "type": "display-statistic",
        "id": "stat-total-requests",
        "props": {
          "title": "总申请数",
          "dataViewKey": "LeaveRequest@default",
          "dataMember": "total"
        },
        "children": []
      }
    ]
  },
  {
    "type": "r-section",
    "id": "leave-form-section",
    "props": {
      "title": "请假申请",
      "useCard": true,
      "gridColumns": 1
    },
    "children": [
      {
        "type": "r-form",
        "id": "leave-application-form",
        "props": {
          "dataViewKey": "LeaveRequest@default",
          "contextDataMember": "currentRow",
          "gridColumns": 2,
          "gridGap": "16px",
          "labelWidth": "100px"
        },
        "children": [
          {
            "type": "r-text",
            "id": "field-applicant-name",
            "props": {
              "field": "applicantName",
              "label": "申请人",
              "placeholder": "请输入申请人姓名"
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "field-leave-type",
            "props": {
              "field": "leaveType",
              "label": "请假类型",
              "placeholder": "请选择请假类型",
              "optionDataViewKey": "LeaveType@default",
              "optionLabelField": "label",
              "optionValueField": "value"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-start-date",
            "props": {
              "field": "startDate",
              "label": "开始日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD",
              "placeholder": "选择开始日期"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-end-date",
            "props": {
              "field": "endDate",
              "label": "结束日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD",
              "placeholder": "选择结束日期"
            },
            "children": []
          },
          {
            "type": "r-number",
            "id": "field-days",
            "props": {
              "field": "days",
              "label": "请假天数",
              "min": 0.5,
              "precision": 1,
              "placeholder": "请输入天数"
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "field-reason",
            "props": {
              "field": "reason",
              "label": "请假事由",
              "rows": 3,
              "maxlength": 500,
              "showWordLimit": true,
              "placeholder": "请输入请假事由"
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "btn-submit",
            "props": {
              "action": "submit-current-form",
              "label": "提交申请",
              "buttonType": "primary"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "leave-pending-section",
    "props": {
      "title": "待审批列表",
      "useCard": true,
      "gridColumns": 1
    },
    "children": [
      {
        "type": "r-table",
        "id": "pending-leave-table",
        "props": {
          "dataViewKey": "LeaveRequest@pending",
          "stripe": true,
          "border": true,
          "showPagination": true,
          "rowKey": "id",
          "autoColumns": true
        },
        "children": []
      }
    ]
  }
]
