[
  {
    "type": "div",
    "class": "cascade-demo-container",
    "children": [
      {
        "type": "div",
        "class": "demo-header",
        "children": [
          {
            "type": "h2",
            "children": [
              "级联操作演示 (Cascade Demo)"
            ]
          },
          {
            "type": "p",
            "children": [
              "演示 cascadeUpdate 和 cascadeDelete 功能"
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h3",
            "children": [
              "用户表 (Users)"
            ]
          },
          {
            "type": "div",
            "style": {
              "marginBottom": "10px"
            },
            "children": [
              {
                "type": "el-button",
                "props": {
                  "type": "primary",
                  "size": "small"
                },
                "on": {
                  "click": "handleAddUser"
                },
                "children": [
                  "➕ 添加用户"
                ]
              },
              {
                "type": "el-button",
                "props": {
                  "type": "warning",
                  "size": "small"
                },
                "style": {
                  "marginLeft": "10px"
                },
                "on": {
                  "click": "handleUpdateUserIdBatch"
                },
                "children": [
                  "✏️ 批量修改ID (测试级联更新)"
                ]
              },
              {
                "type": "el-button",
                "props": {
                  "type": "danger",
                  "size": "small"
                },
                "style": {
                  "marginLeft": "10px"
                },
                "on": {
                  "click": "handleDeleteSelectedUser"
                },
                "children": [
                  "🗑️ 删除选中用户 (测试级联删除)"
                ]
              }
            ]
          },
          {
            "type": "r-table",
            "dataKey": "Users@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "on": {
              "current-change": "handleUserRowChange"
            },
            "children": [
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "用户ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "name",
                "props": {
                  "label": "姓名",
                  "width": 150
                }
              },
              {
                "type": "r-text",
                "field": "email",
                "props": {
                  "label": "邮箱"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h3",
            "children": [
              "订单表 (Orders) - 级联更新/删除目标"
            ]
          },
          {
            "type": "r-table",
            "dataKey": "Orders@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "订单ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "userId",
                "props": {
                  "label": "用户ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "orderNo",
                "props": {
                  "label": "订单号",
                  "width": 150
                }
              },
              {
                "type": "r-text",
                "field": "amount",
                "props": {
                  "label": "金额"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h3",
            "children": [
              "订单明细表 (OrderItems) - 级联删除目标"
            ]
          },
          {
            "type": "r-table",
            "dataKey": "OrderItems@rows",
            "props": {
              "border": true,
              "stripe": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "id",
                "props": {
                  "label": "明细ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "orderId",
                "props": {
                  "label": "订单ID",
                  "width": 100
                }
              },
              {
                "type": "r-text",
                "field": "productName",
                "props": {
                  "label": "产品名称"
                }
              },
              {
                "type": "r-text",
                "field": "quantity",
                "props": {
                  "label": "数量",
                  "width": 80
                }
              },
              {
                "type": "r-text",
                "field": "price",
                "props": {
                  "label": "单价",
                  "width": 100
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-info",
        "children": [
          {
            "type": "el-alert",
            "props": {
              "title": "使用说明",
              "type": "info",
              "showIcon": true
            },
            "children": [
              {
                "type": "div",
                "children": [
                  "1. 点击表格行选中用户（行会高亮显示）",
                  {
                    "type": "br"
                  },
                  "2. 点击「批量修改ID」测试级联更新：所有用户ID增加指定值，订单的userId自动同步",
                  {
                    "type": "br"
                  },
                  "3. 点击「删除选中用户」测试级联删除：递归删除该用户的所有订单和订单明细",
                  {
                    "type": "br"
                  },
                  "4. 打开控制台查看详细的级联操作日志"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
