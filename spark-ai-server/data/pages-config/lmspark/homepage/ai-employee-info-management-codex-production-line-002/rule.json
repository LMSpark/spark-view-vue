[
  {
    "type": "r-section",
    "id": "section-stats",
    "props": {
      "title": "统计摘要",
      "useCard": true,
      "cardShadow": "hover"
    },
    "children": [
      {
        "type": "data-view-meta-bar",
        "id": "stats-meta-bar",
        "props": {
          "showDataViewMeta": true,
          "showAggregateSummary": true,
          "showSelectionSummary": false
        },
        "children": []
      }
    ]
  },
  {
    "type": "r-section",
    "id": "section-table",
    "props": {
      "title": "员工信息",
      "useCard": true,
      "cardShadow": "hover"
    },
    "children": [
      {
        "type": "r-table",
        "id": "table-employee",
        "props": {
          "dataViewKey": "Employee@default",
          "stripe": true,
          "highlightCurrentRow": true,
          "showPagination": true,
          "autoColumns": true,
          "showDataViewMeta": false,
          "showAggregateSummary": false,
          "showSelectionSummary": false,
          "toolbar": {
            "type": "r-toolbar",
            "props": {},
            "children": [
              {
                "type": "r-button",
                "id": "btn-add",
                "props": "{\"action\":\"append-row\",\"label\":\"新增员工\",\"template\":\"primary\"}"
              },
              {
                "type": "r-button",
                "id": "btn-refresh",
                "props": "{\"action\":\"refresh\",\"label\":\"刷新\"}"
              },
              {
                "type": "r-button",
                "id": "btn-del",
                "props": "{\"action\":\"delete-current\",\"label\":\"删除\",\"template\":\"toolbar-danger\",\"confirmMessage\":\"确认删除当前选中的员工记录？\"}"
              }
            ]
          },
          "filter": {
            "type": "r-filter",
            "props": {
              "collapsible": true,
              "defaultCollapsed": false,
              "gridColumns": 4,
              "gridGap": "16px"
            },
            "children": [
              {
                "type": "r-select",
                "id": "f-dept",
                "props": "{\"field\":\"departmentId\",\"label\":\"部门\",\"optionDataViewKey\":\"Department@default\",\"optionLabelField\":\"name\",\"optionValueField\":\"id\",\"clearable\":true,\"placeholder\":\"全部部门\"}"
              },
              {
                "type": "r-select",
                "id": "f-pos",
                "props": "{\"field\":\"positionId\",\"label\":\"岗位\",\"optionDataViewKey\":\"Position@default\",\"optionLabelField\":\"name\",\"optionValueField\":\"id\",\"clearable\":true,\"placeholder\":\"全部岗位\"}"
              },
              {
                "type": "r-select",
                "id": "f-status",
                "props": "{\"field\":\"status\",\"label\":\"入职状态\",\"clearable\":true,\"placeholder\":\"全部状态\",\"options\":[{\"label\":\"在职\",\"value\":\"active\"},{\"label\":\"离职\",\"value\":\"resigned\"},{\"label\":\"试用期\",\"value\":\"probation\"},{\"label\":\"停薪留职\",\"value\":\"inactive\"}]}"
              },
              {
                "type": "r-button",
                "id": "f-search",
                "props": "{\"action\":\"refresh\",\"label\":\"查询\",\"template\":\"primary\"}"
              }
            ]
          }
        },
        "children": []
      }
    ]
  },
