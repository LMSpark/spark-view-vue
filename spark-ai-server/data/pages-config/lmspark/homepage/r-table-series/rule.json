[
  {
    "type": "div",
    "class": "r-table-series-page",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "h1",
        "children": [
          "r-table 组件系列 · Dock 版高覆盖演示"
        ]
      },
      {
        "type": "p",
        "class": "r-table-series-page__desc",
        "children": [
          "本页集中演示 Dock 版结构：工具栏、过滤面板、分组列、行权限动作、汇总行、当前行表单、主从联动。"
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "订单主表（完整能力）",
          "description": "支持工具栏、筛选、多级列头、行级权限动作与当前行高亮"
        },
        "children": [
          {
            "type": "r-table",
            "id": "ordersTable",
            "dataKey": "Orders@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "filterCollapsible": true,
              "filterDefaultCollapsed": false,
              "rowActionsLabel": "操作",
              "rowActionsWidth": 220
            },
            "children": [
              {
                "type": "r-toolbar",
                "props": {
                  "position": "top"
                },
                "children": [
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "append-row",
                      "label": "新增订单",
                      "buttonType": "primary",
                      "appendPayload": {
                        "customer": "新客户",
                        "status": "draft",
                        "priority": "medium",
                        "owner": "系统",
                        "amount": 8800,
                        "orderDate": "2026-03-18",
                        "region": "east",
                        "_perm": {
                          "allowDelete": true,
                          "editableFields": [
                            "status",
                            "priority",
                            "owner",
                            "amount"
                          ]
                        }
                      },
                      "successMessage": "已新增订单"
                    }
                  },
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "refresh",
                      "label": "刷新列表",
                      "successMessage": "列表已刷新"
                    }
                  },
                  {
                    "type": "button",
                    "props": {
                      "type": "button"
                    },
                    "children": [
                      "脚本刷新(ID)"
                    ],
                    "on": {
                      "click": "refreshOrders"
                    }
                  },
                  {
                    "type": "button",
                    "props": {
                      "type": "button"
                    },
                    "children": [
                      "脚本选首行(ID)"
                    ],
                    "on": {
                      "click": "selectFirstOrder"
                    }
                  },
                  {
                    "type": "button",
                    "props": {
                      "type": "button"
                    },
                    "children": [
                      "脚本更新当前(ID)"
                    ],
                    "on": {
                      "click": "markCurrentOrderDone"
                    }
                  },
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "delete-current",
                      "label": "删除当前",
                      "buttonType": "danger",
                      "confirmTitle": "删除确认",
                      "confirmMessage": "确认删除当前订单吗？",
                      "successMessage": "当前订单已删除"
                    }
                  },
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "patch-current",
                      "label": "更新当前订单",
                      "patch": {
                        "status": "done",
                        "priority": "low"
                      },
                      "successMessage": "当前订单已更新"
                    }
                  },
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "message-current",
                      "label": "查看当前",
                      "message": "当前订单 {orderNo} | 客户 {customer} | 状态 {status} | 优先级 {priority}"
                    }
                  }
                ]
              },
              {
                "type": "r-text",
                "field": "orderNo",
                "props": {
                  "label": "订单号",
                  "width": 150
                }
              },
              {
                "type": "r-text",
                "field": "customer",
                "props": {
                  "label": "客户",
                  "width": 120
                }
              },
              {
                "type": "r-select",
                "field": "status",
                "props": {
                  "label": "状态",
                  "width": 110,
                  "options": [
                    {
                      "label": "草稿",
                      "value": "draft"
                    },
                    {
                      "label": "待审核",
                      "value": "pending"
                    },
                    {
                      "label": "已完成",
                      "value": "done"
                    },
                    {
                      "label": "已取消",
                      "value": "cancelled"
                    }
                  ]
                }
              },
              {
                "type": "r-select",
                "field": "priority",
                "props": {
                  "label": "优先级",
                  "width": 110,
                  "options": [
                    {
                      "label": "低",
                      "value": "low"
                    },
                    {
                      "label": "中",
                      "value": "medium"
                    },
                    {
                      "label": "高",
                      "value": "high"
                    }
                  ]
                }
              },
              {
                "type": "r-text",
                "field": "owner",
                "props": {
                  "label": "负责人",
                  "width": 110
                }
              },
              {
                "type": "r-date",
                "field": "orderDate",
                "props": {
                  "label": "下单日期",
                  "width": 140
                }
              },
              {
                "type": "r-column-group",
                "props": {
                  "label": "金额信息"
                },
                "children": [
                  {
                    "type": "r-number",
                    "field": "amount",
                    "props": {
                      "label": "订单金额",
                      "width": 120,
                      "filterMode": "range"
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "taxAmount",
                    "props": {
                      "label": "税额",
                      "width": 100
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "totalAmount",
                    "props": {
                      "label": "含税总额",
                      "width": 130
                    }
                  }
                ]
              },
              {
                "type": "r-select",
                "field": "region",
                "props": {
                  "label": "区域",
                  "width": 120,
                  "options": [
                    {
                      "label": "华东",
                      "value": "east"
                    },
                    {
                      "label": "华南",
                      "value": "south"
                    },
                    {
                      "label": "华北",
                      "value": "north"
                    },
                    {
                      "label": "西南",
                      "value": "west"
                    }
                  ]
                }
              },
              {
                "type": "r-filter",
                "children": [
                  {
                    "type": "r-text",
                    "field": "orderNo",
                    "props": {
                      "label": "订单号"
                    }
                  },
                  {
                    "type": "r-text",
                    "field": "customer",
                    "props": {
                      "label": "客户"
                    }
                  },
                  {
                    "type": "r-select",
                    "field": "status",
                    "props": {
                      "label": "状态",
                      "options": [
                        {
                          "label": "草稿",
                          "value": "draft"
                        },
                        {
                          "label": "待审核",
                          "value": "pending"
                        },
                        {
                          "label": "已完成",
                          "value": "done"
                        },
                        {
                          "label": "已取消",
                          "value": "cancelled"
                        }
                      ]
                    }
                  },
                  {
                    "type": "r-select",
                    "field": "priority",
                    "props": {
                      "label": "优先级",
                      "options": [
                        {
                          "label": "低",
                          "value": "low"
                        },
                        {
                          "label": "中",
                          "value": "medium"
                        },
                        {
                          "label": "高",
                          "value": "high"
                        }
                      ]
                    }
                  },
                  {
                    "type": "r-text",
                    "field": "owner",
                    "props": {
                      "label": "负责人"
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "amount",
                    "props": {
                      "label": "金额",
                      "filterMode": "range"
                    }
                  },
                  {
                    "type": "r-date",
                    "field": "orderDate",
                    "props": {
                      "label": "下单日期"
                    }
                  },
                  {
                    "type": "r-select",
                    "field": "region",
                    "props": {
                      "label": "区域",
                      "options": [
                        {
                          "label": "华东",
                          "value": "east"
                        },
                        {
                          "label": "华南",
                          "value": "south"
                        },
                        {
                          "label": "华北",
                          "value": "north"
                        },
                        {
                          "label": "西南",
                          "value": "west"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "r-actions",
                "children": [
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "message-row",
                      "label": "查看",
                      "buttonSize": "small",
                      "message": "订单 {orderNo} | 客户 {customer} | 优先级 {priority}"
                    }
                  },
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "patch-row",
                      "label": "提级",
                      "buttonSize": "small",
                      "patch": {
                        "priority": "high"
                      },
                      "successMessage": "订单优先级已提升",
                      "permAction": "edit"
                    }
                  },
                  {
                    "type": "builtin-action",
                    "props": {
                      "builtinAction": "delete-row",
                      "label": "删除",
                      "buttonSize": "small",
                      "buttonType": "danger",
                      "confirmTitle": "删除确认",
                      "confirmMessage": "确认删除当前订单吗？",
                      "permAction": "delete"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "汇总区（summaryRow / selectionSummaryRow）",
          "description": "左侧展示全量汇总，右侧展示勾选行汇总"
        },
        "children": [
          {
            "type": "div",
            "class": "summary-grid",
            "children": [
              {
                "type": "r-detail",
                "dataKey": "Orders@summaryRow",
                "children": [
                  {
                    "type": "r-number",
                    "field": "orderCount",
                    "props": {
                      "label": "总订单数",
                      "colSpan": 12
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "amount",
                    "props": {
                      "label": "金额合计",
                      "colSpan": 12
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "taxAmount",
                    "props": {
                      "label": "税额合计",
                      "colSpan": 12
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "totalAmount",
                    "props": {
                      "label": "含税总额",
                      "colSpan": 12
                    }
                  }
                ]
              },
              {
                "type": "r-detail",
                "dataKey": "Orders@selectionSummaryRow",
                "children": [
                  {
                    "type": "r-number",
                    "field": "orderCount",
                    "props": {
                      "label": "勾选订单数",
                      "colSpan": 12
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "amount",
                    "props": {
                      "label": "勾选金额合计",
                      "colSpan": 12
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "taxAmount",
                    "props": {
                      "label": "勾选税额合计",
                      "colSpan": 12
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "totalAmount",
                    "props": {
                      "label": "勾选含税总额",
                      "colSpan": 12
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "当前行编辑（r-form）",
          "description": "字段是否可编辑由当前行 _perm.editableFields 自动控制"
        },
        "children": [
          {
            "type": "r-form",
            "dataKey": "Orders@currentRow",
            "props": {
              "gridColumns": 24,
              "gridGap": 12
            },
            "children": [
              {
                "type": "r-text",
                "field": "orderNo",
                "props": {
                  "label": "订单号",
                  "colSpan": 8
                }
              },
              {
                "type": "r-text",
                "field": "customer",
                "props": {
                  "label": "客户",
                  "colSpan": 8
                }
              },
              {
                "type": "r-text",
                "field": "owner",
                "props": {
                  "label": "负责人",
                  "colSpan": 8
                }
              },
              {
                "type": "r-select",
                "field": "status",
                "props": {
                  "label": "状态",
                  "colSpan": 8,
                  "options": [
                    {
                      "label": "草稿",
                      "value": "draft"
                    },
                    {
                      "label": "待审核",
                      "value": "pending"
                    },
                    {
                      "label": "已完成",
                      "value": "done"
                    },
                    {
                      "label": "已取消",
                      "value": "cancelled"
                    }
                  ]
                }
              },
              {
                "type": "r-select",
                "field": "priority",
                "props": {
                  "label": "优先级",
                  "colSpan": 8,
                  "options": [
                    {
                      "label": "低",
                      "value": "low"
                    },
                    {
                      "label": "中",
                      "value": "medium"
                    },
                    {
                      "label": "高",
                      "value": "high"
                    }
                  ]
                }
              },
              {
                "type": "r-number",
                "field": "amount",
                "props": {
                  "label": "订单金额",
                  "colSpan": 8
                }
              }
            ]
          }
        ]
      },
      {
        "type": "r-section",
        "props": {
          "title": "订单明细（主从联动）",
          "description": "当前订单变化后，明细表按 relation 自动过滤"
        },
        "children": [
          {
            "type": "r-table",
            "dataKey": "OrderItems@rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true,
              "filterCollapsible": true,
              "filterDefaultCollapsed": true
            },
            "children": [
              {
                "type": "r-text",
                "field": "sku",
                "props": {
                  "label": "SKU",
                  "width": 140
                }
              },
              {
                "type": "r-text",
                "field": "product",
                "props": {
                  "label": "商品",
                  "width": 180
                }
              },
              {
                "type": "r-number",
                "field": "qty",
                "props": {
                  "label": "数量",
                  "width": 90,
                  "filterMode": "range"
                }
              },
              {
                "type": "r-number",
                "field": "unitPrice",
                "props": {
                  "label": "单价",
                  "width": 100
                }
              },
              {
                "type": "r-number",
                "field": "lineAmount",
                "props": {
                  "label": "行金额",
                  "width": 120
                }
              },
              {
                "type": "r-filter",
                "children": [
                  {
                    "type": "r-text",
                    "field": "product",
                    "props": {
                      "label": "商品"
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "qty",
                    "props": {
                      "label": "数量",
                      "filterMode": "range"
                    }
                  },
                  {
                    "type": "r-number",
                    "field": "lineAmount",
                    "props": {
                      "label": "行金额",
                      "filterMode": "range"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]