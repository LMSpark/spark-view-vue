[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "表格配置器"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "showIcon": true,
          "closable": false,
          "title": "本页演示列配置数据结构，可直接用于 r-table 列动态生成。"
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "div",
            "children": [
              {
                "type": "r-table",
                "id": "tableConfiguratorColumns",
                "children": [
                  {
                    "type": "r-text",
                    "props": {
                      "label": "字段名",
                      "width": 180,
                      "field": "field"
                    }
                  },
                  {
                    "type": "r-text",
                    "props": {
                      "label": "标题",
                      "width": 160,
                      "field": "label"
                    }
                  },
                  {
                    "type": "r-number",
                    "props": {
                      "label": "宽度",
                      "width": 110,
                      "field": "width"
                    }
                  },
                  {
                    "type": "r-select",
                    "props": {
                      "label": "对齐",
                      "width": 110,
                      "options": [
                        {
                          "label": "左",
                          "value": "left"
                        },
                        {
                          "label": "中",
                          "value": "center"
                        },
                        {
                          "label": "右",
                          "value": "right"
                        }
                      ],
                      "field": "align"
                    }
                  },
                  {
                    "type": "r-switch",
                    "props": {
                      "label": "可排序",
                      "width": 110,
                      "field": "sortable"
                    }
                  },
                  {
                    "type": "r-switch",
                    "props": {
                      "label": "可见",
                      "width": 110,
                      "field": "visible"
                    }
                  }
                ],
                "props": {
                  "border": true,
                  "stripe": true,
                  "highlightCurrentRow": true,
                  "toolbar": {
                    "type": "r-toolbar",
                    "children": [
                      {
                        "type": "r-button",
                        "props": {
                          "action": "append-row",
                          "label": "新增列",
                          "buttonType": "primary",
                          "appendPayload": {
                            "field": "newField",
                            "label": "新列",
                            "width": 140,
                            "align": "left",
                            "sortable": false,
                            "visible": true
                          },
                          "successMessage": "已新增列配置"
                        }
                      },
                      {
                        "type": "r-button",
                        "props": {
                          "action": "delete-current",
                          "label": "删除当前",
                          "buttonType": "danger",
                          "confirmTitle": "删除确认",
                          "confirmMessage": "确定删除当前列配置吗？",
                          "successMessage": "当前列配置已删除"
                        }
                      }
                    ],
                    "props": {
                      "position": "top"
                    }
                  },
                  "actions": {
                    "type": "r-toolbar",
                    "children": [],
                    "props": {
                      "width": 140,
                      "label": "操作"
                    }
                  },
                  "viewKey": "columns@default"
                }
              }
            ],
            "props": {
              "style": {
                "flex": "1",
                "minWidth": "0"
              }
            }
          },
          {
            "type": "div",
            "children": [
              {
                "type": "h3",
                "children": [
                  "当前列详情"
                ],
                "props": {
                  "style": {
                    "margin": "0 0 12px"
                  }
                }
              },
              {
                "type": "r-detail",
                "children": [
                  {
                    "type": "r-text-display",
                    "props": {
                      "label": "字段名",
                      "field": "field"
                    }
                  },
                  {
                    "type": "r-text-display",
                    "props": {
                      "label": "标题",
                      "field": "label"
                    }
                  },
                  {
                    "type": "r-text-display",
                    "props": {
                      "label": "宽度",
                      "field": "width"
                    }
                  },
                  {
                    "type": "r-text-display",
                    "props": {
                      "label": "对齐",
                      "field": "align"
                    }
                  },
                  {
                    "type": "r-tag",
                    "props": {
                      "content": "可排序: $[sortable]"
                    }
                  },
                  {
                    "type": "r-tag",
                    "props": {
                      "content": "可见: $[visible]"
                    }
                  }
                ],
                "props": {
                  "viewKey": "columns@default",
                  "contextDataKey": "columns@default@currentRow"
                }
              }
            ],
            "props": {
              "style": {
                "width": "320px",
                "border": "1px solid #e4e7ed",
                "borderRadius": "8px",
                "padding": "12px"
              }
            }
          }
        ],
        "props": {
          "style": {
            "display": "flex",
            "gap": "16px",
            "alignItems": "stretch",
            "minHeight": "420px"
          }
        }
      }
    ],
    "props": {
      "style": {
        "padding": "20px",
        "display": "flex",
        "flexDirection": "column",
        "gap": "16px",
        "height": "100%"
      }
    }
  }
]
