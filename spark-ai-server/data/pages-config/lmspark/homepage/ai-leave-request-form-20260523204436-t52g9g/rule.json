[
  {
    "type": "r-section",
    "id": "stats-section",
    "props": {
      "title": "待处理统计",
      "bordered": true
    },
    "children": [
      {
        "type": "r-text",
        "id": "stats-text",
        "props": {
          "dataViewKey": "leave_requests@pending",
          "dataMember": "aggregateResult",
          "dataField": "pendingCount",
          "label": "待处理申请数"
        },
        "children": []
      }
    ]
  },
  {
    "type": "r-section",
    "id": "form-section",
    "props": {
      "title": "请假申请",
      "bordered": true
    },
    "children": [
      {
        "type": "r-form",
        "id": "leave-form",
        "props": {
          "dataViewKey": "leave_requests@default",
          "contextDataMember": "currentRow",
          "labelWidth": "100px",
          "autoColumns": false
        },
        "children": [
          {
            "type": "r-text",
            "id": "field-applicantName",
            "props": {
              "field": "applicantName",
              "label": "申请人",
              "placeholder": "请输入申请人姓名"
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "field-leaveType",
            "props": {
              "field": "leaveType",
              "label": "请假类型",
              "optionDataViewKey": "leave_types@default",
              "optionLabelField": "label",
              "optionValueField": "value"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-startDate",
            "props": {
              "field": "startDate",
              "label": "开始日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD",
              "placeholder": "选择开始日期"
            },
            "children": []
          },
          {
            "type": "r-date",
            "id": "field-endDate",
            "props": {
              "field": "endDate",
              "label": "结束日期",
              "dateType": "date",
              "valueFormat": "YYYY-MM-DD",
              "placeholder": "选择结束日期"
            },
            "children": []
          },
          {
            "type": "r-number",
            "id": "field-days",
            "props": {
              "field": "days",
              "label": "天数",
              "min": 1,
              "placeholder": "请输入请假天数"
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "field-reason",
            "props": {
              "field": "reason",
              "label": "请假原因",
              "placeholder": "请输入请假原因",
              "rows": 4
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "btn-submit",
            "props": {
              "label": "提交申请",
              "action": "append-row",
              "dataViewKey": "leave_requests@pending",
              "template": "primary",
              "inheritFields": [
                "applicantName",
                "leaveType",
                "startDate",
                "endDate",
                "days",
                "reason"
              ],
              "appendPayload": {
                "status": "pending"
              },
              "then": {
                "action": "patch-current",
                "dataViewKey": "leave_requests@default",
                "patch": {
                  "applicantName": "",
                  "leaveType": "年假",
                  "startDate": "",
                  "endDate": "",
                  "days": 1,
                  "reason": "",
                  "status": "draft"
                },
                "silent": true
              }
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "r-section",
    "id": "list-section",
    "props": {
      "title": "待处理申请",
      "bordered": true
    },
    "children": [
      {
        "type": "r-table",
        "id": "pending-table",
        "props": {
          "dataViewKey": "leave_requests@pending",
          "dataMember": "rows",
          "autoColumns": true,
          "border": true,
          "stripe": true,
          "showPagination": true,
          "highlightCurrentRow": true
        },
        "children": []
      }
    ]
  }
]
