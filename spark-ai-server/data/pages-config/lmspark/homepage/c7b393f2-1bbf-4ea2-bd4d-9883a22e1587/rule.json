[
  {
    "type": "r-section",
    "id": "stats-section",
    "props": {
      "title": "📊 请假概览",
      "description": "实时统计 · 一目了然",
      "useCard": true,
      "bordered": false,
      "bodyClass": "stats-card-grid"
    },
    "children": [
      {
        "type": "r-card",
        "children": [
          {
            "type": "r-statistic",
            "children": [],
            "id": "stats-pending-count",
            "props": {
              "dataKey": "LeaveRequests@default@aggregateResult",
              "field": "pendingCount",
              "precision": 0
            }
          }
        ],
        "id": "stats-pending",
        "props": {
          "header": "待审批",
          "bodyClass": "stats-card stats-card-pending",
          "shadow": "hover"
        }
      },
      {
        "type": "r-card",
        "id": "stats-approved",
        "props": {
          "header": "已通过",
          "bodyClass": "stats-card stats-card-approved",
          "shadow": "hover",
          "bodyStyle": {
            "textAlign": "center",
            "borderLeft": "4px solid #67c23a",
            "background": "linear-gradient(135deg, #f0f9eb, #fff)",
            "borderRadius": "8px",
            "padding": "16px"
          }
        },
        "children": [
          {
            "type": "r-statistic",
            "children": [],
            "id": "stats-approved-count",
            "props": {
              "dataKey": "LeaveRequests@default@aggregateResult",
              "field": "approvedCount",
              "precision": 0
            }
          }
        ]
      },
      {
        "type": "r-card",
        "id": "stats-rejected",
        "props": {
          "header": "已拒绝",
          "bodyClass": "stats-card stats-card-rejected",
          "shadow": "hover",
          "bodyStyle": {
            "textAlign": "center",
            "borderLeft": "4px solid #f56c6c",
            "background": "linear-gradient(135deg, #fef0f0, #fff)",
            "borderRadius": "8px",
            "padding": "16px"
          }
        },
        "children": [
          {
            "type": "r-statistic",
            "children": [],
            "id": "stats-rejected-count",
            "props": {
              "dataKey": "LeaveRequests@default@aggregateResult",
              "field": "rejectedCount",
              "precision": 0
            }
          }
        ]
      },
      {
        "type": "r-card",
        "id": "stats-total",
        "props": {
          "header": "请假总计",
          "bodyClass": "stats-card stats-card-total",
          "shadow": "hover",
          "bodyStyle": {
            "textAlign": "center",
            "borderLeft": "4px solid #409eff",
            "background": "linear-gradient(135deg, #ecf5ff, #fff)",
            "borderRadius": "8px",
            "padding": "16px"
          }
        },
        "children": [
          {
            "type": "r-statistic",
            "children": [],
            "id": "stats-total-count",
            "props": {
              "dataKey": "LeaveRequests@default@aggregateResult",
              "field": "totalCount",
              "precision": 0
            }
          }
        ]
      }
    ]
  },
  {
    "type": "r-table",
    "id": "leave-requests-table",
    "props": {
      "dataKey": "LeaveRequests@rows",
      "rowKey": "id",
      "highlightCurrentRow": true,
      "stripe": true,
      "border": true,
      "resizable": true,
      "filterCollapsible": true,
      "filterDefaultCollapsed": true,
      "filter": {
        "type": "r-filter",
        "props": {
          "collapsible": true,
          "defaultCollapsed": true,
          "itemSpan": 6
        },
        "id": "leave-filter",
        "children": [
          {
            "type": "r-select",
            "props": {
              "field": "status",
              "label": "状态",
              "placeholder": "全部状态",
              "clearable": true,
              "options": [
                {
                  "label": "待审批",
                  "value": "pending"
                },
                {
                  "label": "已通过",
                  "value": "approved"
                },
                {
                  "label": "已拒绝",
                  "value": "rejected"
                },
                {
                  "label": "已取消",
                  "value": "cancelled"
                }
              ],
              "optionLabelField": "label",
              "optionValueField": "value"
            },
            "id": "filter-status",
            "children": []
          },
          {
            "type": "r-text",
            "props": {
              "field": "department",
              "label": "部门",
              "placeholder": "请输入部门",
              "clearable": true
            },
            "id": "filter-department",
            "children": []
          },
          {
            "type": "r-date",
            "props": {
              "field": "startDate",
              "label": "日期范围",
              "dateType": "daterange",
              "startPlaceholder": "开始日期",
              "endPlaceholder": "结束日期",
              "rangeSeparator": "至",
              "filterMode": "range"
            },
            "id": "filter-date-range",
            "children": []
          }
        ]
      },
      "toolbar": {
        "type": "r-toolbar",
        "props": {},
        "id": "leave-toolbar",
        "children": [
          {
            "type": "r-button",
            "props": {
              "label": "新增请假",
              "action": "append-row",
              "template": "primary",
              "icon": "Plus"
            },
            "id": "btn-add",
            "children": []
          },
          {
            "type": "r-button",
            "props": {
              "label": "刷新",
              "action": "refresh",
              "template": "default",
              "icon": "Refresh"
            },
            "id": "btn-refresh",
            "children": []
          }
        ]
      },
      "actions": {
        "type": "r-toolbar",
        "id": "leave-actions",
        "props": {
          "width": 400,
          "align": "center",
          "fixed": "right"
        },
        "children": [
          {
            "type": "r-button",
            "id": "action-view",
            "props": {
              "label": "查看",
              "action": "onActionViewClick",
              "template": "text"
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "action-approve",
            "props": {
              "label": "审批",
              "action": "onActionApproveClick",
              "template": "text",
              "color": "#409EFF"
            },
            "children": []
          },
          {
            "type": "r-button",
            "props": {
              "label": "编辑",
              "action": "prompt-edit",
              "template": "text"
            },
            "id": "action-edit",
            "children": []
          },
          {
            "type": "r-button",
            "props": {
              "label": "删除",
              "action": "delete-row",
              "template": "text",
              "color": "#F56C6C"
            },
            "id": "action-delete",
            "children": []
          }
        ]
      }
    },
    "children": [
      {
        "type": "r-text",
        "children": [],
        "id": "col-employeeName",
        "props": {
          "field": "employeeName",
          "label": "申请人",
          "sortable": true,
          "width": 120
        }
      },
      {
        "type": "r-text",
        "children": [],
        "id": "col-department",
        "props": {
          "field": "department",
          "label": "部门",
          "sortable": true,
          "width": 120
        }
      },
      {
        "type": "r-select",
        "children": [],
        "id": "col-leaveTypeId",
        "props": {
          "field": "leaveTypeId",
          "label": "假期类型",
          "optionKey": "LeaveTypes@rows",
          "optionLabelField": "name",
          "optionValueField": "id",
          "width": 120,
          "readonly": true
        }
      },
      {
        "type": "r-date",
        "children": [],
        "id": "col-startDate",
        "props": {
          "field": "startDate",
          "label": "开始日期",
          "width": 120,
          "readonly": true
        }
      },
      {
        "type": "r-date",
        "children": [],
        "id": "col-endDate",
        "props": {
          "field": "endDate",
          "label": "结束日期",
          "width": 120,
          "readonly": true
        }
      },
      {
        "type": "r-number",
        "children": [],
        "id": "col-totalDays",
        "props": {
          "field": "totalDays",
          "label": "天数",
          "width": 80,
          "sortable": true
        }
      },
      {
        "type": "display-tag",
        "children": [],
        "id": "col-status",
        "props": {
          "field": "status",
          "label": "状态",
          "width": 100,
          "dynamicType": {
            "pending": "warning",
            "approved": "success",
            "rejected": "danger",
            "cancelled": "info"
          },
          "size": "small"
        }
      },
      {
        "type": "r-text",
        "children": [],
        "id": "col-approver",
        "props": {
          "field": "approver",
          "label": "审批人",
          "width": 100
        }
      },
      {
        "type": "r-date",
        "children": [],
        "id": "col-createdAt",
        "props": {
          "field": "createdAt",
          "label": "创建时间",
          "width": 160,
          "readonly": true,
          "format": "YYYY-MM-DD HH:mm"
        }
      }
    ]
  },
  {
    "type": "r-dialog",
    "children": [
      {
        "type": "r-form",
        "children": [
          {
            "type": "r-text",
            "children": [],
            "id": "form-employeeName",
            "props": {
              "field": "employeeName",
              "label": "申请人",
              "placeholder": "请输入申请人姓名",
              "required": true,
              "width": 200
            }
          },
          {
            "type": "r-text",
            "children": [],
            "id": "form-department",
            "props": {
              "field": "department",
              "label": "部门",
              "placeholder": "请输入部门",
              "width": 200
            }
          },
          {
            "type": "r-select",
            "children": [],
            "id": "form-leaveTypeId",
            "props": {
              "field": "leaveTypeId",
              "label": "假期类型",
              "optionKey": "LeaveTypes@rows",
              "optionLabelField": "name",
              "optionValueField": "id",
              "placeholder": "请选择假期类型",
              "required": true,
              "width": 200
            }
          },
          {
            "type": "r-date",
            "children": [],
            "id": "form-startDate",
            "props": {
              "field": "startDate",
              "label": "开始日期",
              "dateType": "date",
              "placeholder": "请选择开始日期",
              "required": true,
              "width": 200
            }
          },
          {
            "type": "r-date",
            "children": [],
            "id": "form-endDate",
            "props": {
              "field": "endDate",
              "label": "结束日期",
              "dateType": "date",
              "placeholder": "请选择结束日期",
              "required": true,
              "width": 200
            }
          },
          {
            "type": "r-number",
            "children": [],
            "id": "form-totalDays",
            "props": {
              "field": "totalDays",
              "label": "天数",
              "placeholder": "请输入天数",
              "required": true,
              "min": 0.5,
              "precision": 1,
              "width": 200
            }
          },
          {
            "type": "r-textarea",
            "children": [],
            "id": "form-reason",
            "props": {
              "field": "reason",
              "label": "请假原因",
              "placeholder": "请输入请假原因",
              "rows": 3,
              "width": 400
            }
          }
        ],
        "id": "leave-form",
        "props": {
          "dataKey": "LeaveRequests@currentRow",
          "labelWidth": "100px",
          "gridColumns": 24,
          "gridGap": "16px"
        }
      },
      {
        "type": "r-footer",
        "children": [
          {
            "type": "r-button",
            "children": [],
            "id": "form-btn-cancel",
            "props": {
              "label": "取消",
              "action": "clear-rows",
              "template": "default"
            }
          },
          {
            "type": "r-button",
            "children": [],
            "id": "form-btn-submit",
            "props": {
              "label": "提交",
              "action": "submit-current-form",
              "template": "primary"
            }
          }
        ],
        "id": "leave-form-footer"
      }
    ],
    "id": "leave-form-dialog",
    "props": {
      "title": "请假申请",
      "value": false,
      "width": "600px"
    }
  },
  {
    "type": "r-dialog",
    "children": [
      {
        "type": "r-form",
        "children": [
          {
            "type": "r-text",
            "children": [],
            "id": "aprv-employeeName",
            "props": {
              "field": "employeeName",
              "label": "申请人",
              "readonly": true,
              "width": 200
            }
          },
          {
            "type": "r-text",
            "children": [],
            "id": "aprv-department",
            "props": {
              "field": "department",
              "label": "部门",
              "readonly": true,
              "width": 200
            }
          },
          {
            "type": "r-text",
            "children": [],
            "id": "aprv-leaveType",
            "props": {
              "field": "leaveTypeId",
              "label": "假期类型",
              "readonly": true,
              "width": 200
            }
          },
          {
            "type": "r-date",
            "children": [],
            "id": "aprv-startDate",
            "props": {
              "field": "startDate",
              "label": "开始日期",
              "readonly": true,
              "width": 200
            }
          },
          {
            "type": "r-date",
            "children": [],
            "id": "aprv-endDate",
            "props": {
              "field": "endDate",
              "label": "结束日期",
              "readonly": true,
              "width": 200
            }
          },
          {
            "type": "r-number",
            "children": [],
            "id": "aprv-totalDays",
            "props": {
              "field": "totalDays",
              "label": "天数",
              "readonly": true,
              "width": 200
            }
          },
          {
            "type": "r-textarea",
            "children": [],
            "id": "aprv-reason",
            "props": {
              "field": "reason",
              "label": "请假原因",
              "readonly": true,
              "rows": 2,
              "width": 400
            }
          },
          {
            "type": "r-textarea",
            "children": [],
            "id": "aprv-opinion",
            "props": {
              "field": "comment",
              "label": "审批意见",
              "placeholder": "请输入审批意见",
              "rows": 3,
              "width": 400
            }
          }
        ],
        "id": "approve-form",
        "props": {
          "dataKey": "LeaveRequests@currentRow",
          "labelWidth": "100px",
          "gridColumns": 24,
          "gridGap": "16px"
        }
      },
      {
        "type": "r-footer",
        "children": [
          {
            "type": "r-button",
            "children": [],
            "id": "aprv-btn-reject",
            "props": {
              "label": "拒绝",
              "action": "onAprvBtnRejectClick",
              "template": "default",
              "color": "#F56C6C"
            }
          },
          {
            "type": "r-button",
            "children": [],
            "id": "aprv-btn-approve",
            "props": {
              "label": "通过",
              "action": "onAprvBtnApproveClick",
              "template": "primary"
            }
          }
        ],
        "id": "approve-footer"
      }
    ],
    "id": "approve-dialog",
    "props": {
      "title": "审批请假",
      "value": false,
      "width": "500px"
    }
  }
]