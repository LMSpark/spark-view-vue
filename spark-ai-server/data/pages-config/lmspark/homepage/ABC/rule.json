[
  {
    "type": "div",
    "children": [
      {
        "type": "h2",
        "children": [
          "学生成绩管理"
        ]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "style": {
            "marginBottom": "16px"
          },
          "title": "管理学生成绩信息，支持查看、新增、编辑和删除操作。",
          "closable": false,
          "showIcon": true
        }
      },
      {
        "type": "div",
        "children": [
          {
            "type": "el-button",
            "children": [
              "新增成绩"
            ],
            "props": {
              "type": "primary",
              "on": {
                "click": "handleAdd"
              },
              "size": "small"
            }
          },
          {
            "type": "el-button",
            "children": [
              "编辑成绩"
            ],
            "props": {
              "type": "success",
              "on": {
                "click": "handleEdit"
              },
              "size": "small"
            }
          },
          {
            "type": "el-button",
            "children": [
              "删除成绩"
            ],
            "props": {
              "type": "danger",
              "on": {
                "click": "handleDelete"
              },
              "size": "small"
            }
          }
        ],
        "props": {
          "style": {
            "marginBottom": "16px",
            "display": "flex",
            "gap": "8px"
          }
        }
      },
      {
        "type": "el-table",
        "children": [
          {
            "type": "el-table-column",
            "props": {
              "prop": "id",
              "label": "ID",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "name",
              "label": "学生姓名",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "gender",
              "label": "性别",
              "width": "80"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "subject",
              "label": "科目",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "score",
              "label": "成绩",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "grade",
              "label": "等级",
              "width": "100"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "examDate",
              "label": "考试日期",
              "width": "120"
            }
          },
          {
            "type": "el-table-column",
            "props": {
              "prop": "teacher",
              "label": "授课教师",
              "width": "120"
            }
          }
        ],
        "props": {
          "border": true,
          "stripe": true,
          "highlightCurrentRow": true,
          "dataKey": "Students@rows",
          "on": {
            "currentChange": "handleCurrentChange"
          }
        }
      },
      {
        "type": "el-divider",
        "children": [
          "成绩详情"
        ],
        "props": {
          "contentPosition": "left"
        }
      },
      {
        "type": "r-detail",
        "children": [
          {
            "type": "r-text",
            "props": {
              "label": "学生姓名",
              "field": "name"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "性别",
              "field": "gender"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "科目",
              "field": "subject"
            }
          },
          {
            "type": "r-number",
            "props": {
              "label": "成绩",
              "min": 0,
              "max": 100,
              "field": "score"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "等级",
              "field": "grade"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "考试日期",
              "field": "examDate"
            }
          },
          {
            "type": "r-text",
            "props": {
              "label": "授课教师",
              "field": "teacher"
            }
          }
        ],
        "props": {
          "labelWidth": "100px",
          "dataKey": "Students@currentRow"
        }
      }
    ],
    "props": {
      "class": "page-container",
      "style": {
        "padding": "20px"
      }
    }
  }
]
