[
  {
    "type": "r-card",
    "id": "card_main",
    "props": {
      "header": "工作评价",
      "shadow": "always"
    },
    "children": [
      {
        "type": "r-form",
        "id": "form_evaluation",
        "props": {
          "labelWidth": "120px",
          "gridColumns": 24,
          "gridGap": 12
        },
        "children": [
          {
            "type": "r-select",
            "id": "field_employee",
            "props": {
              "field": "employee",
              "label": "被评价人",
              "placeholder": "请选择被评价人",
              "options": [
                {
                  "label": "张三",
                  "value": "zhangsan"
                },
                {
                  "label": "李四",
                  "value": "lisi"
                },
                {
                  "label": "王五",
                  "value": "wangwu"
                },
                {
                  "label": "赵六",
                  "value": "zhaoliu"
                }
              ],
              "optionLabelField": "label",
              "optionValueField": "value",
              "clearable": true
            },
            "children": []
          },
          {
            "type": "r-select",
            "id": "field_dimension",
            "props": {
              "field": "dimension",
              "label": "评价维度",
              "placeholder": "请选择评价维度",
              "options": [
                {
                  "label": "工作态度",
                  "value": "attitude"
                },
                {
                  "label": "业务能力",
                  "value": "ability"
                },
                {
                  "label": "团队协作",
                  "value": "teamwork"
                },
                {
                  "label": "创新思维",
                  "value": "innovation"
                },
                {
                  "label": "综合表现",
                  "value": "overall"
                }
              ],
              "optionLabelField": "label",
              "optionValueField": "value",
              "clearable": true
            },
            "children": []
          },
          {
            "type": "r-rate",
            "id": "field_score",
            "props": {
              "field": "score",
              "label": "评分",
              "max": 5,
              "allowHalf": true,
              "clearable": true
            },
            "children": []
          },
          {
            "type": "r-switch",
            "id": "field_excellent",
            "props": {
              "field": "isExcellent",
              "label": "优秀员工",
              "activeText": "是",
              "inactiveText": "否"
            },
            "children": []
          },
          {
            "type": "r-textarea",
            "id": "field_comment",
            "props": {
              "field": "comment",
              "label": "评价内容",
              "placeholder": "请输入详细的评价内容...",
              "rows": 4,
              "maxlength": 500,
              "showWordLimit": true
            },
            "children": []
          },
          {
            "type": "r-button",
            "id": "btn_submit",
            "props": {
              "label": "提交评价",
              "template": "primary",
              "action": "submit-current-form"
            },
            "children": []
          }
        ]
      }
    ]
  },
  {
    "type": "div",
    "id": "div__0_0",
    "children": [
      {
        "type": "h2",
        "id": "h2__0_0_0",
        "children": [
          "工作评价"
        ]
      },
      {
        "type": "p",
        "id": "p__0_0_1",
        "children": [
          "页面配置就绪，请编辑 rule.json 设计页面布局。"
        ]
      }
    ]
  }
]
