[
  {
    "type": "div",
    "class": "ej2-demo-page",
    "children": [
      {
        "type": "div",
        "class": "page-header",
        "children": [
          {
            "type": "h1",
            "children": ["⚡ EJ2 Grid 演示 - 企业级功能"]
          },
          {
            "type": "p",
            "class": "description",
            "children": ["体验 Syncfusion EJ2 强大的企业级表格功能：分页、排序、过滤、Excel 导出等"]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h2",
            "children": ["📊 员工信息表（基础功能）"]
          },
          {
            "type": "ejs-grid",
            "dataKey": "users",
            "props": {
              "height": 350,
              "allowPaging": true,
              "allowSorting": true,
              "allowFiltering": false,
              "pageSettings": { "pageSize": 5, "pageSizes": [5, 10, 20] },
              "gridLines": "Both"
            },
            "children": [
              {
                "type": "e-columns",
                "children": [
                  {
                    "type": "e-column",
                    "props": {
                      "field": "id",
                      "headerText": "ID",
                      "width": 80,
                      "textAlign": "Right"
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "name",
                      "headerText": "姓名",
                      "width": 120
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "age",
                      "headerText": "年龄",
                      "width": 80,
                      "textAlign": "Right"
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "department",
                      "headerText": "部门",
                      "width": 120
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "salary",
                      "headerText": "薪资",
                      "width": 120,
                      "format": "C0",
                      "textAlign": "Right"
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "joinDate",
                      "headerText": "入职日期",
                      "width": 140,
                      "format": "yMd",
                      "type": "date"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h2",
            "children": ["🚀 订单信息表（高级功能）"]
          },
          {
            "type": "p",
            "class": "feature-list",
            "children": ["✅ Excel 导出  ✅ PDF 导出  ✅ 高级过滤  ✅ 列选择器"]
          },
          {
            "type": "ejs-grid",
            "dataKey": "orders",
            "props": {
              "height": 400,
              "allowPaging": true,
              "allowSorting": true,
              "allowFiltering": true,
              "allowExcelExport": true,
              "allowPdfExport": true,
              "showColumnChooser": true,
              "toolbar": ["ExcelExport", "PdfExport", "Search", "ColumnChooser"],
              "pageSettings": { "pageSize": 5, "pageSizes": [5, 10, 20, "All"] },
              "filterSettings": { "type": "Excel" },
              "gridLines": "Both"
            },
            "children": [
              {
                "type": "e-columns",
                "children": [
                  {
                    "type": "e-column",
                    "props": {
                      "field": "orderId",
                      "headerText": "订单号",
                      "width": 100,
                      "textAlign": "Right"
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "customerName",
                      "headerText": "客户名称",
                      "width": 150
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "amount",
                      "headerText": "订单金额",
                      "width": 120,
                      "format": "C0",
                      "textAlign": "Right"
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "orderDate",
                      "headerText": "下单日期",
                      "width": 140,
                      "format": "yMd",
                      "type": "date"
                    }
                  },
                  {
                    "type": "e-column",
                    "props": {
                      "field": "status",
                      "headerText": "订单状态",
                      "width": 120
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
