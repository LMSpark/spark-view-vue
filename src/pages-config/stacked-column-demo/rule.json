{
  "type": "div",
  "class": "stacked-column-demo-page",
  "children": [
    {
      "type": "h2",
      "children": ["EJ2 堆叠列组件演示"]
    },
    {
      "type": "p",
      "style": { "marginBottom": "20px", "color": "#606266" },
      "children": ["演示 EJ2StackedColumnRenderer 组件：不绑定字段的标签列，支持多层嵌套"]
    },
    
    {
      "type": "h3",
      "style": { "marginTop": "30px" },
      "children": ["示例 1：基础堆叠列（两层结构）"]
    },
    {
      "type": "ej2-table",
      "id": "grid1",
      "dataKey": "orderData",
      "allowPaging": true,
      "pageSettings": { "pageSize": 5 },
      "allowSorting": true,
      "allowFiltering": true,
      "on": {
        "dataBound": "dataBound",
        "queryCellInfo": "queryCellInfo",
        "recordDoubleClick": "handleRowDoubleClick"
      },
      "children": [
        {
          "field": "OrderID",
          "headerText": "Order ID",
          "width": 120,
          "textAlign": "Right",
          "isPrimaryKey": true
        },
        {
          "type": "ej2-stacked-column",
          "headerText": "客户信息",
          "textAlign": "Center",
          "children": [
            {
              "field": "CustomerID",
              "headerText": "客户代码",
              "width": 120
            },
            {
              "field": "CustomerName",
              "headerText": "客户姓名",
              "width": 150
            }
          ]
        },
        {
          "type": "ej2-stacked-column",
          "headerText": "配送信息",
          "textAlign": "Center",
          "children": [
            {
              "field": "ShipCity",
              "headerText": "城市",
              "width": 120
            },
            {
              "field": "ShipCountry",
              "headerText": "国家",
              "width": 120
            },
            {
              "field": "Freight",
              "headerText": "运费",
              "width": 100,
              "format": "C2",
              "textAlign": "Right"
            }
          ]
        }
      ]
    },

    {
      "type": "h3",
      "style": { "marginTop": "40px" },
      "children": ["示例 2：三层嵌套堆叠列"]
    },
    {
      "type": "ej2-table",
      "id": "grid2",
      "dataKey": "orderData",
      "allowPaging": true,
      "pageSettings": { "pageSize": 5 },
      "allowSorting": true,
      "on": {
        "dataBound": "dataBound",
        "queryCellInfo": "queryCellInfo"
      },
      "children": [
        {
          "field": "OrderID",
          "headerText": "Order ID",
          "width": 120,
          "textAlign": "Right",
          "isPrimaryKey": true
        },
        {
          "type": "ej2-stacked-column",
          "headerText": "订单详情",
          "textAlign": "Center",
          "children": [
            {
              "type": "ej2-stacked-column",
              "headerText": "客户信息",
              "textAlign": "Center",
              "children": [
                {
                  "field": "CustomerID",
                  "headerText": "代码",
                  "width": 100
                },
                {
                  "field": "CustomerName",
                  "headerText": "姓名",
                  "width": 130
                }
              ]
            },
            {
              "field": "OrderDate",
              "headerText": "订单日期",
              "width": 130,
              "format": "yMd",
              "textAlign": "Center"
            }
          ]
        },
        {
          "type": "ej2-stacked-column",
          "headerText": "配送与支付",
          "textAlign": "Center",
          "children": [
            {
              "type": "ej2-stacked-column",
              "headerText": "配送",
              "textAlign": "Center",
              "children": [
                {
                  "field": "ShipCity",
                  "headerText": "城市",
                  "width": 110
                },
                {
                  "field": "ShipCountry",
                  "headerText": "国家",
                  "width": 110
                }
              ]
            },
            {
              "type": "ej2-stacked-column",
              "headerText": "费用与状态",
              "textAlign": "Center",
              "children": [
                {
                  "field": "Freight",
                  "headerText": "运费",
                  "width": 100,
                  "format": "C2",
                  "textAlign": "Right"
                },
                {
                  "field": "Status",
                  "headerText": "状态",
                  "width": 110,
                  "textAlign": "Center"
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "type": "h3",
      "style": { "marginTop": "40px" },
      "children": ["示例 3：混合使用堆叠列和普通列"]
    },
    {
      "type": "ej2-table",
      "id": "grid3",
      "dataKey": "orderData",
      "allowPaging": true,
      "pageSettings": { "pageSize": 5 },
      "allowResizing": true,
      "allowSorting": true,
      "toolbar": ["ExcelExport", "PdfExport"],
      "allowExcelExport": true,
      "allowPdfExport": true,
      "on": {
        "dataBound": "dataBound",
        "queryCellInfo": "queryCellInfo",
        "toolbarClick": "handleToolbarClick"
      },
      "children": [
        {
          "field": "OrderID",
          "headerText": "ID",
          "width": 100,
          "textAlign": "Right",
          "isPrimaryKey": true
        },
        {
          "field": "OrderDate",
          "headerText": "日期",
          "width": 120,
          "format": "yMd",
          "textAlign": "Center"
        },
        {
          "type": "ej2-stacked-column",
          "headerText": "客户",
          "textAlign": "Center",
          "children": [
            {
              "field": "CustomerID",
              "headerText": "代码",
              "width": 100
            },
            {
              "field": "CustomerName",
              "headerText": "姓名",
              "width": 140
            }
          ]
        },
        {
          "field": "ShipCity",
          "headerText": "城市",
          "width": 120
        },
        {
          "type": "ej2-stacked-column",
          "headerText": "业务状态",
          "textAlign": "Center",
          "children": [
            {
              "field": "Status",
              "headerText": "配送",
              "width": 110
            },
            {
              "field": "PaymentStatus",
              "headerText": "付款",
              "width": 110
            }
          ]
        },
        {
          "field": "Freight",
          "headerText": "运费",
          "width": 100,
          "format": "C2",
          "textAlign": "Right"
        }
      ]
    }
  ]
}
