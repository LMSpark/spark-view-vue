                }
              },
              {
                "type": "e-column",
                "props": {
                  "field": "Freight",
                  "headerText": "Freight",
                  "width": 120,
                  "format": "C2",
                  "textAlign": "Right"
                }
              },
              {
                "type": "e-column",
                "props": {
                  "field": "ShipCity",
