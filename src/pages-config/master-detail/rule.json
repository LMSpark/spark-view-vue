[
  {
    "type": "div",
    "class": "master-detail-container",
    "style": { "padding": "20px" },
    "children": [
      {
        "type": "h1",
        "children": ["Master-Detail 演示"]
      },
      {
        "type": "p",
        "style": { "color": "#666", "marginBottom": "20px" },
        "children": ["点击用户行，自动加载该用户的订单（零代码，内核自动处理）"]
      },

      {
        "type": "div",
        "class": "section",
        "style": { "marginBottom": "30px" },
        "children": [
          {
            "type": "h2",
            "children": ["👥 用户列表 (Master)"]
          },
          {
            "type": "el-table",
            "dataKey": "dataset.tables.Users.rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "children": [
              {
                "type": "el-table-column",
                "props": { "prop": "id", "label": "用户ID", "width": "100" }
              },
              {
                "type": "el-table-column",
                "props": { "prop": "name", "label": "姓名", "width": "150" }
              },
              {
                "type": "el-table-column",
                "props": { "prop": "email", "label": "邮箱" }
              }
            ]
          }
        ]
      },

      {
        "type": "div",
        "class": "section",
        "style": { "marginBottom": "30px" },
        "children": [
          {
            "type": "h2",
            "children": ["📋 当前用户详情 (currentRow)"]
          },
          {
            "type": "el-card",
            "props": { "shadow": "hover" },
            "children": [
              {
                "type": "div",
                "children": [
                  {
                    "type": "p",
                    "children": [
                      {
                        "type": "strong",
                        "children": ["dataKey: "]
                      },
                      "dataset.tables.Users.currentRow"
                    ]
                  },
                  {
                    "type": "pre",
                    "dataKey": "dataset.tables.Users.currentRow",
                    "style": { "background": "#f5f5f5", "padding": "10px", "borderRadius": "4px" }
                  }
                ]
              }
            ]
          }
        ]
      },

      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "h2",
            "children": ["📦 订单列表 (Detail - currentRow 依赖)"]
          },
          {
            "type": "p",
            "style": { "color": "#999", "fontSize": "14px" },
            "children": ["自动加载 + 自动过滤（基于 Users.currentRow）"]
          },
          {
            "type": "el-table",
            "dataKey": "dataset.tables.Orders.rows",
            "props": {
              "border": true,
              "stripe": true,
              "emptyText": "请先选择用户"
            },
            "children": [
              {
                "type": "el-table-column",
                "props": { "prop": "id", "label": "订单ID", "width": "100" }
              },
              {
                "type": "el-table-column",
                "props": { "prop": "product", "label": "产品", "width": "200" }
              },
              {
                "type": "el-table-column",
                "props": { "prop": "amount", "label": "金额", "width": "120" }
              }
            ]
          }
        ]
      }
    ]
  }
]
