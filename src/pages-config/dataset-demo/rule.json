[
  {
    "type": "div",
    "class": "dataset-demo",
    "children": [
      {
        "type": "h1",
        "children": ["DataSet 主从表演示"]
      },
      {
        "type": "el-alert",
        "props": {
          "type": "info",
          "closable": false,
          "showIcon": true
        },
        "children": [
          "点击用户表的任意行，下方订单表将自动显示该用户的订单。选中订单后，订单明细表将显示对应商品。"
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "h2",
            "children": ["用户列表（父表）"]
          },
          {
            "type": "el-table",
            "dataKey": "dataset.tables.Users.rows",
            "props": {
              "border": true,
              "stripe": true,
              "highlightCurrentRow": true
            },
            "on": {
              "currentChange": "handleUserSelect"
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "id",
                  "label": "用户ID",
                  "width": "100"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "name",
                  "label": "姓名",
                  "width": "120"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "email",
                  "label": "邮箱"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "status",
                  "label": "状态",
                  "width": "100"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "div",
            "class": "section-header",
            "children": [
              {
                "type": "h2",
                "children": ["订单列表（子表 - 根据选中用户过滤）"]
              },
              {
                "type": "div",
                "class": "info-badge",
                "children": [
                  {
                    "type": "span",
                    "children": ["当前用户: "],
                    "dataKey": "currentUser.label"
                  },
                  {
                    "type": "span",
                    "children": [" | 订单数: "],
                    "dataKey": "currentUser.orderCount"
                  }
                ]
              }
            ]
          },
          {
            "type": "el-table",
            "dataKey": "filteredOrders",
            "props": {
              "border": true,
              "stripe": true
            },
            "on": {
              "selectionChange": "handleOrderSelect"
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "type": "selection",
                  "width": "55"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "orderNo",
                  "label": "订单号",
                  "width": "120"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "amount",
                  "label": "金额",
                  "width": "120"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "status",
                  "label": "状态",
                  "width": "120"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "date",
                  "label": "日期"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "div",
            "class": "section-header",
            "children": [
              {
                "type": "h2",
                "children": ["订单明细（孙表 - 根据选中订单过滤）"]
              },
              {
                "type": "div",
                "class": "info-badge",
                "children": [
                  {
                    "type": "span",
                    "children": ["已选订单数: "],
                    "dataKey": "selectedOrdersCount"
                  }
                ]
              }
            ]
          },
          {
            "type": "el-table",
            "dataKey": "filteredOrderItems",
            "props": {
              "border": true,
              "stripe": true
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "orderId",
                  "label": "订单ID",
                  "width": "100"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "productName",
                  "label": "商品名称"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "quantity",
                  "label": "数量",
                  "width": "100"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "price",
                  "label": "单价",
                  "width": "100"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "debug-section",
        "children": [
          {
            "type": "h3",
            "children": ["调试信息"]
          },
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "size": "small"
            },
            "on": {
              "click": "showSQLQuery"
            },
            "children": ["显示 SQL 查询"]
          },
          {
            "type": "el-button",
            "props": {
              "type": "success",
              "size": "small"
            },
            "on": {
              "click": "showMongoQuery"
            },
            "children": ["显示 MongoDB 查询"]
          },
          {
            "type": "el-button",
            "props": {
              "type": "info",
              "size": "small"
            },
            "on": {
              "click": "exportDataSet"
            },
            "children": ["导出 DataSet"]
          }
        ]
      }
    ]
  }
]
