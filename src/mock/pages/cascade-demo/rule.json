[
  {
    "type": "div",
    "class": "cascade-demo-container",
    "children": [
    {
      "type": "div",
      "class": "demo-header",
      "children": [
        {
          "type": "h2",
          "children": ["级联操作演示 (Cascade Demo)"]
        },
        {
          "type": "p",
          "children": ["演示 cascadeUpdate 和 cascadeDelete 功能"]
        }
      ]
    },
    
    {
      "type": "div",
      "class": "demo-section",
      "children": [
        {
          "type": "h3",
          "children": ["用户表 (Users)"]
        },
        {
          "type": "el-table",
          "props": {
            "data": [],
            "dataKey": "dataset.tables.0.rows",
            "border": true,
            "stripe": true
          },
          "children": [
            {
              "type": "el-table-column",
              "props": { "prop": "id", "label": "用户ID", "width": "100" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "name", "label": "姓名", "width": "150" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "email", "label": "邮箱" }
            },
            {
              "type": "el-table-column",
              "props": { "label": "操作", "width": "250" },
              "children": [
                {
                  "type": "template",
                  "props": { "slot": "default", "scope": "scope" },
                  "children": [
                    {
                      "type": "el-button",
                      "props": { "size": "small", "type": "primary" },
                      "on": { "click": "handleUpdateUserId" },
                      "children": ["修改ID (测试级联更新)"]
                    },
                    {
                      "type": "el-button",
                      "props": { "size": "small", "type": "danger" },
                      "on": { "click": "handleDeleteUser" },
                      "children": ["删除 (测试级联删除)"]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    
    {
      "type": "div",
      "class": "demo-section",
      "children": [
        {
          "type": "h3",
          "children": ["订单表 (Orders) - 级联更新/删除目标"]
        },
        {
          "type": "el-table",
          "props": {
            "data": [],
            "dataKey": "dataset.tables.1.rows",
            "border": true,
            "stripe": true
          },
          "children": [
            {
              "type": "el-table-column",
              "props": { "prop": "id", "label": "订单ID", "width": "100" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "userId", "label": "用户ID", "width": "100" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "orderNo", "label": "订单号", "width": "150" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "amount", "label": "金额" }
            }
          ]
        }
      ]
    },
    
    {
      "type": "div",
      "class": "demo-section",
      "children": [
        {
          "type": "h3",
          "children": ["订单明细表 (OrderItems) - 级联删除目标"]
        },
        {
          "type": "el-table",
          "props": {
            "data": [],
            "dataKey": "dataset.tables.2.rows",
            "border": true,
            "stripe": true
          },
          "children": [
            {
              "type": "el-table-column",
              "props": { "prop": "id", "label": "明细ID", "width": "100" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "orderId", "label": "订单ID", "width": "100" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "productName", "label": "产品名称" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "quantity", "label": "数量", "width": "80" }
            },
            {
              "type": "el-table-column",
              "props": { "prop": "price", "label": "单价", "width": "100" }
            }
          ]
        }
      ]
    },
    
    {
      "type": "div",
      "class": "demo-info",
      "children": [
        {
          "type": "el-alert",
          "props": {
            "title": "使用说明",
            "type": "info",
            "showIcon": true
          },
          "children": [
            {
              "type": "div",
              "children": [
                "1. 点击「修改ID」将触发 cascadeUpdate，订单表的 userId 会自动同步更新",
                { "type": "br" },
                "2. 点击「删除」将触发 cascadeDelete，会递归删除该用户的所有订单和订单明细",
                { "type": "br" },
                "3. 打开控制台查看详细的级联操作日志"
              ]
            }
          ]
        }
      ]
    }
  ]
  }
]
