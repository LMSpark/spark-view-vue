{
  "dataset": {
    "dataSetName": "CascadeDemo",
    "version": 1,
    "tables": [
      {
        "tableName": "Users",
        "columns": [
          { "columnName": "id", "dataType": "number", "isPrimaryKey": true },
          { "columnName": "name", "dataType": "string" },
          { "columnName": "email", "dataType": "string" }
        ],
        "rows": [
          { "id": 1, "name": "Alice", "email": "alice@example.com" },
          { "id": 2, "name": "Bob", "email": "bob@example.com" }
        ]
      },
      {
        "tableName": "Orders",
        "columns": [
          { "columnName": "id", "dataType": "number", "isPrimaryKey": true },
          { "columnName": "userId", "dataType": "number" },
          { "columnName": "orderNo", "dataType": "string" },
          { "columnName": "amount", "dataType": "number" }
        ],
        "rows": [
          { "id": 101, "userId": 1, "orderNo": "ORD-001", "amount": 299.99 },
          { "id": 102, "userId": 1, "orderNo": "ORD-002", "amount": 149.50 },
          { "id": 103, "userId": 2, "orderNo": "ORD-003", "amount": 599.00 }
        ]
      },
      {
        "tableName": "OrderItems",
        "columns": [
          { "columnName": "id", "dataType": "number", "isPrimaryKey": true },
          { "columnName": "orderId", "dataType": "number" },
          { "columnName": "productName", "dataType": "string" },
          { "columnName": "quantity", "dataType": "number" },
          { "columnName": "price", "dataType": "number" }
        ],
        "rows": [
          { "id": 1001, "orderId": 101, "productName": "笔记本电脑", "quantity": 1, "price": 299.99 },
          { "id": 1002, "orderId": 102, "productName": "鼠标", "quantity": 2, "price": 49.75 },
          { "id": 1003, "orderId": 102, "productName": "键盘", "quantity": 1, "price": 99.50 },
          { "id": 1004, "orderId": 103, "productName": "显示器", "quantity": 1, "price": 599.00 }
        ]
      }
    ],
    "relations": [
      {
        "parentTable": "Users",
        "childTable": "Orders",
        "dependencyType": "allRows",
        "filterExpression": {
          "field": "userId",
          "op": "==",
          "value": { "func": "FIELD", "args": ["id"] }
        },
        "cascadeUpdate": true,
        "cascadeDelete": true,
        "relationName": "UserOrders"
      },
      {
        "parentTable": "Orders",
        "childTable": "OrderItems",
        "dependencyType": "allRows",
        "filterExpression": {
          "field": "orderId",
          "op": "==",
          "value": { "func": "FIELD", "args": ["id"] }
        },
        "cascadeDelete": true,
        "relationName": "OrderItems"
      }
    ]
  }
}
