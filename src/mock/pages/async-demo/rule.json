[
  {
    "type": "div",
    "class": "dashboard-page",
    "children": [
      {
        "type": "div",
        "class": "page-header",
        "children": [
          {
            "type": "h1",
            "children": ["异步数据加载演示"]
          },
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "icon": "Refresh"
            },
            "on": {
              "click": "refreshAllData"
            },
            "children": ["刷新所有数据"]
          }
        ]
      },
      {
        "type": "div",
        "class": "stats-container",
        "children": [
          {
            "type": "el-card",
            "props": {
              "shadow": "hover"
            },
            "children": [
              {
                "type": "div",
                "class": "stat-item",
                "children": [
                  {
                    "type": "div",
                    "class": "stat-label",
                    "children": ["总用户数"]
                  },
                  {
                    "type": "div",
                    "class": "stat-value",
                    "dataKey": "stats.totalUsers"
                  }
                ]
              }
            ]
          },
          {
            "type": "el-card",
            "props": {
              "shadow": "hover"
            },
            "children": [
              {
                "type": "div",
                "class": "stat-item",
                "children": [
                  {
                    "type": "div",
                    "class": "stat-label",
                    "children": ["今日订单"]
                  },
                  {
                    "type": "div",
                    "class": "stat-value",
                    "dataKey": "stats.todayOrders"
                  }
                ]
              }
            ]
          },
          {
            "type": "el-card",
            "props": {
              "shadow": "hover"
            },
            "children": [
              {
                "type": "div",
                "class": "stat-item",
                "children": [
                  {
                    "type": "div",
                    "class": "stat-label",
                    "children": ["总收入"]
                  },
                  {
                    "type": "div",
                    "class": "stat-value",
                    "dataKey": "stats.revenue"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "section",
        "children": [
          {
            "type": "div",
            "class": "section-header",
            "children": [
              {
                "type": "h2",
                "children": ["最近订单（异步加载）"]
              },
              {
                "type": "el-button",
                "props": {
                  "size": "small",
                  "icon": "Refresh"
                },
                "on": {
                  "click": "refreshOrders"
                },
                "children": ["刷新"]
              }
            ]
          },
          {
            "type": "el-table",
            "dataKey": "recentOrders",
            "props": {
              "border": true,
              "stripe": true
            },
            "children": [
              {
                "type": "el-table-column",
                "props": {
                  "prop": "orderNo",
                  "label": "订单号",
                  "width": "180"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "customer",
                  "label": "客户"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "amount",
                  "label": "金额"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "status",
                  "label": "状态"
                }
              },
              {
                "type": "el-table-column",
                "props": {
                  "prop": "date",
                  "label": "日期",
                  "width": "120"
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
