{
  "dataset": {
    "dataSetName": "SmartLoadDemo",
    "version": 1,
    "tables": {
      "Categories": {
        "tableName": "Categories",
        "columns": [
          { "columnName": "id", "dataType": "number", "isPrimaryKey": true },
          { "columnName": "name", "dataType": "string" }
        ],
        "rows": []
      },
      "Products": {
        "tableName": "Products",
        "columns": [
          { "columnName": "id", "dataType": "number", "isPrimaryKey": true },
          { "columnName": "categoryId", "dataType": "number" },
          { "columnName": "name", "dataType": "string" },
          { "columnName": "price", "dataType": "number" }
        ],
        "rows": []
      },
      "OrderDetails": {
        "tableName": "OrderDetails",
        "columns": [
          { "columnName": "id", "dataType": "number", "isPrimaryKey": true },
          { "columnName": "productId", "dataType": "number" },
          { "columnName": "quantity", "dataType": "number" }
        ],
        "rows": []
      }
    },
    "relations": [
      {
        "parentTable": "Categories",
        "childTable": "Products",
        "dependencyType": "allRows",
        "filterExpression": {
          "field": "categoryId",
          "op": "==",
          "value": { "func": "FIELD", "args": ["id"] }
        },
        "cascadeUpdate": true,
        "cascadeDelete": true,
        "relationName": "CategoryProducts"
      },
      {
        "parentTable": "Products",
        "childTable": "OrderDetails",
        "dependencyType": "allRows",
        "filterExpression": {
          "field": "productId",
          "op": "==",
          "value": { "func": "FIELD", "args": ["id"] }
        },
        "cascadeDelete": true,
        "relationName": "ProductOrders"
      }
    ]
  },
  "info": {
    "description": "智能依赖加载演示：OrderDetails → Products → Categories"
  }
}
