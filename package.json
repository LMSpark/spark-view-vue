{
    "name": "spark-view-architecture-prototype",
    "version": "0.3.0",
    "description": "SPARK 配置平台 - 深度配置 × 稳定运行时 × 受约束 AI 生成",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.13.0",
    "scripts": {
        "dev": "node scripts/start-dev.mjs",
        "dev:fe": "vite",
        "dev:api": "node tools/mock-config-api.mjs",
        "dev:full": "concurrently \"pnpm run dev\" \"pnpm run dev:api\"",
        "debug:dataset:remote": "node --import tsx scripts/verify-dataset-remote-load.mjs --pageId dynamic-columns --expectText DataView",
        "debug:sse:loop": "node --import tsx scripts/verify-sse-debug-loop.mjs --pageId section-grid-demo --path /t/lmspark/homepage/section-grid-demo --selector .section-grid-demo .el-table --iterations 2 --expectText 姓名",
        "debug:sse:loop:py": "python scripts/verify-sse-debug-loop.py --page-id section-grid-demo --path /t/lmspark/homepage/section-grid-demo --selector .section-grid-demo .el-table --iterations 2 --expect-text 姓名",
        "debug:sse:loop:py:visual": "python scripts/verify-sse-debug-loop.py --page-id section-grid-demo --path /t/lmspark/homepage/section-grid-demo --selector .section-grid-demo .el-table --iterations 2 --expect-text 姓名 --assert-visual-change --min-diff-ratio 0.0001",
        "search:value:noise": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/search-value-noise.ps1",
        "search:value:noise:summary": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/search-value-noise.ps1 -SummaryOnly",
        "start": "vite preview --port 5173",
        "build": "node scripts/build-all.mjs",
        "build:fe": "node scripts/build-frontend.mjs",
        "build:smart": "node scripts/build-frontend.mjs",
        "build:java": "node scripts/build-all.mjs --skip-fe",
        "build:no-upload": "node scripts/build-all.mjs --no-upload",
        "build:analyze": "cross-env ANALYZE=true node scripts/build-frontend.mjs",
        "generate:catalog": "pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/cli.ts",
        "generate:module-metadata": "pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/module-metadata-cli.ts",
        "upload:component-metadata": "node scripts/upload-component-metadata.mjs",
        "build:check": "pnpm run generate:catalog && pnpm run generate:module-metadata && vue-tsc --noEmit --skipLibCheck && node scripts/build-frontend.mjs",
        "typecheck": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:ci": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:strict": "vue-tsc --noEmit --strict --skipLibCheck -p tsconfig.typecheck.json",
        "lint": "eslint --cache .",
        "lint:ci": "eslint --cache \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:strict": "eslint --cache \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:fix": "eslint --cache . --fix",
        "preview": "vite preview --port 5173",
        "test": "vitest",
        "test:run": "vitest run",
        "test:all": "pnpm run build:packages && pnpm run test:run && pnpm run test:packages:run",
        "verify:arch": "node tools/verify-architecture.mjs",
        "verify:ai-codegen": "node tools/verify-ai-codegen-rules.mjs",
        "verify:vcm-comments": "node tools/verify-vcm-llm-comments.mjs",
        "verify:docs": "node tools/verify-docs.mjs",
        "verify:rules": "pnpm run verify:arch && pnpm run verify:ai-codegen && pnpm run verify:vcm-comments && pnpm run verify:docs",
        "verify:ai:page-design-form:llm": "node --import tsx scripts/verify-page-design-e2e.mjs",
        "verify:ai:page-design-leave:llm": "node --import tsx scripts/verify-page-design-e2e.mjs",
        "migrate:nav:nodekind": "node scripts/migrate-nav-nodekind.mjs",
        "verify": "pnpm run build:packages && pnpm run typecheck && pnpm run lint && pnpm run verify:rules",
        "commitlint": "commitlint --edit",
        "build:packages": "pnpm --filter 'packages/*' run build",
        "publish:packages": "node scripts/publish-packages.mjs",
        "publish:dry": "node scripts/publish-packages.mjs --dry-run",
        "lint:packages": "pnpm --filter 'packages/*' run lint",
        "lint:fix:packages": "pnpm --filter 'packages/*' run lint:fix",
        "test:packages": "pnpm --filter 'packages/*' run test",
        "test:packages:run": "pnpm --filter './packages/**' run test:run",
        "typecheck:packages": "pnpm --filter 'packages/*' run typecheck",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "changeset": "changeset",
        "version:packages": "changeset version",
        "release": "changeset publish",
        "generate": "plop",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": "eslint --cache --no-warn-ignored",
        "*.vue": "eslint --cache --no-warn-ignored"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@spark-view/spark-app": "workspace:*",
        "@spark-view/spark-component": "workspace:*",
        "@spark-view/spark-data": "workspace:*",
        "@spark-view/spark-project-model": "workspace:*",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.15.0",
        "element-plus": "^2.13.7",
        "html2canvas": "^1.4.1",
        "vue": "3.5.32",
        "vue-markdown-render": "^2.3.0",
        "vue-router": "^5.0.4",
        "vxe-table": "^4.18.11"
    },
    "devDependencies": {
        "@changesets/cli": "^2.30.0",
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^10.0.1",
        "@rollup/rollup-win32-x64-msvc": "^4.60.1",
        "@spark-view/vite-plugin-spark-catalog": "workspace:*",
        "@storybook/vue3": "^10.3.5",
        "@storybook/vue3-vite": "^10.3.5",
        "@types/node": "^25.6.0",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "@typescript-eslint/parser": "^8.58.1",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vue/language-core": "3.2.6",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "eslint": "^10.2.0",
        "eslint-plugin-vue": "^10.8.0",
        "express": "^5.2.1",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "lint-staged": "^16.4.0",
        "plop": "^4.0.5",
        "rollup-plugin-visualizer": "^7.0.1",
        "storybook": "^10.3.5",
        "terser": "^5.46.1",
        "tsx": "^4.21.0",
        "typescript": "~6.0.2",
        "vite": "^8.0.8",
        "vitest": "^4.1.4",
        "vue-component-meta": "3.2.6",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.6"
    },
    "pnpm": {
        "overrides": {
            "rollup": "^4.57.1",
            "vue": "3.5.32",
            "@vue/runtime-core": "3.5.32",
            "@vue/runtime-dom": "3.5.32",
            "@vue/reactivity": "3.5.32",
            "@vue/shared": "3.5.32",
            "@vue/compiler-core": "3.5.32",
            "@vue/compiler-dom": "3.5.32",
            "@vue/compiler-sfc": "3.5.32",
            "@vue/server-renderer": "3.5.32"
        }
    }
}
