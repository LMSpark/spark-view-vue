{
    "name": "spark-view-architecture-prototype",
    "version": "0.2.0",
    "description": "SPARK 架构原型 - 能力分层 × 职责解耦 × 上下文契约",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:api": "node tools/mock-config-api.mjs",
        "dev:full": "concurrently \"pnpm run dev\" \"pnpm run dev:api\"",
        "start": "vite preview --port 5173",
        "build": "vite build",
        "build:analyze": "cross-env ANALYZE=true vite build",
        "build:check": "vue-tsc --noEmit --skipLibCheck && vite build",
        "typecheck": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:ci": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:strict": "vue-tsc --noEmit --strict --skipLibCheck -p tsconfig.typecheck.json",
        "lint": "eslint .",
        "lint:ci": "eslint \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:strict": "eslint \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview --port 5173",
        "test": "vitest",
        "test:contract": "vitest run tests/contract",
        "verify:arch": "node tools/verify-architecture.mjs",
        "verify": "pnpm run typecheck && pnpm run lint && pnpm run verify:arch"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run lint -- --max-warnings=100 && npm run typecheck"
        }
    },
    "lint-staged": {
        "**/*.{ts,vue,js}": [
            "eslint --fix"
        ]
    },
    "prepare": "husky install",
    "dependencies": {
        "@form-create/element-ui": "^3.2.37",
        "@spark-view/spark-app": "workspace:*",
        "@spark-view/spark-component": "workspace:*",
        "@spark-view/spark-data": "workspace:*",
        "@spark-view/spark-page-config": "workspace:*",
        "@spark-view/spark-renderer": "workspace:*",
        "@syncfusion/ej2-base": "^32.1.24",
        "@syncfusion/ej2-grids": "^32.1.24",
        "@syncfusion/ej2-vue-grids": "^32.1.24",
        "axios": "^1.13.5",
        "element-plus": "^2.5.0",
        "vue": "^3.5.27",
        "vue-docgen-api": "^4.79.2",
        "vue-router": "^4.6.4",
        "vxe-table": "^4.17.47"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@rollup/rollup-win32-x64-msvc": "^4.57.1",
        "@types/node": "^18.19.130",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^8.2.2",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.2",
        "eslint-plugin-vue": "^10.7.0",
        "express": "^5.2.1",
        "glob": "^13.0.1",
        "husky": "^8.0.0",
        "jsdom": "^25.0.1",
        "lint-staged": "^14.0.0",
        "rollup-plugin-visualizer": "^6.0.5",
        "terser": "^5.46.0",
        "typescript": "~5.3.3",
        "vite": "^7.3.1",
        "vitest": "^2.1.8",
        "vue-eslint-parser": "^10.2.0",
        "vue-tsc": "^3.2.2"
    }
}