{
    "name": "spark-view-architecture-prototype",
    "version": "0.3.0",
    "description": "SPARK 架构原型 - 能力分层 × 职责解耦 × 上下文契约",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.13.0",
    "scripts": {
        "dev": "node scripts/start-dev.mjs",
        "dev:fe": "vite",
        "dev:api": "node tools/mock-config-api.mjs",
        "dev:full": "concurrently \"pnpm run dev\" \"pnpm run dev:api\"",
        "start": "vite preview --port 5173",
        "build": "node scripts/build-all.mjs",
        "build:fe": "cross-env BUILD_MODE=smart vite build",
        "build:smart": "cross-env BUILD_MODE=smart vite build",
        "build:classic": "cross-env BUILD_MODE=classic vite build",
        "build:java": "node scripts/build-all.mjs --skip-fe",
        "build:no-upload": "node scripts/build-all.mjs --no-upload",
        "build:analyze": "cross-env ANALYZE=true BUILD_MODE=smart vite build",
        "build:analyze:classic": "cross-env ANALYZE=true BUILD_MODE=classic vite build",
        "build:check": "vue-tsc --noEmit --skipLibCheck && cross-env BUILD_MODE=smart vite build",
        "typecheck": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:ci": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:strict": "vue-tsc --noEmit --strict --skipLibCheck -p tsconfig.typecheck.json",
        "lint": "eslint .",
        "lint:ci": "eslint \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:strict": "eslint \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview --port 5173",
        "test": "vitest",
        "test:run": "vitest run",
        "test:all": "pnpm run build:packages && pnpm run test:run && pnpm run test:packages:run",
        "verify:arch": "node tools/verify-architecture.mjs",
        "migrate:nav:nodekind": "node scripts/migrate-nav-nodekind.mjs",
        "verify": "pnpm run build:packages && pnpm run typecheck && pnpm run lint && pnpm run verify:arch",
        "commitlint": "commitlint --edit",
        "build:packages": "pnpm --filter 'packages/*' run build",
        "publish:packages": "node scripts/publish-packages.mjs",
        "publish:dry": "node scripts/publish-packages.mjs --dry-run",
        "lint:packages": "pnpm --filter 'packages/*' run lint",
        "lint:fix:packages": "pnpm --filter 'packages/*' run lint:fix",
        "test:packages": "pnpm --filter 'packages/*' run test",
        "test:packages:run": "pnpm --filter './packages/**' run test:run",
        "typecheck:packages": "pnpm --filter 'packages/*' run typecheck",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "changeset": "changeset",
        "version:packages": "changeset version",
        "release": "changeset publish",
        "generate": "plop",
        "prepare": "husky"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@form-create/element-ui": "^3.2.37",
        "@spark-view/spark-app": "workspace:*",
        "@spark-view/spark-component": "workspace:*",
        "@spark-view/spark-data": "workspace:*",
        "@spark-view/spark-page-config": "workspace:*",
        "@syncfusion/ej2-base": "^32.2.6",
        "@syncfusion/ej2-grids": "^32.2.7",
        "@syncfusion/ej2-vue-grids": "^32.2.7",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.13.5",
        "element-plus": "^2.13.2",
        "highlight.js": "^11.11.1",
        "html2canvas": "^1.4.1",
        "marked": "^17.0.4",
        "vue": "^3.5.29",
        "vue-markdown-render": "^2.3.0",
        "vue-router": "^5.0.3",
        "vxe-table": "^4.17.48"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@commitlint/cli": "^20.4.2",
        "@commitlint/config-conventional": "^20.4.2",
        "@eslint/js": "^10.0.1",
        "@rollup/rollup-win32-x64-msvc": "^4.59.0",
        "@storybook/vue3": "^10.2.12",
        "@storybook/vue3-vite": "^10.2.12",
        "@types/node": "^25.3.0",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "eslint": "^10.0.2",
        "eslint-plugin-vue": "^10.8.0",
        "express": "^5.2.1",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "jsdom": "^28.1.0",
        "plop": "^4.0.5",
        "rollup-plugin-visualizer": "^7.0.0",
        "storybook": "^10.2.12",
        "terser": "^5.46.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.5"
    },
    "pnpm": {
        "overrides": {
            "rollup": "^4.57.1",
            "vue": "3.5.29",
            "@vue/runtime-core": "3.5.29",
            "@vue/runtime-dom": "3.5.29",
            "@vue/reactivity": "3.5.29",
            "@vue/shared": "3.5.29",
            "@vue/compiler-core": "3.5.29",
            "@vue/compiler-dom": "3.5.29",
            "@vue/compiler-sfc": "3.5.29",
            "@vue/server-renderer": "3.5.29"
        }
    }
}