{
    "name": "spark-appworks",
    "version": "0.3.0",
    "description": "SPARK 配置平台 - 深度配置 × 稳定运行时 × 受约束 AI 生成",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.34.1",
    "scripts": {
        "dev": "node scripts/start-dev.mjs",
        "dev:fe": "vite",
        "dev:api": "node tools/mock-config-api.mjs",
        "dev:full": "concurrently \"pnpm run dev\" \"pnpm run dev:api\"",
        "search:value:noise": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/search-value-noise.ps1",
        "search:value:noise:summary": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/search-value-noise.ps1 -SummaryOnly",
        "start": "vite preview --port 5273",
        "build": "node scripts/build-all.mjs",
        "build:fe": "node scripts/build-frontend.mjs",
        "build:smart": "node scripts/build-frontend.mjs",
        "build:java": "node scripts/build-all.mjs --skip-fe",
        "build:analyze": "cross-env ANALYZE=true node scripts/build-frontend.mjs",
        "generate:module-metadata": "pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/module-metadata-cli.ts",
        "generate:vcm-metadata": "pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/module-metadata-cli.ts -- --target project-model && pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/module-metadata-cli.ts -- --target project-page-surface",
        "generate:component-catalog": "pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/cli.ts",
        "diagnose:module-metadata": "pnpm exec tsx --no-cache packages/vite-plugin-spark-catalog/src/module-metadata-cli.ts --diagnose-only",
        "build:check": "pnpm run generate:module-metadata && vue-tsc --noEmit --skipLibCheck && node scripts/build-frontend.mjs",
        "typecheck": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:ci": "vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
        "typecheck:strict": "vue-tsc --noEmit --strict --skipLibCheck -p tsconfig.typecheck.json",
        "lint": "eslint --cache .",
        "lint:ci": "eslint --cache \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:strict": "eslint --cache \"**/*.{ts,vue,js}\" --max-warnings=0",
        "lint:fix": "eslint --cache . --fix",
        "preview": "vite preview --port 5273",
        "test": "vitest",
        "test:run": "vitest run",
        "test:all": "pnpm run build:packages && pnpm run test:run && pnpm run test:packages:run",
        "verify:arch": "node tools/verify-architecture.mjs",
        "verify:ai-codegen": "node tools/verify-ai-codegen-rules.mjs",
        "verify:docs": "node tools/verify-docs.mjs",
        "verify:vcm-native": "pnpm --filter @spark-appworks/vite-plugin-spark-catalog run typecheck && pnpm run generate:module-metadata && pnpm --filter @spark-appworks/spark-ai run lint && pnpm --filter @spark-appworks/spark-ai run typecheck && pnpm exec vitest run packages/spark-ai/src/vcm-native/tests/class-model.test.ts packages/vite-plugin-spark-catalog/src/tests/module-metadata-generator.test.ts packages/vite-plugin-spark-catalog/src/tests/module-api-registry-compact.test.ts packages/vite-plugin-spark-catalog/src/tests/module-schema-pool.test.ts",
        "verify:vcm-native:full": "pnpm --filter @spark-appworks/spark-utils run build && pnpm --filter @spark-appworks/spark-json-document run build && pnpm --filter @spark-appworks/spark-data run build && pnpm --filter @spark-appworks/spark-project-model run build && pnpm run generate:module-metadata -- --verify-build-consistency && pnpm --filter @spark-appworks/spark-ai run build && pnpm run verify:vcm-native && pnpm run typecheck",
        "verify:rules": "pnpm run verify:arch && pnpm run verify:ai-codegen && pnpm run verify:docs",
        "migrate:nav:nodekind": "node scripts/migrate-nav-nodekind.mjs",
        "verify": "pnpm run build:packages && pnpm run typecheck && pnpm run lint && pnpm run verify:rules",
        "commitlint": "commitlint --edit",
        "build:packages": "pnpm --filter 'packages/*' run build",
        "publish:packages": "node scripts/publish-packages.mjs",
        "publish:dry": "node scripts/publish-packages.mjs --dry-run",
        "lint:packages": "pnpm --filter 'packages/*' run lint",
        "lint:fix:packages": "pnpm --filter 'packages/*' run lint:fix",
        "test:packages": "pnpm --filter 'packages/*' run test",
        "test:packages:run": "pnpm --filter './packages/**' run test:run",
        "typecheck:packages": "pnpm --filter 'packages/*' run typecheck",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "changeset": "changeset",
        "version:packages": "changeset version",
        "release": "changeset publish",
        "generate": "plop",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": "eslint --cache --no-warn-ignored",
        "*.vue": "eslint --cache --no-warn-ignored"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@spark-appworks/spark-app": "workspace:*",
        "@spark-appworks/spark-component": "workspace:*",
        "@spark-appworks/spark-data": "workspace:*",
        "@spark-appworks/spark-project-model": "workspace:*",
        "@vueuse/core": "^14.3.0",
        "axios": "^1.17.0",
        "element-plus": "^2.14.1",
        "html2canvas": "^1.4.1",
        "vue": "3.5.35",
        "vue-markdown-render": "^2.3.0",
        "vue-router": "^5.1.0",
        "vxe-table": "^4.19.7"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@commitlint/cli": "^21.0.2",
        "@commitlint/config-conventional": "^21.0.2",
        "@eslint/js": "^10.0.1",
        "@rollup/rollup-win32-x64-msvc": "^4.61.1",
        "@spark-appworks/vite-plugin-spark-catalog": "workspace:*",
        "@storybook/vue3": "^10.4.1",
        "@storybook/vue3-vite": "^10.4.1",
        "@types/node": "^25.9.1",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/language-core": "3.3.3",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^10.0.3",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "express": "^5.2.1",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "jmespath": "0.16.0",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.7",
        "plop": "^4.0.5",
        "rollup-plugin-visualizer": "^7.0.1",
        "storybook": "^10.4.2",
        "terser": "^5.48.0",
        "tsx": "^4.22.4",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.8",
        "vue-component-meta": "3.3.3",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.3"
    },
    "pnpm": {
        "overrides": {
            "rollup": "^4.61.1",
            "vue": "3.5.35",
            "@vue/runtime-core": "3.5.35",
            "@vue/runtime-dom": "3.5.35",
            "@vue/reactivity": "3.5.35",
            "@vue/shared": "3.5.35",
            "@vue/compiler-core": "3.5.35",
            "@vue/compiler-dom": "3.5.35",
            "@vue/compiler-sfc": "3.5.35",
            "@vue/server-renderer": "3.5.35"
        }
    }
}
