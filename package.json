{
  "name": "form-create-app",
  "version": "1.0.0",
  "description": "Form Create Application with TypeScript and Vue 3",
  "type": "module",
  "author": "",
  "license": "MIT",
  "keywords": [
    "form-create",
    "vue3",
    "typescript",
    "element-plus",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite preview --port 3000",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "@form-create/element-ui": "^3.2.0",
    "element-plus": "^2.5.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "vxe-table": "^4.17.42",
    "xe-utils": "^3.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "tsx": "^4.21.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vite-plugin-mock": "^3.0.2",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
