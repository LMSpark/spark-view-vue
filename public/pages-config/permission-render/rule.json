[
  {
    "type": "div",
    "style": {
      "padding": "20px"
    },
    "children": [
      {
        "type": "el-alert",
        "props": {
          "title": "✅ 核心理念：后端返回数据时已包含权限信息，前端直接根据权限字段控制 UI",
          "type": "success",
          "closable": false,
          "description": "演示：切换不同用户，查看不同的数据和操作权限（_perm、_modelPerm）"
        },
        "style": {
          "marginBottom": "20px"
        }
      },
      {
        "type": "el-card",
        "style": {
          "marginBottom": "20px"
        },
        "children": [
          {
            "type": "h3",
            "children": [
              "用户切换"
            ]
          },
          {
            "type": "el-radio-group",
            "field": "currentUser",
            "value": "user1",
            "on": {
              "change": "handleSwitchUser"
            },
            "children": [
              {
                "type": "el-radio",
                "props": {
                  "value": "user1"
                },
                "children": [
                  "员工（只看部分数据）"
                ]
              },
              {
                "type": "el-radio",
                "props": {
                  "value": "manager"
                },
                "children": [
                  "经理（看更多数据）"
                ]
              },
              {
                "type": "el-radio",
                "props": {
                  "value": "admin"
                },
                "children": [
                  "管理员（完整权限）"
                ]
              }
            ]
          },
          {
            "type": "el-button",
            "props": {
              "type": "primary",
              "style": "margin-left: 20px"
            },
            "on": {
              "click": "handleLoadData"
            },
            "children": [
              "加载数据"
            ]
          }
        ]
      },
      {
        "type": "RenderAddButton"
      },
      {
        "type": "RenderTable"
      }
    ]
  }
]