[
  {
    "type": "div",
    "class": "renderer-demo-page",
    "children": [
      {
        "type": "h1",
        "children": [
          "Renderer 架构演示"
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h2",
            "children": [
              "表格渲染示例"
            ]
          },
          {
            "type": "r-table",
            "dataSource": "users",
            "props": {
              "border": true,
              "stripe": true
            },
            "children": [
              {
                "type": "r-text",
                "props": {
                  "name": "姓名",
                  "value": "name",
                  "width": 150
                }
              },
              {
                "type": "r-number",
                "props": {
                  "name": "年龄",
                  "value": "age",
                  "width": 100
                }
              },
              {
                "type": "r-date",
                "props": {
                  "name": "创建时间",
                  "value": "createTime",
                  "width": 150
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h2",
            "children": [
              "表单渲染示例"
            ]
          },
          {
            "type": "r-form",
            "dataKey": "formData",
            "props": {
              "labelWidth": "100px"
            },
            "children": [
              {
                "type": "r-text",
                "props": {
                  "name": "姓名",
                  "value": "name"
                }
              },
              {
                "type": "r-number",
                "props": {
                  "name": "年龄",
                  "value": "age",
                  "min": 0,
                  "max": 150
                }
              },
              {
                "type": "r-date",
                "props": {
                  "name": "创建时间",
                  "value": "createTime"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "div",
        "class": "demo-section",
        "children": [
          {
            "type": "h2",
            "children": [
              "详情展示示例"
            ]
          },
          {
            "type": "r-detail",
            "dataKey": "formData",
            "class": "detail-container",
            "children": [
              {
                "type": "r-text",
                "props": {
                  "name": "姓名",
                  "value": "name"
                }
              },
              {
                "type": "r-number",
                "props": {
                  "name": "年龄",
                  "value": "age"
                }
              },
              {
                "type": "r-date",
                "props": {
                  "name": "创建时间",
                  "value": "createTime"
                }
              }
            ]
          }
        ]
      }
    ]
  }
]