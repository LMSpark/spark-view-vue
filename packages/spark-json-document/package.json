{
  "name": "@spark-appworks/spark-json-document",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Generic JSON document editing engine with JSON Schema types, construction, validation, and UUID-stable tree mutations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spark-appworks/spark-utils": "workspace:*",
    "ajv": "^8.20.0",
    "jmespath": "0.16.0"
  },
  "devDependencies": {
    "@types/jmespath": "^0.15.2",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
