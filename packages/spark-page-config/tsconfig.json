{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true,
    "paths": {
      "@spark-view/spark-ai": ["../spark-ai/src/index.ts"],
      "@spark-view/spark-ai/schema": ["../spark-ai/src/schema/index.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/src/host/index.ts"],
      "@spark-view/spark-ai/module-semantic": ["../spark-ai/src/module-semantic/index.ts"],
      "@spark-view/spark-page-config": ["./src/index.ts"],
      "@spark-view/spark-page-config/page/model": ["./src/page/model/index.ts"],
      "@spark-view/spark-page-config/page/loading": ["./src/page/loading/index.ts"],
      "@spark-view/spark-page-config/capabilities": ["./src/capabilities/index.ts"],
      "@spark-view/spark-page-config/page/navigation": ["./src/page/navigation/index.ts"],
      "@spark-view/spark-page-config/page/sandbox": ["./src/page/sandbox/index.ts"],
      "@spark-view/spark-page-config/page/services": ["./src/page/services/index.ts"],
      "@spark-view/spark-page-config/registrations": ["./src/registrations/index.ts"],
      "@spark-view/spark-page-config/registrations/payloads/component-catalog.json": ["./src/registrations/payloads/component-catalog.json"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
