{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false,
    "paths": {
      "@spark-view/spark-ai": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/schema": ["../spark-ai/dist/schema/index.d.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/dist/host/index.d.ts"],
      "@spark-view/spark-ai/module-semantic": ["../spark-ai/dist/module-semantic/index.d.ts"],
      "@spark-view/spark-page-config": ["./src/index.ts"],
      "@spark-view/spark-page-config/config": ["./src/config/index.ts"],
      "@spark-view/spark-page-config/node-tree": ["./src/node-tree/index.ts"],
      "@spark-view/spark-page-config/navigation": ["./src/navigation/index.ts"],
      "@spark-view/spark-page-config/runtime": ["./src/runtime/index.ts"],
      "@spark-view/spark-page-config/json-document": ["./src/json-document/index.ts"],
      "@spark-view/spark-page-config/design": ["./src/design/index.ts"],
      "@spark-view/spark-page-config/ai": ["./src/ai/index.ts"],
      "@spark-view/spark-page-config/ai/payloads/component-catalog.json": ["./src/ai/payloads/component-catalog.json"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "dist", "node_modules"]
}
