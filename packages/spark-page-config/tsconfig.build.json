{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false,
    "paths": {
      "@spark-view/spark-ai": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/json": ["../spark-ai/dist/json/index.d.ts"],
      "@spark-view/spark-ai/agent": ["../spark-ai/dist/agent/index.d.ts"],
      "@spark-view/spark-ai/modules": ["../spark-ai/dist/modules/index.d.ts"],
      "@spark-view/spark-page-config": ["./src/index.ts"],
      "@spark-view/spark-page-config/project": ["./src/project.ts"],
      "@spark-view/spark-page-config/ai": ["./src/ai.ts"],
      "@spark-view/spark-page-config/leave-request": ["./src/leave-request/index.ts"],
      "@spark-view/spark-page-config/json-document": ["./src/json-document-public.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "dist", "node_modules"]
}
