{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false,
    "paths": {
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "dist", "node_modules"]
}
