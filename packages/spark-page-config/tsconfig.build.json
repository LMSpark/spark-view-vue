{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false,
    "paths": {
      "@spark-view/spark-ai": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/protocol": ["../spark-ai/dist/protocol/index.d.ts"],
      "@spark-view/spark-ai/core": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/dist/host/index.d.ts"],
      "@spark-view/spark-page-config": ["./src/index.ts"],
      "@spark-view/spark-page-config/page/model": ["./src/page/model/index.ts"],
      "@spark-view/spark-page-config/page/loading": ["./src/page/loading/index.ts"],
      "@spark-view/spark-page-config/page/workspace": ["./src/page/workspace/index.ts"],
      "@spark-view/spark-page-config/page/navigation": ["./src/page/navigation/index.ts"],
      "@spark-view/spark-page-config/page/sandbox": ["./src/page/sandbox/index.ts"],
      "@spark-view/spark-page-config/page/services": ["./src/page/services/index.ts"],
      "@spark-view/spark-page-config/assistant/registrations": ["./src/assistant/registrations/index.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "dist", "node_modules"]
}
