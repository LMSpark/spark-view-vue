{
  "name": "@spark-view/spark-page-config",
  "version": "0.3.6",
  "type": "module",
  "license": "MIT",
  "description": "SPARK 页面配置层 - 支持本地/远程配置加载、动态路由注册、配置缓存和验证",
  "keywords": [
    "spark",
    "page-config",
    "dynamic-routes",
    "configuration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page/index.d.ts",
      "import": "./dist/page/index.js"
    },
    "./page/model": {
      "types": "./dist/page/model/index.d.ts",
      "import": "./dist/page/model/index.js"
    },
    "./page/loading": {
      "types": "./dist/page/loading/index.d.ts",
      "import": "./dist/page/loading/index.js"
    },
    "./page/workspace": {
      "types": "./dist/page/workspace/index.d.ts",
      "import": "./dist/page/workspace/index.js"
    },
    "./page/navigation": {
      "types": "./dist/page/navigation/index.d.ts",
      "import": "./dist/page/navigation/index.js"
    },
    "./page/sandbox": {
      "types": "./dist/page/sandbox/index.d.ts",
      "import": "./dist/page/sandbox/index.js"
    },
    "./assistant": {
      "types": "./dist/assistant/index.d.ts",
      "import": "./dist/assistant/index.js"
    },
    "./assistant/registrations": {
      "types": "./dist/assistant/registrations/index.d.ts",
      "import": "./dist/assistant/registrations/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@spark-view/spark-ai": "workspace:*",
    "@spark-view/spark-data": "workspace:*",
    "@spark-view/spark-utils": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
