{
  "name": "@spark-view/spark-page-config",
  "version": "0.3.3",
  "type": "module",
  "description": "SPARK 页面配置层 - 支持本地/远程配置加载、动态路由注册、配置缓存和验证",
  "keywords": [
    "spark",
    "page-config",
    "dynamic-routes",
    "configuration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "peerDependencies": {},
  "dependencies": {
    "@spark-view/spark-data": "^0.4.0",
    "@spark-view/spark-utils": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^10.0.2",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}