{
    "name": "@spark-view/spark-page-config",
    "version": "0.1.0",
    "type": "module",
    "description": "SPARK 页面配置层 - 支持本地/远程配置加载、动态路由注册、配置缓存和验证",
    "keywords": [
        "spark",
        "page-config",
        "dynamic-routes",
        "configuration"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "lint": "eslint src --ext .ts"
    },
    "peerDependencies": {
        "vue": "^3.5.0",
        "vue-router": "^4.0.0"
    },
    "dependencies": {
        "@spark-view/spark-utils": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^18.19.130",
        "rimraf": "^6.1.2",
        "typescript": "~5.3.3",
        "vitest": "^2.1.8"
    }
}