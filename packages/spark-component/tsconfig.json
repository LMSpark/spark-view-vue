{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "../..",
    "paths": {
      "@spark-view/spark-component": ["./src/index.ts"],
      "@spark-view/spark-utils": ["../spark-utils/src/index.ts"],
      "@spark-view/spark-data": ["../spark-data/src/index.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/page/model": ["../spark-page-config/src/page/model/index.ts"],
      "@spark-view/spark-page-config/page/loading": ["../spark-page-config/src/page/loading/index.ts"],
      "@spark-view/spark-page-config/page/workspace": ["../spark-page-config/src/page/workspace/index.ts"],
      "@spark-view/spark-page-config/page/navigation": ["../spark-page-config/src/page/navigation/index.ts"],
      "@spark-view/spark-page-config/page/sandbox": ["../spark-page-config/src/page/sandbox/index.ts"],
      "@spark-view/spark-page-config/page/services": ["../spark-page-config/src/page/services/index.ts"],
      "@spark-view/spark-page-config/assistant/registrations": ["../spark-page-config/src/assistant/registrations/index.ts"],
      "@spark-view/spark-ai": ["../spark-ai/src/index.ts"],
      "@spark-view/spark-ai/protocol": ["../spark-ai/src/protocol/index.ts"],
      "@spark-view/spark-ai/core": ["../spark-ai/src/index.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/src/host/index.ts"]
    },
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "types": ["vite/client", "vitest/globals", "node"],
    "noEmit": true
  },
  "include": ["src/**/*", "*.stories.ts"],
  "exclude": ["node_modules", "dist"]
}
