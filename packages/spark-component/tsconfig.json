{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "../..",
    "paths": {
      "@spark-view/spark-component": ["./src/index.ts"],
      "@spark-view/spark-utils": ["../spark-utils/src/index.ts"],
      "@spark-view/spark-data": ["../spark-data/src/index.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/page/loading": ["../spark-page-config/src/page/loading.ts"],
      "@spark-view/spark-page-config/page/*": ["../spark-page-config/src/page/*"],
      "@spark-view/spark-page-config/capabilities/*": ["../spark-page-config/src/capabilities/*"],
      "@spark-view/spark-page-config/page/navigation": ["../spark-page-config/src/page/navigation.ts"],
      "@spark-view/spark-page-config/page/script-context-types": ["../spark-page-config/src/page/script-context-types.ts"],
      "@spark-view/spark-page-config/page/app-services": ["../spark-page-config/src/page/app-services.ts"],
      "@spark-view/spark-page-config/registrations": ["../spark-page-config/src/registrations/index.ts"],
      "@spark-view/spark-ai": ["../spark-ai/src/index.ts"],
      "@spark-view/spark-ai/schema": ["../spark-ai/src/schema/index.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/src/host/index.ts"],
      "@spark-view/spark-ai/module-semantic": ["../spark-ai/src/module-semantic/index.ts"]
    },
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "types": ["vite/client", "vitest/globals", "node"],
    "noEmit": true
  },
  "include": ["src/**/*", "*.stories.ts"],
  "exclude": ["node_modules", "dist"]
}
