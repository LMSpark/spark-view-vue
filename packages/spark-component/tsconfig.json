{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "../..",
    "paths": {
      "@spark-appworks/spark-component": ["./src/index.ts"],
      "@spark-appworks/spark-utils": ["../spark-utils/src/index.ts"],
      "@spark-appworks/spark-utils/internal": ["../spark-utils/dist/internal/index.d.ts"],
      "@spark-appworks/spark-data": ["../spark-data/src/index.ts"],
      "@spark-appworks/spark-project-model": ["../spark-project-model/src/index.ts"],
      "@spark-appworks/spark-json-document": ["../spark-json-document/src/index.ts"],
      "@spark-appworks/spark-project-model/project": ["../spark-project-model/src/project.ts"],
      "@spark-appworks/spark-project-model/ai": ["../spark-project-model/src/ai.ts"],
      "@spark-appworks/spark-ai": ["../spark-ai/src/index.ts"],
      "@spark-appworks/spark-ai/json": ["../spark-ai/src/json/index.ts"],
      "@spark-appworks/spark-ai/agent": ["../spark-ai/src/agent/index.ts"],
      "@spark-appworks/spark-ai/modules": ["../spark-ai/src/modules/index.ts"]
    },
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "types": ["vite/client", "vitest/globals", "node"],
    "noEmit": true
  },
  "include": ["src/**/*", "*.stories.ts"],
  "exclude": ["node_modules", "dist"]
}
