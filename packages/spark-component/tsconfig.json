{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@spark-view/spark-component": ["./src/index.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/dist/index.d.ts"]
    },
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true
  },
  "include": ["src/**/*", "*.stories.ts"],
  "exclude": ["node_modules", "dist"]
}
