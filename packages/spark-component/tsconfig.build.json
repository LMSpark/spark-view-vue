{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/dist/index.d.ts"],
      "@spark-view/spark-page-config/page/model": ["../spark-page-config/dist/page/model.d.ts"],
      "@spark-view/spark-page-config/page/loading": ["../spark-page-config/dist/page/loading.d.ts"],
      "@spark-view/spark-page-config/capabilities/*": ["../spark-page-config/dist/capabilities/*"],
      "@spark-view/spark-page-config/page/navigation": ["../spark-page-config/dist/page/navigation.d.ts"],
      "@spark-view/spark-page-config/page/sandbox": ["../spark-page-config/dist/page/sandbox.d.ts"],
      "@spark-view/spark-page-config/page/app-services": ["../spark-page-config/dist/page/app-services.d.ts"],
      "@spark-view/spark-page-config/registrations": ["../spark-page-config/dist/registrations/index.d.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "src/tests/**", "dist", "node_modules"]
}
