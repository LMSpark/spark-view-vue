{
  "name": "@spark-view/spark-component",
  "version": "0.4.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "license": "MIT",
  "description": "SPARK Component System - 组件核心（能力系统、组件管理器、组件注册表）",
  "files": [
    "dist",
    "API.md",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js}\" --fix"
  },
  "dependencies": {
    "@spark-view/spark-data": "workspace:*",
    "@spark-view/spark-page-config": "workspace:*",
    "@spark-view/spark-utils": "workspace:*"
  },
  "peerDependencies": {
    "element-plus": ">=2.0.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^10.0.2",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "undici-types": "^7.19.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.5.27"
  }
}
