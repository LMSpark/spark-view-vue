{
    "name": "@spark-view/spark-component",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "private": false,
    "description": "SPARK Component System - 组件核心（能力系统、组件管理器、组件注册表）",
    "files": [
        "dist",
        "src",
        "API.md",
        "README.md"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "lint": "eslint \"src/**/*.{ts,tsx,js}\" --max-warnings=0",
        "lint:fix": "eslint \"src/**/*.{ts,tsx,js}\" --fix",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@spark-view/spark-utils": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^18.19.130",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "eslint": "^9.39.2",
        "typescript": "~5.8.2",
        "undici-types": "^7.19.2",
        "vitest": "^2.1.8",
        "vue": "^3.5.27"
    }
}