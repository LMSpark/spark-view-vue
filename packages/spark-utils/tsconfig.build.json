{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "removeComments": false,
    "sourceMap": true,
    "inlineSources": false,
    "noEmitOnError": true,
    "composite": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.test.ts", 
    "**/*.spec.ts", 
    "dist",
    "node_modules",
    "src/**/__tests__/**"
  ]
}
