{
  "name": "@spark-view/spark-app",
  "version": "0.3.7",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "private": false,
  "license": "MIT",
  "description": "SPARK Application Layer - 应用层基础设施（AppContext、Router Guards、Error Boundary、Bootstrap）",
  "keywords": [
    "spark",
    "application",
    "context",
    "router",
    "bootstrap"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "dependencies": {
    "@spark-view/spark-ai": "workspace:*",
    "@spark-view/spark-component": "workspace:*",
    "@spark-view/spark-page-config": "workspace:*",
    "@spark-view/spark-utils": "workspace:*"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": ">=2.0.0",
    "@vueuse/core": ">=10.0.0",
    "element-plus": ">=2.5.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^10.0.2",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}