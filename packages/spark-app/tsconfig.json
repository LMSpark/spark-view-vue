{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "outDir": "dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true,
    "paths": {
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-utils/internal": ["../spark-utils/dist/internal/index.d.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-component": ["../spark-component/dist/index.d.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/config": ["../spark-page-config/src/config/index.ts"],
      "@spark-view/spark-page-config/node-tree": ["../spark-page-config/src/node-tree/index.ts"],
      "@spark-view/spark-page-config/navigation": ["../spark-page-config/src/navigation/index.ts"],
      "@spark-view/spark-page-config/runtime": ["../spark-page-config/src/runtime/index.ts"],
      "@spark-view/spark-page-config/json-document": ["../spark-page-config/src/json-document/index.ts"],
      "@spark-view/spark-page-config/design": ["../spark-page-config/src/design/index.ts"],
      "@spark-view/spark-page-config/ai": ["../spark-page-config/src/ai/index.ts"],
      "@spark-view/spark-page-config/ai/payloads/component-catalog.json": ["../spark-page-config/src/ai/payloads/component-catalog.json"],
      "@spark-view/spark-ai": ["../spark-ai/src/index.ts"],
      "@spark-view/spark-ai/schema": ["../spark-ai/src/schema/index.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/src/host/index.ts"],
      "@spark-view/spark-ai/module-semantic": ["../spark-ai/src/module-semantic/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.example.ts", "**/*.example.vue"]
}

