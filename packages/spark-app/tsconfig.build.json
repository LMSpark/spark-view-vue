{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-component": ["../spark-component/dist/index.d.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/dist/index.d.ts"]
    },
    "declarationDir": "./dist/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist",
    "node_modules"
  ]
}
