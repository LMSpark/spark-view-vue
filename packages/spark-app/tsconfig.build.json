{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-utils/internal": ["../spark-utils/dist/internal/index.d.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-component": ["../spark-component/dist/index.d.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/dist/index.d.ts"],
      "@spark-view/spark-ai": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/json": ["../spark-ai/dist/json/index.d.ts"],
      "@spark-view/spark-ai/agent": ["../spark-ai/dist/agent/index.d.ts"],
      "@spark-view/spark-ai/modules": ["../spark-ai/dist/modules/index.d.ts"]
    },
    "declarationDir": "./dist/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist",
    "node_modules"
  ]
}

