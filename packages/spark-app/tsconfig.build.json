{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-component": ["../spark-component/dist/index.d.ts"],
      "@spark-view/spark-page-config": ["../spark-page-config/dist/index.d.ts"],
      "@spark-view/spark-page-config/page/model": ["../spark-page-config/dist/page/model/index.d.ts"],
      "@spark-view/spark-page-config/page/loading": ["../spark-page-config/dist/page/loading/index.d.ts"],
      "@spark-view/spark-page-config/page/workspace": ["../spark-page-config/dist/page/workspace/index.d.ts"],
      "@spark-view/spark-page-config/page/navigation": ["../spark-page-config/dist/page/navigation/index.d.ts"],
      "@spark-view/spark-page-config/page/sandbox": ["../spark-page-config/dist/page/sandbox/index.d.ts"],
      "@spark-view/spark-page-config/page/services": ["../spark-page-config/dist/page/services/index.d.ts"],
      "@spark-view/spark-page-config/assistant/registrations": ["../spark-page-config/dist/assistant/registrations/index.d.ts"],
      "@spark-view/spark-ai": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/protocol": ["../spark-ai/dist/protocol/index.d.ts"],
      "@spark-view/spark-ai/core": ["../spark-ai/dist/index.d.ts"],
      "@spark-view/spark-ai/host": ["../spark-ai/dist/host/index.d.ts"]
    },
    "declarationDir": "./dist/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist",
    "node_modules"
  ]
}
