{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@spark-appworks/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-appworks/spark-json-document": ["../spark-json-document/dist/index.d.ts"],
      "@spark-appworks/spark-json-document/schema": ["../spark-json-document/dist/schema/index.d.ts"],
      "@spark-appworks/spark-json-document/tree": ["../spark-json-document/dist/tree/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
