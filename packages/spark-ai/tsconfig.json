{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true,
    "paths": {
      "@spark-view/spark-utils": ["../spark-utils/src/index.ts"],
      "@spark-view/spark-data": ["../spark-data/src/index.ts"],
      "@spark-view/spark-component": ["../spark-component/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
