{
  "name": "@spark-appworks/spark-ai",
  "version": "0.3.7",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "license": "MIT",
  "description": "Spark AI agent runtime - json schema, ClassModel tools, sessions, tool loop, and transport contracts",
  "keywords": [
    "spark",
    "ai",
    "agent",
    "class-model",
    "tool-calling",
    "json-schema",
    "sse"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json": {
      "types": "./dist/json/index.d.ts",
      "import": "./dist/json/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./class-model": {
      "types": "./dist/class-model/index.d.ts",
      "import": "./dist/class-model/index.js"
    }
  },
  "dependencies": {
    "@spark-appworks/spark-json-document": "workspace:*",
    "@spark-appworks/spark-utils": "workspace:*",
    "ajv": "^8.20.0",
    "comlink": "^4.4.2"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
