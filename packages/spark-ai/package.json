{
  "name": "@spark-view/spark-ai",
  "version": "0.3.7",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "license": "MIT",
  "description": "SPARK AI Layer - Function Calling 会话、组件知识目录、页面编辑工具运行时",
  "keywords": [
    "spark",
    "ai",
    "function-calling",
    "page-design",
    "component-catalog"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./services/page-design": {
      "import": "./dist/services/page-design/index.js",
      "types": "./dist/services/page-design/index.d.ts"
    },
    "./registrations": {
      "import": "./dist/registrations/index.js",
      "types": "./dist/registrations/index.d.ts"
    },
    "./registrations/page-design": {
      "import": "./dist/registrations/page-design/index.js",
      "types": "./dist/registrations/page-design/index.d.ts"
    },
    "./registrations/page-design/payloads": {
      "import": "./dist/registrations/page-design/payloads/index.js",
      "types": "./dist/registrations/page-design/payloads/index.d.ts"
    }
  },
  "dependencies": {
    "@spark-view/spark-data": "workspace:*",
    "@spark-view/spark-component": "workspace:*",
    "@spark-view/spark-page-config": "workspace:*",
    "@spark-view/spark-utils": "workspace:*",
    "@types/jmespath": "^0.15.2",
    "jmespath": "^0.16.0",
    "vue": "3.5.32"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
