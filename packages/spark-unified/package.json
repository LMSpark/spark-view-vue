{
    "name": "@spark-view/spark",
    "version": "1.0.0",
    "description": "SPARK unified namespace - 统一命名空间整合所有 SPARK 子包",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch"
    },
    "dependencies": {
        "@spark-view/spark-component": "workspace:*",
        "@spark-view/spark-data": "workspace:*",
        "@spark-view/spark-app": "workspace:*",
        "@spark-view/spark-utils": "workspace:*",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0"
    },
    "keywords": [
        "spark",
        "vue3",
        "component-system",
        "data-management",
        "unified-api"
    ],
    "author": "SPARK Team",
    "license": "MIT"
}