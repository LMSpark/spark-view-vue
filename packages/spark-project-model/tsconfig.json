{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true,
    "paths": {
      "@spark-view/spark-ai": ["../spark-ai/src/index.ts"],
      "@spark-view/spark-ai/json": ["../spark-ai/src/json/index.ts"],
      "@spark-view/spark-ai/agent": ["../spark-ai/src/agent/index.ts"],
      "@spark-view/spark-ai/modules": ["../spark-ai/src/modules/index.ts"],
      "@spark-view/spark-data": ["../spark-data/dist/types/index.d.ts"],
      "@spark-view/spark-utils": ["../spark-utils/dist/index.d.ts"],
      "@spark-view/spark-utils/internal": ["../spark-utils/dist/internal/index.d.ts"],
      "@spark-view/spark-project-model": ["./src/index.ts"],
      "@spark-view/spark-component/runtime": ["../spark-component/src/runtime/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
