{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "outDir": "./dist",
    "composite": false,
    "target": "ES2020",
    "noEmit": true,
    "paths": {
      "@spark-appworks/spark-data": ["../spark-data/src/index.ts"],
      "@spark-appworks/spark-utils": ["../spark-utils/src/index.ts"],
      "@spark-appworks/spark-utils/internal": ["../spark-utils/src/internal/index.ts"],
      "@spark-appworks/spark-project-model": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
