{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-appworks.local/schemas/vcm.schema.json",
  "title": "SPARK AppWorks VCM Registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol": {
      "const": "spark-appworks.vcm.registry"
    },
    "schemaVersion": {
      "const": 1
    },
    "componentCatalogOutput": {
      "type": "string",
      "minLength": 1,
      "description": "component-catalog CLI 输出路径；与 metadata target 解耦。"
    },
    "metadataTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "native-metadata"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["files"]
          },
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "className": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["className"]
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "distDir": {
                "type": "string",
                "minLength": 1,
                "description": "VCM dist 根目录；缺省时取 runtime 文件所在目录。"
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "jsdocTodoLog": {
                "type": "string",
                "minLength": 1
              },
              "componentCatalog": {
                "type": "string",
                "minLength": 1,
                "description": "已废弃：请使用根级 componentCatalogOutput。"
              }
            },
            "required": ["runtime", "jsdocTodoLog"]
          }
        },
        "required": ["id", "kind", "source", "roots", "outputs"]
      }
    }
  },
  "required": ["protocol", "schemaVersion", "metadataTargets"]
}
