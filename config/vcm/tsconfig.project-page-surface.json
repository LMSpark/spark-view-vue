{
  "$comment": "VCM declaration emit for target project-page-surface; include 须与 config/vcm/registry.json source.files 入口一致。",
  "extends": "../../tsconfig.catalog.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "stripInternal": true,
    "outDir": "../../generated/vcm/project-page-surface/tsc-declarations",
    "rootDir": "../.."
  },
  "include": [
    "../../packages/spark-project-model/src/project/project-model.ts",
    "../../packages/spark-project-model/src/page/config-page.ts",
    "../../packages/spark-data/src/dataset-crud-tool.ts",
    "../../packages/spark-data/src/data-table.ts",
    "../../packages/spark-data/src/data-view.ts",
    "../../packages/spark-data/src/node-tree/spark-node-tree.ts"
  ],
  "exclude": []
}
