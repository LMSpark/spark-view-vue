{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@root/*": ["../../../form-create-ssr-app/src/*"],
      "@spark-view/spark-core": ["./packages/spark-core/src/index.ts"],
      "@spark-view/spark-core/*": ["./packages/spark-core/src/*"]
    }
  },
  "include": [
    "src/**/*.ts", 
    "src/**/*.tsx", 
    "src/**/*.vue", 
    "src/**/*.d.ts", 
    "tests/**/*.ts", 
    "features/**/*.ts",
    "features/**/*.tsx",
    "features/**/*.vue",
    "features/**/*.d.ts",
    "shared/**/*.ts",
    "shared/**/*.tsx", 
    "shared/**/*.vue",
    "shared/**/*.d.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "plugins/**/*.vue", 
    "plugins/**/*.d.ts",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "pages/**/*.vue",
    "pages/**/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.vue",
    "app/**/*.d.ts",
    "./packages/spark-core/src/**/*.ts",
    ".vitepress/**/*.ts",
    "tools/**/*.ts",
    "vite.config.ts",
    "packages/spark-core/vitest.config.ts"
  ]
}