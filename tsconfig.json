{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": false,
    "skipDefaultLibCheck": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noErrorTruncation": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@spark-view/spark-utils": ["./packages/spark-utils/src/index.ts"],
      "@spark-view/spark-utils/*": ["./packages/spark-utils/src/*"],
      "@spark-view/spark-component": ["./packages/spark-component/src/index.ts"],
      "@spark-view/spark-component/*": ["./packages/spark-component/src/*"],
      "@spark-view/spark-data": ["./packages/spark-data/src/index.ts"],
      "@spark-view/spark-app": ["./packages/spark-app/src/index.ts"],
      "@spark-view/spark-app/*": ["./packages/spark-app/src/*"],
      "@spark-view/spark-page-config": ["./packages/spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/*": ["./packages/spark-page-config/src/*"],
      "@spark-view/spark-renderer": ["./packages/spark-renderer/src/index.ts"],
      "@spark-view/spark-renderer/*": ["./packages/spark-renderer/src/*"],
      "@/features/spark-ej2": ["./features/spark-ej2"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "features/**/*.ts",
    "features/**/*.tsx",
    "features/**/*.vue",
    "features/**/*.d.ts",
    "./packages/spark-component/src/**/*.ts",
    "vite.config.ts",
    "packages/spark-component/vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "obj",
    "**/*.md",
    "**/dist/**",
    "**/node_modules/**",
    "packages/**/examples/**",
    "tools/**"
  ]
}