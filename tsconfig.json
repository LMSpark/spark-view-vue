{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noErrorTruncation": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"],
      "@spark-view/spark-utils": ["./packages/spark-utils/src/index.ts"],
      "@spark-view/spark-utils/internal": ["./packages/spark-utils/src/internal/index.ts"],
      "@spark-view/spark-component": ["./packages/spark-component/src/index.ts"],
      "@spark-view/spark-data": ["./packages/spark-data/src/index.ts"],
      "@spark-view/spark-app": ["./packages/spark-app/src/index.ts"],
      "@spark-view/spark-ai": ["./packages/spark-ai/src/index.ts"],
      "@spark-view/spark-ai/schema": ["./packages/spark-ai/src/schema/index.ts"],
      "@spark-view/spark-ai/host": ["./packages/spark-ai/src/host/index.ts"],
      "@spark-view/spark-ai/module-semantic": ["./packages/spark-ai/src/module-semantic/index.ts"],
      "@spark-view/spark-page-config": ["./packages/spark-page-config/src/index.ts"],
      "@spark-view/spark-page-config/config": ["./packages/spark-page-config/src/config/index.ts"],
      "@spark-view/spark-page-config/node-tree": ["./packages/spark-page-config/src/node-tree/index.ts"],
      "@spark-view/spark-page-config/navigation": ["./packages/spark-page-config/src/navigation/index.ts"],
      "@spark-view/spark-page-config/runtime": ["./packages/spark-page-config/src/runtime/index.ts"],
      "@spark-view/spark-page-config/json-document": ["./packages/spark-page-config/src/json-document/index.ts"],
      "@spark-view/spark-page-config/design": ["./packages/spark-page-config/src/design/index.ts"],
      "@spark-view/spark-page-config/ai": ["./packages/spark-page-config/src/ai/index.ts"],
      "@spark-view/spark-page-config/ai/payloads/component-catalog.json": ["./packages/spark-page-config/src/ai/payloads/component-catalog.json"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "obj",
    "**/*.md",
    "**/dist/**",
    "**/node_modules/**",
    "tools/**"
  ]
}
