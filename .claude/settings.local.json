{
  "model": "claude-sonnet-4-6",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ANTHROPIC_AUTH_TOKEN": "",
    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-sonnet-4-6",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-4-6",
    "ENABLE_TOOL_SEARCH": "1",
    "API_TIMEOUT_MS": "300000"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git remote *)",
      "Bash(git push *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git stash *)",
      "Bash(npm run *)",
      "Bash(git checkout *)",
      "Bash(mv .claude .claude_tmp && git stash pop)",
      "Bash(mv .claude_tmp .claude)",
      "Bash(vue-tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json)",
      "Bash(npx vue-tsc *)",
      "Bash(npx eslint *)",
      "Bash(curl -s \"http://127.0.0.1:8080/api/tenants/platform/projects/default/databases/catalog/physical-names?serverId=1\")",
      "Bash(curl -s -H \"Authorization: Bearer test\" \"http://127.0.0.1:8080/api/tenants/platform/projects/default/databases/catalog/physical-names?serverId=1\")",
      "Bash(pnpm run *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git pull *)",
      "Bash(node scripts/verify-dataset-remote-load.mjs --frontend http://localhost:5173)",
      "Bash(curl -s \"http://127.0.0.1:8080/api/auth/login\" -H \"Content-Type: application/json\" -H \"X-Tenant-Id: lmspark\" -d '{\"tenantId\":\"lmspark\",\"username\":\"admin\",\"password\":\"admin123\"}')",
      "Bash(node --import tsx -e ' *)",
      "Bash(timeout 10 curl -v -N \"http://127.0.0.1:8080/api/events\" -H \"Accept: text/event-stream\")",
      "Bash(timeout 5 curl -v -N \"http://localhost:5173/api/events\" -H \"Accept: text/event-stream\")",
      "Bash(pnpm --filter @spark-appworks/spark-project-model run build)",
      "Bash(npx vitest *)",
      "Bash(rm -rf src/*)",
      "Bash(cp -r ../spark-project-model/src/* src/)",
      "Bash(code --install-extension Catppuccin.catppuccin-vsc)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(node tools/verify-ai-model-spec.mjs)",
      "Skill(deep-research)",
      "Skill(deep-research:*)",
      "Bash(Get-ChildItem -Recurse -Name docs/research/)",
      "PowerShell(pnpm run typecheck 2>&1)"
    ],
    "additionalDirectories": [
      "D:\\SPARK_AppWorks\\.claude"
    ]
  }
}
